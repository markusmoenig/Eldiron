ull,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null,null]},"target_fps":30,"tick_ms":250,"config":"[ruleset]\nid = \"eldiron.official\"\nversion = \"1.0.0\"\nschema_version = \"1\"\nsource = \"official\"\nupdate_policy = \"compatible\"\n\n[game]\nlocale = \"en\"\n\ntarget_fps = 30      # The target frames per second for the game.\ngame_tick_ms = 250   # The milliseconds per game tick.\nticks_per_minute = 4 # The amount of ticks per in-game minute.\n\ncollision_mode = \"mesh\"  # Collision mode, \"tile\" or \"mesh\"\nmovement_units_per_sec = 4   # Default movement speed\nturn_speed_deg_per_sec = 180 # Default turn speed\n\nentity_block_mode = \"always\" # The block mode, \"always\" or \"never\"\nauto_create_player = true    # Whether to auto create a player entity.\n\n# The name of the region to start the game in.\nstart_region = \"StartScene\"\n\n# The name of the start scren. If empty, shows the start region\nstart_screen = \"Dungeon\"\n\n# The name of the base currency\nbase_currency_name = \"Gold\"\n\n# The symbol of the base currency\nbase_currency_symbol = \"G\"\n\n# The supported gear slots\ngear_slots = [\"legs\", \"head\", \"torso\"]\n\n# The supported weapon slots\nweapon_slots = [\"main_hand\", \"off_hand\"]\n\n# The attribute which handles health & death\nhealth = \"HP\"\n\n[viewport]\nwidth = 960\nheight = 540\ngrid_size = 32\nupscale = \"aspect\"\ncursor_id = \"0969ef48-ef3b-4841-8ef2-0ee7a121abd3\"\nwindow_scale = 1.0\n\n[render]\n# Renderer style preset: \"clean\", \"retro\", or \"grimy\".\nstyle = \"clean\"\n\n# Lighting model: \"lambert\", \"cook_torrance\", or \"pbr\".\nlighting_model = \"lambert\"\n\n# MSAA sample count for raster 3D (0=off, 4=on).\nmsaa_samples = 4\n\n# Bump mapping strength (0.0 = off, 1.0 = full).\nbump_strength = 1.0\n\n# First-person blur transition start distance.\nfirstp_blur_near = 4.0\n\n# First-person blur transition end distance.\nfirstp_blur_far = 12.0\n\n# Shadow toggle.\nshadow_enabled = true\n\n# Shadow strength (default 0.8).\nshadow_strength = 0.8\n\n# Shadow-map resolution.\nshadow_resolution = 1024\n\n# Shadow depth bias.\nshadow_bias = 0.0015\n\n# Fade mode for alpha/visibility transitions: \"ordered_dither\" or \"uniform\".\nfade_mode = \"ordered_dither\"\n\n# Static sky color (used when simulation is disabled)\nsky_color = \"#87CEEB\"\n\n# Static sun color (used when simulation is disabled)\nsun_color = \"#FFFACD\"\n\n# Sun intensity/brightness multiplier\nsun_intensity = 1.5\n\n# Static sun direction as [x, y, z] (used when simulation is disabled)\nsun_direction = [-0.5, -1.0, -0.3]\n\n# Enable/disable sun lighting\nsun_enabled = true\n\n# Ambient light color\nambient_color = \"#999999\"\n\n# Ambient light strength (0.0 - 1.0)\nambient_strength = 0.1\n\n# Fog color\nfog_color = \"#000000\"\n\n# Fog density (0.0 = no fog, higher values = denser fog)\nfog_density = 0.0\n\n# Avatar readability boost toggle (Raster 3D avatars/billboards).\navatar_highlight_enabled = true\n\n# Avatar readability lift multiplier (1.0 = unchanged).\navatar_highlight_lift = 1.2\n\n# Avatar ambient fill contribution.\navatar_highlight_fill = 1.20\n\n# Avatar rim-light contribution.\navatar_highlight_rim = 0.18\n\n[post]\n# Enable/disable final post pass.\nenabled = true\n# Tone mapper: \"none\", \"reinhard\", \"aces\".\ntone_mapper = \"reinhard\"\n# Exposure multiplier before tone mapping.\nexposure = 1.5\n# Post saturation (1.0 = unchanged, 0.0 = grayscale).\nsaturation = 1.2\n# Post luminance/brightness multiplier.\nluminance = 1.0\n# Output gamma.\ngamma = 2.2\n# Stylized grain/noise amount (0 = off, 1 = strong).\ngrit = 0.4\n# Stylized tonal banding amount (0 = off, 1 = strong).\nposterize = 0.4\n# Bias colors toward earthy retro tones (0 = off, 1 = strong).\npalette_bias = 0.7\n# Lift near-black areas after tone mapping (0 = off, 1 = strong).\nshadow_lift = 0.0\n# Soften harsh post contrast (0 = off, 1 = strong).\nedge_soften = 0.0\n\n[simulation]\n# Enable procedural daylight simulation (overrides static sky_color, sun_color, sun_direction)\nenabled = true\n\n# Sky color at night (dark)\nnight_sky_color = \"#050510\"\n\n# Sky color at sunrise/sunset (morning)\nmorning_sky_color = \"#FF9966\"\n\n# Sky color at midday\nmidday_sky_color = \"#87CEEB\"\n\n# Sky color in the evening\nevening_sky_color = \"#FF8040\"\n\n# Sun/moon color at night (very dim)\nnight_sun_color = \"#1A1A26\"\n\n# Sun color at sunrise/sunset (morning)\nmorning_sun_color = \"#FFCC99\"\n\n# Sun color at midday\nmidday_sun_color = \"#FFFFF2\"\n\n# Sun color in the evening\nevening_sun_color = \"#FFB380\"\n\n# Sunrise time in 24-hour format (e.g., 6.5 = 6:30 AM)\nsunrise_time = 6.0\n\n# Sunset time in 24-hour format (e.g., 18.5 = 6:30 PM)\nsunset_time = 18.0","world_module":{"filter_text":"","id":"ce924785-eb48-4a9e-a8f9-8886c87e10a6","module_type":"World","name":"","player":false,"routines":{},"view_name":""},"world_source":"","world_source_debug":"","rules":"# Game / Rules is the project-level override layer for the official ruleset\n# selected in Game / Settings.\n#\n# New projects use the bundled Eldiron Official Ruleset by default, so this file\n# starts empty. Add changes here when this project intentionally changes the\n# default rules.\n","locales":"[en]\ncombat.damage.incoming = \"{attacker} hits you for {amount} damage\"\ncombat.damage.outgoing = \"You hit {defender} for {amount} damage\"\nsystem.cant_do_that_yet = \"Can't do that yet\"\nsystem.cant_afford = \"You can't afford that\"\nsystem.you_bought = \"You bought\"\nsystem.exit_menu = \"Goodbye\"\n","audio_fx":"[sfx.door_open]\nwave = \"noise\"\nduration = 0.12\nattack = 0.002\ndecay = 0.10\nrelease = 0.02\ngain = 0.35\nfreq = 900\nfreq_end = 280\nnoise = 0.85\nlowpass = 0.45\n\n[sfx.door_close]\nwave = \"noise\"\nduration = 0.10\nattack = 0.0\ndecay = 0.08\nrelease = 0.02\ngain = 0.28\nfreq = 420\nfreq_end = 180\nnoise = 0.75\nlowpass = 0.60\n\n[sfx.fire_cast]\nwave = \"sine\"\nduration = 0.22\nattack = 0.005\ndecay = 0.14\nrelease = 0.03\ngain = 0.30\nfreq = 1200\nfreq_end = 260\nnoise = 0.35\nlowpass = 0.18\n\n[sfx.ice_cast]\nwave = \"triangle\"\nduration = 0.20\nattack = 0.003\ndecay = 0.12\nrelease = 0.03\ngain = 0.25\nfreq = 1400\nfreq_end = 500\nnoise = 0.10\nlowpass = 0.08\n\n[sfx.arcane_cast]\nwave = \"saw\"\nduration = 0.24\nattack = 0.004\ndecay = 0.16\nrelease = 0.04\ngain = 0.22\nfreq = 620\nfreq_end = 1240\nnoise = 0.08\ntremolo_depth = 0.20\ntremolo_freq = 22\n\n[sfx.ui_click]\nwave = \"square\"\nduration = 0.03\nattack = 0.0\ndecay = 0.02\nrelease = 0.01\ngain = 0.16\nfreq = 1200\nfreq_end = 900\n\n[sfx.ui_confirm]\nwave = \"sine\"\nduration = 0.07\nattack = 0.0\ndecay = 0.05\nrelease = 0.02\ngain = 0.18\nfreq = 720\nfreq_end = 1020\n\n[sfx.pickup_coin]\nwave = \"sine\"\nduration = 0.09\nattack = 0.0\ndecay = 0.05\nrelease = 0.02\ngain = 0.18\nfreq = 900\nfreq_end = 1600\nrepeat = 2\nrepeat_gap = 0.02\n\n[sfx.hit_small]\nwave = \"square\"\nduration = 0.08\nattack = 0.0\ndecay = 0.05\nrelease = 0.01\ngain = 0.25\nfreq = 240\nfreq_end = 120\nnoise = 0.15\n\n[sfx.attack]\nwave = \"noise\"\nduration = 0.11\nattack = 0.0\ndecay = 0.07\nrelease = 0.02\ngain = 0.22\nfreq = 1100\nfreq_end = 260\nnoise = 0.92\nlowpass = 0.18\n\n[sfx.hit]\nwave = \"square\"\nduration = 0.09\nattack = 0.0\ndecay = 0.06\nrelease = 0.02\ngain = 0.30\nfreq = 220\nfreq_end = 90\nnoise = 0.18\nlowpass = 0.22\n\n[sfx.hit_heavy]\nwave = \"square\"\nduration = 0.12\nattack = 0.0\ndecay = 0.08\nrelease = 0.02\ngain = 0.34\nfreq = 180\nfreq_end = 70\nnoise = 0.22\nlowpass = 0.25\n\n[sfx.whoosh_small]\nwave = \"noise\"\nduration = 0.10\nattack = 0.0\ndecay = 0.07\nrelease = 0.02\ngain = 0.20\nfreq = 1200\nfreq_end = 380\nnoise = 0.95\nlowpass = 0.15\n\n[sfx.whoosh_large]\nwave = \"noise\"\nduration = 0.18\nattack = 0.0\ndecay = 0.12\nrelease = 0.03\ngain = 0.28\nfreq = 900\nfreq_end = 180\nnoise = 1.0\nlowpass = 0.35\n","authoring":"","shortcuts":"# Override editor shortcuts by stable action id.\n# Values are single keys and are matched case-insensitively.\n[shortcuts]\n\"tool.object\" = \"O\"\n\"tool.vertex\" = \"V\"\n\"tool.edge\" = \"E\"\n\"tool.face\" = \"F\"\n","avatars":{},"palette_materials":[{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{