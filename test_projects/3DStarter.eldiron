kill\", 0, 1); message( id(),   \"You kill the \" + name,  \"\");\n    }\n}\n\n","data":"[attributes]\n\nrace = \"Human\"\nclass = \"Warrior\"\n\nplayer = true\nvisible = true\nradius = 0.5\ninventory_slots = 8\n\n[input]\nq = \"action(strafe_left)\"\ne = \"action(strafe_right)\"\nw = \"action(forward)\"\na = \"action(left)\"\ns = \"action(backward)\"\nd = \"action(right)\"\nl = \"intent(look)\"\nu = \"intent(use)\"\nf = \"spell(Fireball)\"\n\n","authoring":"","preview_rigging":"# Editor-only preview. Runtime equipment/animation comes from server scripts.\nanimation = \"Idle\"\nperspective = \"Front\"\nplay = true\nspeed = 1.0\nhands_index = 3\n\n[slots]\nmain_hand = \"Sword\"\noff_hand = \"Shield\"\n\n[slot_overrides.main_hand]\nrig_scale = 0.85\nrig_pivot = [0.31, 0.82]\nrig_layer = \"back\"\n","position":{"x":0.0,"y":0.0,"z":0.0},"orientation":{"x":1.0,"y":0.0},"character_id":"5b17884a-2598-4b13-9ce9-fd92a691621d"}},"items":{"2f37eb41-bd19-40e1-8ec5-3844fec2dea4":{"id":"2f37eb41-bd19-40e1-8ec5-3844fec2dea4","name":"Floor Light","map":{"id":"6729d33b-6bb0-46e4-81e8-e5547a4bdda9","name":"Floor Light","offset":{"x":0.0,"y":0.0},"grid_size":30.0,"subdivisions":1.0,"dungeon":{"active_layer":0,"layers":[]},"vertices":[],"linedefs":[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_linedefs":[],"selected_sectors":[],"selected_geometry_objects":[],"selected_entity_item":null,"properties":{"values":{}},"softrigs":{},"surfaces":{},"terrain_organic_layer":{"id":"5ad1bd46-174e-4de1-8e33-5cf05ec8c626","name":"Main Organic Layer","cell_size":0.05,"page_size":16,"pages":{},"channel_bindings":[{"channel":0,"name":"Foliage","source":null,"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"channel":1,"name":"Soil","source":null,"roughness":0.5,"metallic":0.0,"opacity":1.0,"emissive":0.0},{"channel":2,"name":"Stone","source":null,"roughness":0.5,"metallic":0.0,"opacity":1.0,"emiss