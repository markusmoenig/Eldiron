\":[25,1],\"selected_node\":1,\"preview_mode\":0}"}},"builder_graphs":{"54a1fa68-1de5-4880-b9ed-add1999a333b":{"id":"54a1fa68-1de5-4880-b9ed-add1999a333b","graph_id":"c5e30c07-510f-43b1-94a4-e6a68bed3da1","graph_name":"Wall Torch","graph_data":"name = \"Wall Torch\";\nhost = vertex;\n\npreview {\n    width = 1.0;\n    depth = 0.30;\n    height = 2.0;\n}\n\nlet base = box {\n    attach = host.middle + host.out * 0.06 + host.up * -0.22;\n    size = vec3(0.16, 0.44, 0.05);\n    material = BASE;\n};\n\nlet arm = box {\n    attach = host.middle + host.out * 0.15 + host.up * 0.02;\n    size = vec3(0.08, 0.06, 0.22);\n    material = BASE;\n};\n\nlet holder = box {\n    attach = host.middle + host.out * 0.25 + host.up * -0.03;\n    size = vec3(0.12, 0.10, 0.12);\n    material = BASE;\n};\n\nlet torch = cylinder {\n    attach = host.middle + host.out * 0.25 + host.up * -0.32;\n    axis = host.up;\n    length = 0.78;\n    radius = 0.026;\n    material = TORCH;\n};\n\nlet flame = cylinder {\n    parent = torch.tip;\n    attach = vec3(0.0, -0.05, 0.0);\n    axis = host.up;\n    length = 0.18;\n    radius = 0.03;\n    material = FLAME;\n};\n\nslot item flame_top = flame.top;\nslot material base_mat = base.center;\nslot material torch_mat = torch.center;\nslot material flame_mat = flame.center;\n\noutput = [base, arm, holder, torch, flame];\n"}},"tile_collections":{},"tile_board_tiles":{"a41cf692-e03b-4579-a8e9-3d77972d1858":{"x":1,"y":0},"53199837-588b-4fba-af61-af7226172ce2":{"x":7,"y":1},"42b636ff-068d-4f3c-b54b-76016040e84f":{"x":3,"y":1},"913677b1-7c35-4610-81bc-d3d66087eef1":{"x":7,"y":0},"e012fa67-3107-4d50-ae9d-e1ed131a5090":{"x":1,"y":2},"6bb91005-f236-42c1-9a4c-b097cf6d9a70":{"x":8,"y":0},"57841f21-5e94-4a8a-b111-826438f15c57":{"x":9,"y":1},"f05d23bb-998a-4407-b4f6-fe0158ee7621":{"x":2,"y":1},"cfbec799-9156-42d1-816c-c1492e813192":{"x":4,"y":1},"b7f82441-b31c-4c1f-a31b-7c3bb6b7f4c0":{"x":6,"y":0},"f6a0ad99-2f3c-4350-992e-850f062655f2":{"x":6,"y":1}},"tile_board_groups":