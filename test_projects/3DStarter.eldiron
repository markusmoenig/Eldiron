220,"buffer_y":39,"height":50,"width":30,"x":220,"y":39}],[[0,2],{"buffer_x":4,"buffer_y":89,"height":50,"width":30,"x":4,"y":89}]],"row_indents":[[2,0],[1,0]]},"id":"aa961741-5536-4b63-9ecd-7288f24bc57b","module_offset":0,"name":"startup","pixelization":0,"rotation":0.0,"scale":1.0,"screen_width":658,"visible":true}},"view_name":"DockVisualScripting"},"source":"fn event(event, value) {\n    if event == \"startup\" {\n        set_player_camera( \"firstp\");\n    }\n    if event == \"death\" {\n        drop_items( \"\");\n        teleport( \"Start\",  \"\");\n        set_attr( \"HP\",  8);\n        set_attr( \"mode\",  \"active\");\n        message( id(),  \"You died. Try again!\",  \"\");\n    }\n    if event == \"intent\" {\n        let intent = value.string;\n        let distance = value.distance;\n        if intent == \"attack\" {\n            let alignment = get_attr_of( value.subject_id,  \"ALIGNMENT\");\n            if alignment < 0 {\n                let damage = random( 3,  5);\n                deal_damage( value.subject_id,  damage);\n                block_events( 2,  \"intent: attack\");\n            }\n            else{\n                message( value.subject_id,  \"{cant_do_that}\",  \"\");\n            }\n        }\n        if intent == \"take\" {\n            take( value.subject_id);\n        }\n        if intent == \"drop\" {\n            drop( value.subject_id);\n        }\n    }\n    if event == \"kill\" {\n        let name = get_attr_of( value,  \"name\");\n        message( id(),   \"You kill the \" + name,  \"\");\n    }\n}\n\n","source_debug":"fn event(event, value) {\n    if event == \"startup\" {\n        mark_debug_header(\"startup\");\n        set_debug_loc(\"startup\", 0, 1); set_player_camera( \"firstp\");\n    }\n    if event == \"death\" {\n        mark_debug_header(\"death\");\n        set_debug_loc(\"death\", 0, 0); drop_items( \"\");\n        set_debug_loc(\"death\", 0, 1); teleport( \"Start\",  \"\");\n        set_debug_loc(\"death\",