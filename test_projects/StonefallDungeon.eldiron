e":{"Source":"Off"},"data":{"Str":"[ui]\nalign = \"center\"\ncolor = \"#d8e4df\"\nfont = \"Tiny5-Regular\"\nfont_size = 15.0\nrole = \"text\"\nspacing = 3.0\ntext = \"\"\"\n{START.CLASS} \u2014 {START.CLASS_ROLE}\n{START.CLASS_DESCRIPTION}\n\nFocus: {START.CLASS_ATTRIBUTES}\nLoadout: {START.CLASS_EQUIPMENT}\nActions: {START.CLASS_ABILITIES}  Spells: {START.CLASS_SPELLS}\n\"\"\"\n"}}},"shader":null,"layer":null},{"id":9,"creator_id":"e1b87959-07c0-4b1b-af64-e014ae5f59f3","name":"Enter","linedefs":[36,37,38,39],"properties":{"values":{"source":{"Source":"Off"},"data":{"Str":"[ui]\nbackground_color = \"#151b1dcc\"\nborder_color = \"#d4b75e\"\nborder_size = 2\ncolor = \"#f4f7ef\"\ncommand = \"game.start\"\nfont = \"Tiny5-Regular\"\nfont_size = 23.0\nlabel = \"ENTER STONEFALL\"\nrole = \"button\"\nshow_icon = false\n\n[ui.style.hover]\nbackground = \"#31331dcc\"\nborder = \"#ffe27c\"\n\n[ui.style.pressed]\nbackground = \"#4a4020dd\"\nborder = \"#fff2b2\"\ntext = \"#fff7d4\"\n"}}},"shader":null,"layer":null}],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_linedefs":[],"selected_sectors":[],"selected_geometry_objects":[],"selected_entity_item":null,"properties":{"values":{}},"softrigs":{},"surfaces":{},"profiles":{},"shaders":{},"changed":0}}},"assets":{},"procedural_recipes":{"99aaf6ba-15cc-41fc-a064-2cdcc6a0718a":{"id":"99aaf6ba-15cc-41fc-a064-2cdcc6a0718a","alias":"ceiling-beam-wood","source":"Tile\n    name = \"Ceiling Beam Wood\"\n    material = dungeon/beam_wood\n    size = I2(64, 64)\n    coverage = I2(3, 1)\n    wrap = Repeat\n    seed = 127\n    pixelate = 1\n\n    Noise Hewn\n        type = Gradient\n        fractal = Ridged\n        scale = F2(4.0, 15.0)\n        octaves = 3\n        persistence = 0.48\n        seed = 41\n\n    Height Surface\n        source = Clamp(0.42 + Hewn * 0.24, 0.0, 1.0)\n\n    Output\n        height = Surface\n","tile_id":"df712ce7-e388-4d45-a638-11dd9d0008be"},"69bf2295-89a3-4696-abd1-ebacf0792848":{"id":"69bf2295-89a3-4696-abd1-ebacf0792848","alias":"ceiling-stone","source":"Tile\n    name = \"Stone Ceiling\"\n    material = dungeon/ceiling_stone\n    size = I2(64, 64)\n    coverage = I2(3, 3)\n    wrap = Repeat\n    seed = 113\n    pixelate = 1\n\n    Noise Broad\n        scale = I2(3, 3)\n        octaves = 3\n        persistence = 0.52\n        seed = 17\n\n    Noise Detail\n        scale = I2(7, 6)\n        octaves = 2\n        persistence = 0.45\n        seed = 29\n\n    Pattern Slabs\n        Voronoi\n            cells = I2(7, 5)\n            jitter = 0.84\n            falloff = 0.62\n            warp = Broad\n            warp_amount = 0.050\n            seed = 31\n\n    Pattern Pocks\n        Discs\n            space = Slabs.local\n            key = Slabs.id\n            cells = I2(3, 3)\n            jitter = 0.86\n            radius = 0.10\n            falloff = 1.55\n            warp = Detail\n            warp_amount = 0.025\n            seed = 37\n\n    Height Surface\n        source = 0.18 + Slabs.height * 0.54\n\n        Add\n            source = Broad\n            amount = 0.12\n\n        Multiply\n            source = 0.84 + Detail * 0.12 + Random(Slabs.id, -0.025, 0.035, 43)\n            amount = 1.0\n\n        Subtract\n            source = Pocks.height\n            amount = 0.07\n\n        Shape\n            contrast = 0.96\n            bias = -0.01\n            plateau = 2.50\n            rim = 0.025\n\n        Clamp\n            min = 0.0\n            max = 1.0\n\n    Geometry\n        Box CrossBeam\n            operation = Add\n            surface = ceiling-beam-wood\n            position = F3(0.41, 0.0, 0.0)\n            size = F3(0.18, 0.12, 1.0)\n\n    Output\n        height = Surface\n","tile_id":"b7bd825f-92bc-43df-946a-74b67189b9a1"},"81259978-4a5c-4b3d-abb0-e8fd76b21cf2":{"id":"81259978-4a5c-4b3d-abb0-e8fd76b21cf2","alias":"dungeon","source":"Material wall_stone\n    name = \"Wall Stone\"\n    wrap = Repeat\n    seed = 301\n\n    Noise Mineral\n        key = Id\n        type = Gradient\n        fractal = Ridged\n        scale = F2(3.0, 4.0)\n        octaves = 3\n        persistence = 0.52\n        seed = 11\n\n    Value WallDetail\n        source = Smoothstep(0.16, 0.84, Mineral)\n\n    Value WallUnitTone\n        source = Random(Id, 0.0, 1.0, 53)\n\n    Color WallShadow\n        nearest = #2d2926\n\n    Color WallBaseDark\n        nearest = #575149\n\n    Color WallBaseLight\n        nearest = #686057\n\n    Color WallBase\n        source = Mix(WallBaseDark, WallBaseLight, WallUnitTone)\n\n    Color WallColor\n        source = Mix(WallShadow, WallBase, WallDetail)\n\n    Surface\n        color = WallColor\n        palette = BaseOnly\n        roughness = Clamp(0.32 + Mineral * 0.22, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Mineral\n        normal_strength = 0.48\n\nMaterial floor_stone\n    name = \"Floor Stone\"\n    wrap = Repeat\n    seed = 307\n\n    Noise Wear\n        type = Gradient\n        fractal = FBm\n        scale = F2(5.0, 5.0)\n        octaves = 3\n        persistence = 0.46\n        seed = 17\n\n    Color FloorDark\n        nearest = #292827\n\n    Color FloorLight\n        nearest = #55524d\n\n    Color FloorColor\n        source = Mix(FloorDark, FloorLight, Wear)\n\n    Surface\n        color = FloorColor\n        palette = BaseOnly\n        roughness = Clamp(0.24 + Wear * 0.20, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Wear\n        normal_strength = 0.42\n\nMaterial ceiling_stone\n    name = \"Ceiling Stone\"\n    wrap = Repeat\n    seed = 313\n\n    Noise Dust\n        type = Value\n        fractal = Turbulence\n        scale = F2(4.0, 3.0)\n        octaves = 3\n        persistence = 0.50\n        seed = 23\n\n    Color CeilingDark\n        nearest = #292b2f\n\n    Color CeilingLight\n        nearest = #555960\n\n    Color CeilingColor\n        source = Mix(CeilingDark, CeilingLight, Dust)\n\n    Surface\n        color = CeilingColor\n        palette = BaseOnly\n        roughness = Clamp(0.34 + Dust * 0.22, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Dust\n        normal_strength = 0.44\n\nMaterial beam_wood\n    name = \"Ceiling Beam Wood\"\n    wrap = Repeat\n    seed = 331\n\n    Noise Warp\n        type = Gradient\n        fractal = FBm\n        scale = F2(3.0, 2.0)\n        octaves = 3\n        persistence = 0.52\n        seed = 37\n\n    Noise Pores\n        type = Gradient\n        fractal = Ridged\n        scale = F2(5.0, 18.0)\n        octaves = 2\n        persistence = 0.44\n        seed = 43\n\n    Value Grain\n        source = Pow(Abs(Sin(V * 8.5 + Sin(U * 2.0) * 0.24 + Warp * 1.15)), 5.5)\n\n    Value Tone\n        source = Clamp(0.52 - Grain * 0.38 + Pores * 0.10, 0.0, 1.0)\n\n    Color WoodDark\n        nearest = #1b0e08\n\n    Color WoodLight\n        nearest = #593018\n\n    Color WoodColor\n        source = Mix(WoodDark, WoodLight, Tone)\n\n    Surface\n        color = WoodColor\n        palette = BaseOnly\n        roughness = Clamp(0.58 + Pores * 0.24, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Clamp(Grain * 0.72 + Pores * 0.28, 0.0, 1.0)\n        normal_strength = 0.30\n\nMaterial wall_mortar\n    name = \"Mortar\"\n    wrap = Repeat\n    seed = 317\n\n    Noise Grit\n        type = Value\n        fractal = FBm\n        scale = F2(8.0, 8.0)\n        octaves = 3\n        persistence = 0.48\n        seed = 29\n\n    Color MortarDark\n        nearest = #171819\n\n    Color MortarLight\n        nearest = #343536\n\n    Color MortarColor\n        source = Mix(MortarDark, MortarLight, Grit * 0.58)\n\n    Surface\n        color = MortarColor\n        palette = BaseOnly\n        roughness = Clamp(0.70 + Grit * 0.16, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Grit\n        normal_strength = 0.18\n\nMaterial torch_iron\n    name = \"Torch Iron\"\n    wrap = Repeat\n    seed = 347\n\n    Noise Hammer\n        type = Value\n        fractal = Ridged\n        scale = F2(7.0, 7.0)\n        octaves = 2\n        persistence = 0.48\n        seed = 61\n\n    Color IronDark\n        nearest = #252a2d\n\n    Color IronLight\n        nearest = #737a7d\n\n    Color IronColor\n        source = Mix(IronDark, IronLight, Hammer * 0.62)\n\n    Surface\n        color = IronColor\n        palette = BaseOnly\n        roughness = Clamp(0.34 + Hammer * 0.24, 0.0, 1.0)\n        metallic = 0.78\n        opacity = 1.0\n        emission = 0.0\n        normal = Hammer\n        normal_strength = 0.20\n\nMaterial torch_wood\n    name = \"Torch Wood\"\n    wrap = Repeat\n    seed = 349\n\n    Noise GrainNoise\n        type = Gradient\n        fractal = FBm\n        scale = F2(3.0, 14.0)\n        octaves = 3\n        persistence = 0.50\n        seed = 67\n\n    Value Grain\n        source = Clamp(0.5 + Sin(V * 19.0 + GrainNoise * 1.8) * 0.34, 0.0, 1.0)\n\n    Color WoodDark\n        nearest = #211109\n\n    Color WoodLight\n        nearest = #6b3819\n\n    Color WoodColor\n        source = Mix(WoodDark, WoodLight, Grain)\n\n    Surface\n        color = WoodColor\n        palette = BaseOnly\n        roughness = 0.72\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Grain\n        normal_strength = 0.22\n\nMaterial torch_ember\n    name = \"Torch Ember\"\n    wrap = Repeat\n    seed = 353\n\n    Noise Coal\n        type = Value\n        fractal = Turbulence\n        scale = F2(6.0, 5.0)\n        octaves = 3\n        persistence = 0.52\n        seed = 71\n\n    Color EmberDark\n        exact = #8c2108\n\n    Color EmberBright\n        exact = #ffd25c\n\n    Color EmberColor\n        source = Mix(EmberDark, EmberBright, Coal)\n\n    Surface\n        color = EmberColor\n        palette = Strict\n        roughness = 0.66\n        metallic = 0.0\n        opacity = 1.0\n        emission = Clamp(0.45 + Coal * 0.55, 0.0, 1.0)\n        normal = Coal\n        normal_strength = 0.12\n","tile_id":null},"f6c14109-7e57-478b-94ae-0125a90892fb":{"id":"f6c14109-7e57-478b-94ae-0125a90892fb","alias":"floor-stone","source":"Tile\n    name = \"Flagstone Floor\"\n    material = dungeon/floor_stone\n    size = I2(64, 64)\n    coverage = I2(3, 3)\n    wrap = Repeat\n    seed = 81\n    pixelate = 1\n\n    Noise Warp\n        scale = I2(4, 4)\n        octaves = 2\n        persistence = 0.48\n        seed = 7\n\n    Noise Wear\n        space = Stones.local\n        key = Stones.id\n        scale = I2(3, 2)\n        octaves = 2\n        persistence = 0.46\n        seed = 13\n\n    Pattern Stones\n        Voronoi\n            cells = I2(5, 5)\n            jitter = 0.78\n            falloff = 0.56\n            warp = Warp\n            warp_amount = 0.040\n            seed = 11\n\n    Pattern Pits\n        Discs\n            space = Stones.local\n            key = Stones.id\n            cells = I2(3, 3)\n            jitter = 0.82\n            radius = 0.10 + Random(Stones.id, 0.02, 0.16, 17)\n            falloff = 1.45\n            warp = Warp\n            warp_amount = 0.03\n            seed = 21\n\n    Height Surface\n        source = 0.10 + Stones.height * 0.70\n\n        Shape\n            contrast = 1.02 + Random(Stones.id, 0.0, 0.12, 27)\n            bias = Random(Stones.id, -0.02, 0.035, 31)\n            plateau = 3.10\n            rim = 0.035\n\n        Multiply\n            source = 0.88 + Wear * 0.08 + Random(Stones.id, -0.025, 0.035, 33)\n            amount = 1.0\n\n        Subtract\n            source = Pits.height * Smoothstep(0.10, 0.52, Stones.height)\n            amount = 0.07\n\n        Clamp\n            min = 0.0\n            max = 1.0\n\n    Output\n        height = Surface\n","tile_id":"7fa7ed82-c10a-4a91-80e7-933215a8952f"},"6ba44f15-551d-46f2-90ec-65ebb7ec917d":{"id":"6ba44f15-551d-46f2-90ec-65ebb7ec917d","alias":"niche-stone","source":"Tile\n    name = \"Niche Stone\"\n    size = I2(64, 64)\n    coverage = I2(1, 1)\n    wrap = Repeat\n    seed = 149\n    pixelate = 1\n\n    Noise Warp\n        scale = I2(3, 4)\n        octaves = 2\n        persistence = 0.50\n        seed = 17\n\n    Noise Wear\n        scale = I2(6, 7)\n        octaves = 3\n        persistence = 0.46\n        seed = 23\n\n    Pattern Stones\n        Voronoi\n            cells = I2(4, 5)\n            jitter = 0.76\n            falloff = 0.64\n            warp = Warp\n            warp_amount = 0.045\n            seed = 31\n\n    Height Surface\n        source = 0.12 + Stones.height * 0.58\n\n        Multiply\n            source = 0.84 + Wear * 0.12 + Random(Stones.id, -0.03, 0.04, 37)\n            amount = 1.0\n\n        Shape\n            contrast = 0.96\n            bias = -0.03\n            plateau = 2.20\n            rim = 0.025\n\n        Clamp\n            min = 0.0\n            max = 1.0\n\n    MaterialMap\n        base = dungeon/wall_mortar\n        space = Global\n        tiling = F2(1.0, 1.0)\n\n        Layer\n            material = dungeon/wall_stone\n            mask = Pow(Stones.height, 1.45)\n            space = Stones.local\n\n    Output\n        height = Surface\n","tile_id":"9d91d64a-2a04-46c0-9e47-b6dfd6595a6f"},"745e8b0f-337a-4c84-8f39-5e63136b9902":{"id":"745e8b0f-337a-4c84-8f39-5e63136b9902","alias":"orc-helm","source":"Sdf orc_helm\n    name = \"Orc Iron Skullcap\"\n\n    Shape Cap\n        RoundedRectangle\n            position = F2(0.5, 0.32)\n            size = F2(0.50, 0.24)\n            radius = 0.11\n\n    Shape BrowRim\n        Capsule\n            from = F2(0.28, 0.445)\n            to = F2(0.72, 0.445)\n            radius = 0.016\n\n    Shape Helmet\n        Union\n            a = Cap\n            b = BrowRim\n\n    Output\n        coverage = Helmet\n","tile_id":null},"2d6eb925-7577-400f-93e9-271be270762c":{"id":"2d6eb925-7577-400f-93e9-271be270762c","alias":"orc-helmet-material","source":"Material orc_helmet_material\n    name = \"Orc Worn Dark Iron\"\n    wrap = Repeat\n    seed = 613\n\n    Noise HammerMarks\n        type = Value\n        fractal = FBm\n        scale = F2(18.0, 14.0)\n        octaves = 3\n        persistence = 0.42\n        seed = 31\n\n    Value SteelVariation\n        source = Clamp(0.08 + HammerMarks * 0.25 + (1.0 - V) * 0.05, 0.0, 1.0)\n\n    Color SteelShadow\n        exact = #10151c\n\n    Color SteelHighlight\n        exact = #2e3947\n\n    Color HammeredSteel\n        source = Mix(SteelShadow, SteelHighlight, SteelVariation)\n\n    Surface\n        color = HammeredSteel\n        palette = BaseOnly\n        roughness = Clamp(0.58 + HammerMarks * 0.16, 0.0, 1.0)\n        metallic = 0.68\n        opacity = 1.0\n        emission = 0.0\n        normal = HammerMarks\n        normal_strength = 0.12\n","tile_id":null},"65dbc18a-7c86-49e1-933a-87bc791ea12a":{"id":"65dbc18a-7c86-49e1-933a-87bc791ea12a","alias":"orc-vest","source":"Material orc_vest\n    name = \"Orc Patterned Vest\"\n    wrap = Repeat\n    seed = 419\n\n    Noise Wear\n        type = Value\n        fractal = FBm\n        scale = F2(7.0, 9.0)\n        octaves = 2\n        persistence = 0.48\n        seed = 23\n\n    Value WarStrap\n        source = 1.0 - Smoothstep(0.045, 0.105, Abs(U * 0.82 + V - 0.95))\n\n    Value Pattern\n        source = Clamp(WarStrap * 0.30 + Wear * 0.06, 0.0, 1.0)\n\n    Color HideDark\n        exact = #241a18\n\n    Color OchreStitch\n        exact = #4d3828\n\n    Color VestColor\n        source = Mix(HideDark, OchreStitch, Pattern)\n\n    Surface\n        color = VestColor\n        palette = BaseOnly\n        roughness = Clamp(0.76 + Wear * 0.14, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Pattern\n        normal_strength = 0.16\n","tile_id":null},"c637814a-3c3a-4381-a783-9980293d6c83":{"id":"c637814a-3c3a-4381-a783-9980293d6c83","alias":"start-bg","source":"Tile\n    name = \"Start Stone\"\n    size = I2(128, 128)\n    coverage = I2(4, 4)\n    wrap = Repeat\n    seed = 191\n    pixelate = 1\n\n    Noise Warp\n        type = Gradient\n        fractal = FBm\n        scale = F2(3.0, 2.5)\n        octaves = 3\n        persistence = 0.52\n        seed = 17\n\n    Noise Wear\n        type = Value\n        fractal = Turbulence\n        scale = F2(8.0, 7.0)\n        octaves = 3\n        persistence = 0.46\n        seed = 29\n\n    Pattern Slabs\n        Voronoi\n            cells = I2(6, 5)\n            jitter = 0.74\n            bevel = 0.18\n            falloff = 0.72\n            warp = Warp\n            warp_amount = 0.055\n            seed = 31\n\n    Pattern Pocks\n        Discs\n            space = Slabs.local\n            key = Slabs.id\n            cells = I2(4, 4)\n            jitter = 0.90\n            radius = 0.08 + Random(Slabs.id, 0.02, 0.14, 41)\n            falloff = 1.8\n            seed = 43\n\n    Height Surface\n        source = 0.10 + Slabs.height * 0.48\n\n        Shape\n            contrast = 1.18\n            plateau = 2.2\n            rim = 0.05\n\n        Add\n            source = Wear\n            amount = 0.08\n\n        Subtract\n            source = Pocks.height * Smoothstep(0.12, 0.60, Slabs.height)\n            amount = 0.10\n\n        Clamp\n            min = 0.0\n            max = 1.0\n\n    Colorize\n        source = Surface\n        base = #172127\n        palette = BaseOnly\n        brightness = F2(-0.16, 0.10)\n        saturation = F2(-0.08, 0.08)\n        hue = F2(-0.02, 0.02)\n        steps = 14\n        range = Auto\n        dither = false\n\n    Output\n        height = Surface\n","tile_id":"8a9cd88f-7915-4e2d-a1c8-b0e1503e19a6"},"bf3831fa-d617-4236-a71f-0b7ee1f239d8":{"id":"bf3831fa-d617-4236-a71f-0b7ee1f239d8","alias":"torch-ember","source":"Tile\n    name = \"Torch Ember Surface\"\n    material = dungeon/torch_ember\n    size = I2(32, 32)\n    wrap = Repeat\n    seed = 419\n\n    Noise Coal\n        scale = F2(6.0, 5.0)\n        octaves = 3\n        persistence = 0.52\n        seed = 83\n\n    Output\n        height = Clamp(0.40 + Coal * 0.22, 0.0, 1.0)\n","tile_id":"e705aa87-09f7-45bb-b202-7a00bd31f9b6"},"705fb1b6-be6a-4dfc-8fd3-009bd283f095":{"id":"705fb1b6-be6a-4dfc-8fd3-009bd283f095","alias":"torch-iron","source":"Tile\n    name = \"Torch Iron Surface\"\n    material = dungeon/torch_iron\n    size = I2(32, 32)\n    wrap = Repeat\n    seed = 401\n\n    Noise Hammer\n        scale = F2(7.0, 7.0)\n        octaves = 2\n        persistence = 0.48\n        seed = 73\n\n    Output\n        height = Clamp(0.42 + Hammer * 0.18, 0.0, 1.0)\n","tile_id":"910199a1-f13b-4c00-8a40-391cd4ff3422"},"cdb040ab-68d1-4127-80de-79ff2cf142b3":{"id":"cdb040ab-68d1-4127-80de-79ff2cf142b3","alias":"torch-wood","source":"Tile\n    name = \"Torch Wood Surface\"\n    material = dungeon/torch_wood\n    size = I2(32, 32)\n    wrap = Repeat\n    seed = 409\n\n    Noise Grain\n        scale = F2(3.0, 14.0)\n        octaves = 3\n        persistence = 0.50\n        seed = 79\n\n    Output\n        height = Clamp(0.38 + Grain * 0.24, 0.0, 1.0)\n","tile_id":"55ce2784-3a05-455c-88a9-4049f3a7a414"},"efcf48db-181b-41a7-a7dd-eeba3776a676":{"id":"efcf48db-181b-41a7-a7dd-eeba3776a676","alias":"wall-niche","source":"Tile\n    name = \"Wall Niche\"\n    blocking = true\n    size = I2(64, 64)\n    coverage = I2(4, 4)\n    wrap = Repeat\n    seed = 42\n    pixelate = 1\n\n    Noise LocalWarp\n        key = Id\n        scale = I2(2, 2)\n        octaves = 2\n        persistence = 0.55\n        seed = 7\n\n    Noise BorderWear\n        type = Gradient\n        fractal = FBm\n        scale = F2(11.0, 8.0)\n        octaves = 3\n        persistence = 0.52\n        seed = 47\n\n    Pattern Wall\n        Bricks\n            columns = 6\n            rows = 9\n            gap = 0.00\n            bevel = 0.2\n            rounding = 0.27\n            rotation = Random(Id, -4.0, 4.0, 11)\n            perturb = LocalWarp + Kerbs.height * 0.2\n            perturb_amount = 0.040 + Random(Id, 0.0, 0.025, 15)\n            seed = 19\n\n    Pattern Kerbs\n        Discs\n            space = Wall.local\n            cells = I2(4, 3)\n            jitter = 0.92\n            radius = 0.32 + Random(Wall.id, 0.0, 0.28, 5)\n            falloff = 1.6\n            perturb = LocalWarp\n            perturb_amount = 0.5\n            seed = 9\n\n    Height Surface\n        source = Wall.height\n\n        Subtract\n            source = Kerbs.height\n            amount = 0.12\n\n        Clamp\n            min = 0.0\n            max = 1.0\n\n    Height RecessJoint\n        source = 1.0 - Smoothstep(0.025, 0.080, Abs(Recess.distance) + (BorderWear - 0.5) * 0.028)\n\n    MaterialMap\n        base = dungeon/wall_mortar\n        space = Global\n        tiling = F2(4.0, 4.0)\n\n        Layer\n            material = dungeon/wall_stone\n            mask = Pow(Wall.height, 1.6) * (1.0 - RecessJoint)\n            space = Wall.local\n\n    Geometry\n        Box Recess\n            operation = Subtract\n            surface = niche-stone\n            position = F3(0.12, 0.76, 0.0)\n            size = F3(0.76, 1.06, 0.46)\n\n    Output\n        height = Surface\n","tile_id":"6ef7412b-5cb2-4c74-8490-acea87f63c93"},"8020068c-61e2-475b-a05f-1b6651e7ba1d":{"id":"8020068c-61e2-475b-a05f-1b6651e7ba1d","alias":"wall-stone","source":"Tile\n    name = \"Brick Wall\"\n    blocking = true\n    size = I2(64, 64)\n    coverage = I2(4, 4)\n    wrap = Repeat\n    seed = 42\n    pixelate = 1\n\n    Noise LocalWarp\n        key = Id\n        scale = I2(2, 2)\n        octaves = 2\n        persistence = 0.55\n        seed = 7\n\n    Pattern Wall\n        Bricks\n            columns = 6\n            rows = 9\n            //stagger = 0.5\n            gap = 0.00 //+ Random(Id, 0.0, 0.025, 8)\n            bevel = 0.2\n            rounding = 0.27// + Random(Id, 0.0, 0.06, 13)\n            rotation = Random(Id, -4.0, 4.0, 11)\n            //size_variation = F2(0.04, 0.03)\n            perturb = LocalWarp + Kerbs.height * 0.2\n            perturb_amount = 0.040 + Random(Id, 0.0, 0.025, 15)\n            //falloff = 0.68 + Random(Id, 0.0, 0.10, 17)\n            seed = 19\n            //perturb = LocalWarp\n            //perturb_amount = 0.1\n\n    Pattern Kerbs\n        Discs\n            space = Wall.local\n            cells = I2(4, 3)\n            jitter = 0.92\n            radius = 0.32 + Random(Wall.id, 0.0, 0.28, 5)\n            falloff = 1.6\n            //warp = LocalWarp\n            //warp_amount = 0.2\n            perturb = LocalWarp\n            perturb_amount = 0.5\n            seed = 9\n\n    Height Surface\n        source = Wall.height\n\n        Subtract\n            source = Kerbs.height\n            amount = 0.12\n\n        Clamp\n            min = 0.0\n            max = 1.0\n\n    MaterialMap\n        base = dungeon/wall_mortar\n        space = Global\n        tiling = F2(4.0, 4.0)\n\n        Layer\n            material = dungeon/wall_stone\n            mask = Pow(Wall.height, 1.6)\n            space = Wall.local\n\n    Output\n        height = Surface\n","tile_id":"961d8f17-fc06-41f9-88c4-9041c358e834"},"9e4ba1ab-9228-46f9-aae0-81ce1155ad0c":{"id":"9e4ba1ab-9228-46f9-aae0-81ce1155ad0c","alias":"wall-torch","source":"Tile\n    name = \"Wall Torch\"\n    placement = Fixture\n    blocking = true\n    material = dungeon/wall_stone\n    size = I2(64, 64)\n    coverage = I2(4, 4)\n    wrap = Repeat\n    seed = 431\n\n    Noise Stone\n        scale = F2(4.0, 4.0)\n        octaves = 3\n        persistence = 0.50\n        seed = 89\n\n    Geometry\n        Box Backplate\n            operation = Add\n            surface = torch-iron\n            position = F3(0.40, 1.08, -0.07)\n            size = F3(0.20, 0.38, 0.07)\n\n        Box Arm\n            operation = Add\n            surface = torch-wood\n            position = F3(0.46, 1.26, -0.43)\n            size = F3(0.08, 0.08, 0.43)\n\n        Box Basket\n            operation = Add\n            surface = torch-iron\n            position = F3(0.35, 1.32, -0.56)\n            size = F3(0.30, 0.11, 0.20)\n\n        Box BasketRim\n            operation = Add\n            surface = torch-iron\n            position = F3(0.31, 1.43, -0.59)\n            size = F3(0.38, 0.06, 0.25)\n\n        Box EmberBed\n            operation = Add\n            surface = torch-ember\n            position = F3(0.38, 1.49, -0.55)\n            size = F3(0.24, 0.05, 0.16)\n\n    Attachment Flame\n        position = F3(0.50, 1.58, -0.47)\n        direction = F3(0.0, 1.0, 0.0)\n\n    Light TorchLight\n        attach = Flame\n        color = #ff9a45\n        intensity = 3.0\n        range = 3.8\n        flicker = 0.22\n        lift = 0.04\n\n    Particles TorchFlame\n        attach = Flame\n        direction = F3(0.0, 1.0, 0.0)\n        spread = 0.48\n        rate = 25.0\n        color = #ff9a3d\n        color_ramp = #fff2a8, #ffc14f, #f0641f, #401008\n        color_variation = 20\n        lifetime = F2(0.32, 0.78)\n        radius = F2(0.025, 0.065)\n        speed = F2(0.28, 0.72)\n        spawn_area = F3(0.045, 0.015, 0.035)\n        flame_base = true\n\n    Output\n        height = Clamp(0.34 + Stone * 0.24, 0.0, 1.0)\n","tile_id":"40e3ae31-ffb6-44f2-8e39-6becaaf095f1"}},"procedural_materials":{"dungeon/wall_stone":"Material wall_stone\n    name = \"Wall Stone\"\n    wrap = Repeat\n    seed = 301\n\n    Noise Mineral\n        key = Id\n        type = Gradient\n        fractal = Ridged\n        scale = F2(3.0, 4.0)\n        octaves = 3\n        persistence = 0.52\n        seed = 11\n\n    Value WallDetail\n        source = Smoothstep(0.16, 0.84, Mineral)\n\n    Value WallUnitTone\n        source = Random(Id, 0.0, 1.0, 53)\n\n    Color WallShadow\n        nearest = #2d2926\n\n    Color WallBaseDark\n        nearest = #575149\n\n    Color WallBaseLight\n        nearest = #686057\n\n    Color WallBase\n        source = Mix(WallBaseDark, WallBaseLight, WallUnitTone)\n\n    Color WallColor\n        source = Mix(WallShadow, WallBase, WallDetail)\n\n    Surface\n        color = WallColor\n        palette = BaseOnly\n        roughness = Clamp(0.32 + Mineral * 0.22, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Mineral\n        normal_strength = 0.48\n\nMaterial floor_stone\n    name = \"Floor Stone\"\n    wrap = Repeat\n    seed = 307\n\n    Noise Wear\n        type = Gradient\n        fractal = FBm\n        scale = F2(5.0, 5.0)\n        octaves = 3\n        persistence = 0.46\n        seed = 17\n\n    Color FloorDark\n        nearest = #292827\n\n    Color FloorLight\n        nearest = #55524d\n\n    Color FloorColor\n        source = Mix(FloorDark, FloorLight, Wear)\n\n    Surface\n        color = FloorColor\n        palette = BaseOnly\n        roughness = Clamp(0.24 + Wear * 0.20, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Wear\n        normal_strength = 0.42\n\nMaterial ceiling_stone\n    name = \"Ceiling Stone\"\n    wrap = Repeat\n    seed = 313\n\n    Noise Dust\n        type = Value\n        fractal = Turbulence\n        scale = F2(4.0, 3.0)\n        octaves = 3\n        persistence = 0.50\n        seed = 23\n\n    Color CeilingDark\n        nearest = #292b2f\n\n    Color CeilingLight\n        nearest = #555960\n\n    Color CeilingColor\n        source = Mix(CeilingDark, CeilingLight, Dust)\n\n    Surface\n        color = CeilingColor\n        palette = BaseOnly\n        roughness = Clamp(0.34 + Dust * 0.22, 0.0, 1.0)\n        metallic = 0.0\n        opacity = 1.0\n        emission = 0.0\n        normal = Dust\n        normal_strength = 0.44\n\nMaterial beam_wood\n    name = \"Ceiling Beam Wood\"\n    wrap = Repeat\n    seed = 331\n\n    Noise Warp\n        type = Gradient\n        fractal = FBm\n   