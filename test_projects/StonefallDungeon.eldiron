[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_linedefs":[],"selected_sectors":[],"selected_geometry_objects":[],"selected_entity_item":null,"properties":{"values":{}},"softrigs":{},"surfaces":{},"profiles":{},"shaders":{},"changed":0},"module":{"filter_text":"","id":"00000000-0000-0000-0000-000000000000","module_type":"ItemTemplate","name":"Bone Key","player":false,"routines":{},"view_name":""},"source":"","source_debug":"","data":"[attributes]\n    source_id = \"bone_key\"\n    name = \"Bone Key\"\n    description = \"A heavy iron key decorated with a small bone ward.\"\n    category = \"key\"\n    slot = \"key\"\n    rarity = \"uncommon\"\n    takeable = true\n    blocking = false\n    visible = true\n    on_look = \"A heavy iron key decorated with a small bone ward.\"","authoring":"","position":{"x":0.0,"y":0.0,"z":0.0},"item_id":"8fd4ae24-bf4e-46d7-b33d-47933b13986a"},"ccc26413-a568-4d5b-b331-30ce7e1b2d6b":{"id":"ccc26413-a568-4d5b-b331-30ce7e1b2d6b","name":"Exit Marker","map":{"id":"25ca2ee1-035b-454e-8862-3df1f262ab73","name":"New Map","offset":{"x":0.0,"y":0.0},"grid_size":30.0,"subdivisions":1.0,"vertices":[],"linedefs":[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_linedefs":[],"selected_sectors":[],"selected_geometry_objects":[],"selected_entity_item":null,"properties":{"values":{}},"softrigs":{},"surfaces":{},"profiles":{},"shaders":{},"changed":0},"module":{"filter_text":"","id":"00000000-0000-0000-0000-000000000000","module_type":"ItemTemplate","name":"Exit Marker","player":false,"routines":{},"view_name":""},"source":"","source_debug":"fn event(event, value) {\n        if event == \"intent\" {\n            let intent = value.string;\n            if intent == \"look\" {\n                let keys = inventory_items_of( value.subject_id,  \"Bone Key\");\n                if keys.count > 0 {\n                    set_attr( \"unlocked\",  true);\n                    set_attr( \"blocking\",  false);\n                    message( value.subject_id,  \"The Bone Key turns. Cold air floods the stair as the way out of Stonefall opens.\",  \"success\");\n                } else {\n                    message( value.subject_id,  \"An iron ward seals the stair. The lock bears the same bone mark as the Warden below.\",  \"warning\");\n                }\n            }\n            if intent == \"use\" {\n                let keys = inventory_items_of( value.subject_id,  \"Bone Key\");\n                if keys.count > 0 {\n                    set_attr( \"unlocked\",  true);\n                    set_attr( \"blocking\",  false);\n                    message( value.subject_id,  \"The Bone Key turns. Cold air floods the stair as the way out of Stonefall opens.\",  \"success\");\n                } else {\n                    message( value.subject_id,  \"An iron ward seals the stair. The lock bears the same bone mark as the Warden below.\",  \"warning\");\n                }\n            }\n        }\n        if event == \"bumped_by_entity\" {\n            let unlocked = get_attr( \"unlocked\");\n            if unlocked == false {\n                let keys = inventory_items_of( value,  \"Bone Key\");\n                if keys.count > 0 {\n                    set_attr( \"unlocked\",  true);\n                    set_attr( \"blocking\",  false);\n                    message( value,  \"The Bone Key turns. Cold air floods the stair as the way out of Stonefall opens.\",  \"success\");\n                } else {\n                    message( value,  \"An iron ward seals the stair. The lock bears the same bone mark as the Warden below.\",  \"warning\");\n                }\n            }\n        }\n    }","data":"[attributes]\n    source_id = \"exit\"\n    source_symbol = \"x\"\n    terminal_glyph = \"x\"\n    takeable = false\n    blocking = true\n    visible = true\n    unlocked = false","authoring":"[terminal]\nglyph = \"x\"\n","position":{"x":0.0,"y":0.0,"z":0.0},"item_id":"9432727b-08fd-4ea6-b26f-81b65f51deb4"},"33cf811e-4a7d-4758-ab65-bcc3b09d7d72":{"id":"33cf811e-4a7d-4758-ab65-bcc3b09d7d72","name":"Orc Iron Skullcap","map":{"id":"df69f95f-59e7-4058-966a-19030a2e24ee","name":"New Map","offset":{"x":0.0,"y":0.0},"grid_size":30.0,"subdivisions":1.0,"vertices":[],"linedefs":[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_linedefs":[],"selected_sectors":[],"selected_geometry_objects":[],"selected_entity_item":null,"properties":{"values":{}},"softrigs":{},"surfaces":{},"profiles":{},"shaders":{},"changed":0},"module":{"filter_text":"","id":"00000000-0000-0000-0000-000000000000","module_type":"ItemTemplate","name":"Orc Iron Skullcap","player":false,"routines":{},"view_name":""},"source":"","source_debug":"","data":"[attributes]\n    source_id = \"orc_iron_helm\"\n    ruleset_id = \"orc_iron_helm\"\n    name = \"Orc Iron Skullcap\"\n    description = \"A compact, battered iron cap worn low over the brow.\"\n    category = \"chain\"\n    slot = \"head\"\n    rarity = \"common\"\n    headgear_recipe = \"orc-helm\"\n    appearance_recipe = \"orc-helmet-material\"\n    appearance_seed = 613\n    color_index = 11\n    ARMOR = 1\n    takeable = true\n    blocking = false\n    visible = true\n    on_look = \"A simple blue-black iron skullcap, battered from use.\"","authoring":"","position":{"x":0.0,"y":0.0,"z":0.0},"item_id":"90f97d0a-86bf-4e4e-a0c2-af133c03691c"},"30e79d3b-c685-492a-b96b-bde13927e5b5":{"id":"30e79d3b-c685-492a-b96b-bde13927e5b5","name":"Orc Patterned Vest","map":{"id":"6722a8f3-8a9f-4546-aaa8-5c9eee37f5cb","name":"New Map","offset":{"x":0.0,"y":0.0},"grid_size":30.0,"subdivisions":1.0,"vertices":[],"linedefs":[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"