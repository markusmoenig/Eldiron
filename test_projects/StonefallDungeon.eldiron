  let max_hp = get_attr_of( value.subject_id,  \"MAX_HP\");\n            if hp > 0 && hp * 2 <= max_hp {\n                set_target( value.subject_id);\n                use_action( \"minor_heal\");\n                clear_target();\n            }\n        }\n    }","data":"[attributes]\n    race = \"Human\"\n    class = \"Cleric\"\n    LEVEL = 1\n    facing = \"right\"\n    visible = true\n    hide_when_joined = true\n    radius = 0.35\n    add_items = [\"blessed_herb\", \"moonwater\", \"blessed_herb\", \"moonwater\"]\n    source_id = \"alden\"\n    on_look = \"A cleric waits by the wall, listening for movement deeper in Stonefall.\"\n\n    [intent_distance]\n    talk = 3\n","authoring":"[terminal]\nglyph = \"C\"\n","preview_rigging":"","position":{"x":0.0,"y":0.0,"z":0.0},"orientation":{"x":1.0,"y":0.0},"character_id":"518c78df-dbeb-49ca-a86e-91b9ee5dc34b"},"00ef8160-8e9e-4337-829d-ad40d659ef16":{"id":"00ef8160-8e9e-4337-829d-ad40d659ef16","name":"Bone Archer","map":{"id":"1d279861-9538-42c2-8e98-3eb6a123b1fd","name":"New Map","offset":{"x":0.0,"y":0.0},"grid_size":30.0,"subdivisions":1.0,"vertices":[],"linedefs":[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_linedefs":[],"selected_sectors":[],"selected_geometry_objects":[],"selected_entity_item":null,"properties":{"values":{}},"softrigs":{},"surfaces":{},"profiles":{},"shaders":{},"changed":0},"module":{"filter_text":"","id":"00000000-0000-0000-0000-000000000000","module_type":"CharacterTemplate","name":"Bone Archer","player":false,"routines":{},"view_name":""},"source":"","source_debug":"fn event(event, value) {\n        if event == \"startup\" {\n            random_walk( 1.0,  0.5,  5);\n            set_proximity_tracking( true,  6.5);\n            set_attr( \"target\",  \"\");\n        }\n        if event == \"proximity_warning\" {\n            let hostile = is_hostile( value);\n            if hostile == 1 {\n                if target() == \"\" {\n                    set_target( value);\n                }\n                follow_attack( value,  0.5);\n            }\n        }\n        if event == \"engagement_over\" {\n            clear_target();\n            random_walk( 1.0,  0.5,  5);\n            set_proximity_tracking( true,  6.5);\n        }\n        if event == \"kill\" {\n            clear_target();\n            random_walk( 1.0,  0.5,  5);\n            set_proximity_tracking( true,  6.5);\n        }\n        if event == \"arrived\" {\n            set_proximity_tracking( true,  6.5);\n            random_walk( 1.0,  0.5,  5);\n        }\n        if event == \"death\" {\n            drop_items( \"\");\n            set_attr( \"visible\",  false);\n        }\n        if event == \"damaged\" {\n            let amount = value.amount;\n            message( value.attacker_id,  \"You hit the Bone Archer for \" + amount + \" damage\",  \"\");\n            set_target( value.attacker_id);\n            follow_attack( value.attacker_id,  0.5);\n            set_proximity_tracking( true,  6.5);\n        }\n    }","data":"[attributes]\nspeed = 0.5\n    race = \"Skeleton\"\n    class = \"Ranger\"\n    LEVEL = 1\n    visible = true\n    radius = 0.35\n    inventory_slots = 8\n    start_equipped_items = [\"hunting_bow\"]\n    start_items = [\"wooden_arrows\", \"grave_dust\"]\n    source_id = \"bone_archer\"","authoring":"[terminal]\nglyph = \"A\"\n","preview_rigging":"","position":{"x":0.0,"y":0.0,"z":0.0},"orientation":{"x":1.0,"y":0.0},"character_id":"2dea178e-d108-4dba-a247-ca05947f32ee"},"90265ed6-86cf-4d20-811d-23e2025a5dca":{"id":"90265ed6-86cf-4d20-811d-23e2025a5dca","name":"Bone Warden","map":{"id":"130fd67a-2e72-4469-9103-d8c117691b93","name":"New Map","offset":{"x":0.0,"y":0.0},"grid_size":30.0,"subdivisions":1.0,"vertices":[],"linedefs":[],"sectors":[],"geometry_objects":[],"sky_texture":null,"camera":"TwoD","lights":[],"entities":[],"items":[],"selected_vertices":[],"selected_l