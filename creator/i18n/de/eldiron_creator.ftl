# Tools
tool_game = Spiel-Tool (K). Wenn der Server läuft, werden Eingabeereignisse an das Spiel gesendet.
tool_linedef = Linedef- / Kanten-Tool (E). 2D-Liniendefinitionen erstellen und 3D-Geometriekanten bearbeiten.
tool_object = Objekt-Tool (O). Objekte und Gegenstände zum Verfassen auswählen. Direkt bearbeitbare 3D-Geometrie verschieben.
tool_rect = Rect-Tool (R). Klicken, um die aktuelle Kachel zu zeichnen. Shift-Klick zum Löschen. Alt/Opt-Klick zum Aufnehmen aus der Karte.
tool_sector = Sektor-/Flächen-Tool (F). Wählt Sektoren in 2D oder Flächen in 3D.
tool_vertex = Vertex-Tool (V). 'Shift' + Klick erstellt einen neuen Vertex.
tool_entity = Entity-Tool (Y). Charaktere und Gegenstände in der Szene platzieren, auswählen, verschieben und löschen. Gegenstände können auf Böden oder Platzierungsflächen von Prefabs abgelegt werden.
tool_collision_probe = Kollisionsprobe-Tool (C). Klicken, um Wegpunkte hinzuzufügen, bewegen für die Vorschau des nächsten Segments, Escape beendet die Polyline.
status_iso_paint_active = 3D Paint: Klicke oder ziehe auf einer 3D-Oberfläche, um sie zu bemalen.
status_iso_paint_hit = 3D Paint: Geometrie-Treffer für Material-Paint gefunden.
status_iso_paint_ground = 3D Paint: Welt-Anker für Detail-Paint gefunden.
iso_paint_selected_brush = 3D-Paint-Pinsel
iso_paint_brush_material = Material-Paint
iso_paint_brush_material_desc = Malt Farbe, Höhe, Normalen und Masken direkt auf die getroffene Oberfläche.
iso_paint_brush_brick = Ziegelmuster
iso_paint_brush_brick_desc = Erzeugt ein Ziegelmuster in den lokalen Oberflächenkoordinaten der bemalten Fläche.
iso_paint_brush_moss = Moos
iso_paint_brush_moss_desc = Malt Moos und Schmutz bevorzugt in Vertiefungen, unteren Kanten und Steinflächen.
iso_paint_brush_crack = Riss
iso_paint_brush_crack_desc = Malt vertiefte Rissdetails in die Beauty-Layer der Oberfläche.
iso_paint_brush_grass = Grasdetail
iso_paint_brush_grass_desc = Platziert Gras- und Detail-Stamps auf der getroffenen Oberfläche.
iso_paint_brush_puddle = Pfütze
iso_paint_brush_puddle_desc = Malt flaches glänzendes Wasser mit weichen Rändern und nasser Materialwirkung.
iso_paint_brush_screen = Nur Farbe
iso_paint_brush_screen_desc = Malt nur die Farbüberlagerung, ohne Material- oder Finish-Daten zu ändern.
iso_paint_mode = Modus
iso_paint_mode_material = Material
iso_paint_mode_detail = Detail
