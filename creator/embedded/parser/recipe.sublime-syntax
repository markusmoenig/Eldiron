      scope: variable.other.member.eldiron-recipe
    - match: '\b[A-Z][A-Za-z0-9_]*\b'
      scope: constant.other.eldiron-recipe
    - match: '==|!=|<=|>=|[=+\-*/<>]'
      scope: keyword.operator.eldiron-recipe
