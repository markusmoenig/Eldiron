# Eldiron palette indices: 05-walls.palette.json (RGB below is the portable MaterialZ cache).
# Running-bond clay bricks with recessed mortar and subtle world-space weathering.
project 1
result from material "surface"
material "surface" called "Walls"
  mode pbr
  tiling raw
  default base color to 0.25 0.11 0.055
  default roughness to 0.85
  default metallic to 0
  default opacity to 1
  default emission to 0 0 0
  default emission strength to 0
  row "tone" called "Per Brick Clay Tone"
    use "Cell Data" id "brick-tone"
      set "scope" to 1
  row "shape" called "Brick Shape"
    use "Rounded Rectangle" id "brick-shape"
      set "halfSize" to 0.48 0.48
      set "radius" to 0.025
  row "profile" called "Brick Edge"
    use "Distance Profile" id "brick-edge"
      input from row "shape" distance
      set "width" to 0.055
      set "profile" to 2
    use "Multiply" id "brick-tone-shading"
      set "localValue" from row "tone" xxx mapped 0.6 to 1
  row "pattern" called "Brick Layout"
    use "Grid" id "brick-layout"
      input from row "profile" xyz
      set "cells" to 2 4
      set "continuous" to 1
      set "offset" to -0.0625 -0.125
      set "rowOffset" to 0.5
      set "gap" to 0.12 0.18
  row "weather" called "Continuous Weathering"
    use "Perlin Noise" id "wall-weather"
      set "globalScale" to 1.8
  row "color" called "Mortar and Clay"
    use "Color Ramp" id "wall-colors"
      input from row "pattern" xxx
      set "position0" to 0
      set "color0" to 0.045 0.04 0.032 1
      set "position1" to 0.25
      set "color1" to 0.26 0.07 0.028 1
      set "position2" to 0.72
      set "color2" to 0.32 0.1 0.04 1
      set "position3" to 0.86
      set "color3" to 0.43 0.15 0.065 1
      set "interpolation" to 0
    use "Multiply" id "wall-weathering"
      set "localValue" from row "weather" xxx mapped 0.95 to 1.05
  output base color from row "color" xyz
  output roughness from row "pattern" x mapped 0.98 to 0.72
