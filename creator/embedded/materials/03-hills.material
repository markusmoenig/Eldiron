# Eldiron palette indices: 03-hills.palette.json (RGB below is the portable MaterialZ cache).
# Wide terrain color bands. This is a surface material; it does not raise geometry.
project 1
result from material "surface"
material "surface" called "Hills"
  mode pbr
  tiling raw
  default base color to 0.2345506 0.2345506 0.2345506
  default roughness to 0.9
  default metallic to 0
  default opacity to 1
  default emission to 0.0065121 0.0065121 0.0065121
  default emission strength to 0
  row "contours" called "Broad Terrain Variation"
    use "Perlin Noise" id "hill-contours"
      set "globalScale" to 2.6
      set "localScale" to 1.8 1
    use "fBm" id "hill-detail"
      set "layers" to 2
      set "gain" to 0.3
  row "color" called "Stone Slopes and Crests"
    use "Color Ramp" id "hill-colors"
      input from row "contours" xxx
      set "position0" to 0.25
      set "color0" to 0.1094617 0.1094617 0.1094617 1
      set "position1" to 0.42
      set "color1" to 0.2345506 0.2345506 0.2345506 1
      set "position2" to 0.53
      set "color2" to 0.4564110 0.4564110 0.4564110 1
      set "position3" to 0.64
      set "color3" to 0.5711248 0.6239604 0.7230551 1
      set "interpolation" to 0
  output base color from row "color" xyz
  output roughness from row "contours" x mapped 0.8 to 0.98
