      "module": {
        "filter_text": "",
        "id": "00000000-0000-0000-0000-000000000000",
        "module_type": "CharacterTemplate",
        "name": "Player",
        "player": true,
        "routines": {},
        "view_name": ""
      },
      "source": "fn event(event, value) {\n        if event == \"startup\" {\n            set_player_camera( \"firstp_grid\");\n        }\n        if event == \"death\" {\n            set_attr( \"mode\",  \"active\");\n            set_attr( \"visible\",  true);\n            message( id(),  \"You died. Try again!\",  \"severe\");\n        }\n        if event == \"intent\" && value == \"attack\" {\n            set_target( value.subject_id);\n            attack();\n        }\n        if event == \"intent\" && value == \"take\" {\n            take( value.subject_id);\n        }\n        if event == \"intent\" && value == \"talk\" {\n            dialog( value.subject_id,  \"\");\n        }\n        if event == \"kill\" {\n            let name = get_attr_of( value,  \"name\");\n            message( id(),   \"You kill the \" + name,  \"success\");\n        }\n    }",
      "source_debug": "fn event(event, value) {\n        if event == \"startup\" {\n            set_player_camera( \"firstp_grid\");\n        }\n        if event == \"death\" {\n            set_attr( \"mode\",  \"active\");\n            set_attr( \"visible\",  true);\n            message( id(),  \"You died. Try again!\",  \"severe\");\n        }\n        if event == \"intent\" && value == \"attack\" {\n            set_target( value.subject_id);\n            attack();\n        }\n        if event == \"intent\" && value == \"take\" {\n            take( value.subject_id);\n        }\n        if event == \"intent\" && value == \"talk\" {\n            dialog( value.subject_id,  \"\");\n        }\n        if event == \"kill\" {\n            let name = get_attr_of( value,  \"name\");\n            message( id(),   \"You kill the \" + name,  \"success\");\n        }\n    }",
      "data": "[attributes]\nLEVEL = 1\nMAX_MP = 8\nMP = 8\nWIS = 12\nclass = \"Ranger\"\ninventory_slots = 6\nplayer = true\nplayer_camera = \"firstp_grid\"\nrace = \"Human\"\nradius = 0.35\nsize_2d = 1.25\nsource_id = \"player\"\nspells = [\"minor_heal\"]\nvisible = true\nwealth = 1\n\n[input]\na = \"action(left)\"\nc = \"intent(talk)\"\nd = \"action(right)\"\ndown = \"action(backward)\"\ne = \"action(strafe_right)\"\ng = \"intent(take)\"\nl = \"intent(look)\"\nleft = \"action(left)\"\nq = \"action(strafe_left)\"\nright = \"action(right)\"\ns = \"action(backward)\"\nt = \"intent(attack)\"\nup = \"action(forward)\"\nw = \"action(forward)\"\n",
      "authoring": "[terminal]\nglyph = \"@\"\n",
