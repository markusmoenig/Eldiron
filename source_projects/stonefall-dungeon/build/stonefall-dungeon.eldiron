      "module": {
        "filter_text": "",
        "id": "00000000-0000-0000-0000-000000000000",
        "module_type": "CharacterTemplate",
        "name": "Lysa",
        "player": false,
        "routines": {},
        "view_name": ""
      },
      "source": "fn event(event, value) {\n        if event == \"join_party\" {\n            set_attr( \"party_member\",  true);\n            set_attr( \"party_index\",  1);\n            set_attr( \"party_role\",  \"party.1\");\n            message( value.subject_id,  \"Lysa joins your party.\",  \"success\");\n        }\n    }",
      "source_debug": "fn event(event, value) {\n        if event == \"join_party\" {\n            set_attr( \"party_member\",  true);\n            set_attr( \"party_index\",  1);\n            set_attr( \"party_role\",  \"party.1\");\n            message( value.subject_id,  \"Lysa joins your party.\",  \"success\");\n        }\n    }",
      "data": "[attributes]\n    race = \"Human\"\n    class = \"Scout\"\n    LEVEL = 1\n    HP = 10\n    MAX_HP = 10\n    MP = 4\n    MAX_MP = 4\n    DEX = 13\n    visible = true\n    radius = 0.35\n    inventory_slots = 6\n    source_id = \"lysa\"\n    on_look = \"A scout waits in the gloom, listening for movement beyond the wall.\"\n\n    [intent_distance]\n    talk = 3\n\n    [dialog]\n    start = \"greeting\"\n\n    [dialog.nodes.greeting]\n    text = \"Lysa lowers her blade. \\\"Stonefall shifts in the dark. I can help you find the way out.\\\"\"\n    choices = [\n      { label = \"Join me.\", event = \"join_party\", end = true, unless = \"self.party_member\" },\n      { label = \"Stay here.\", end = true, unless = \"self.party_member\" },\n      { label = \"Ready?\", next = \"joined\", if = \"self.party_member\" },\n    ]\n\n    [dialog.nodes.joined]\n    text = \"\\\"I am with you. Keep your eyes on the side passages.\\\"\"\n    choices = [\n      { label = \"Let's move.\", end = true },\n    ]",
      "authoring": "[terminal]\nglyph = \"L\"\n",
      "preview_rigging": "",
      "position": {
        "x": 0.0,
        "y": 0.0,
        "z": 0.0
      },
      "orientation": {
        "x": 1.0,
        "y": 0.0
      },
      "character_id": "80c01d56-1656-4c60-baf9-62d0f3a5a609"
    },
    "d768758c-86bc-441d-8c53-463685cfffca": {
