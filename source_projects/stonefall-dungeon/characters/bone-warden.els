Character "bone_warden" {
  name = "Bone Warden"
  glyph = "W"

  data {
    [attributes]
    race = "Skeleton"
    class = "Warrior"
    LEVEL = 3
    visible = true
    radius = 0.35
    inventory_slots = 8
    start_equipped_items = ["novice_mace", "chain_shirt", "round_shield"]
    start_items = ["bone_key", "grave_dust"]
    source_id = "bone_warden"
  }

  script {
    fn event(event, value) {
        if event == "startup" {
            random_walk( 1.0,  0.55,  3);
            set_proximity_tracking( true,  5.5);
            set_attr( "target",  "");
        }
        if event == "proximity_warning" {
            let hostile = is_hostile( value);
            if hostile == 1 {
                if target() == "" {
                    set_target( value);
                }
                follow_attack( value,  0.55);
            }
        }
        if event == "engagement_over" {
            clear_target();
            random_walk( 1.0,  0.55,  3);
            set_proximity_tracking( true,  5.5);
        }
        if event == "kill" {
            clear_target();
            random_walk( 1.0,  0.55,  3);
            set_proximity_tracking( true,  5.5);
        }
        if event == "arrived" {
            set_proximity_tracking( true,  5.5);
            random_walk( 1.0,  0.55,  3);
        }
        if event == "death" {
            drop_items( "");
            set_attr( "visible",  false);
        }
        if event == "damaged" {
            let amount = value.amount;
            message( value.attacker_id,  "You hit the Bone Warden for " + amount + " damage",  "");
            set_target( value.attacker_id);
            follow_attack( value.attacker_id,  0.55);
            set_proximity_tracking( true,  5.5);
        }
    }
  }
}
