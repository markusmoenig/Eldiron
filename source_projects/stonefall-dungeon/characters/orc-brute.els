Character "orc_brute" {
  name = "Orc Brute"
  glyph = "B"

  data {
    [attributes]
    race = "Orc"
    class = "Warrior"
    LEVEL = 2
    visible = true
    radius = 0.35
    inventory_slots = 6
    start_equipped_items = ["hand_axe", "padded_armor"]
    start_items = ["ember_resin"]
    source_id = "orc_brute"
  }

  script {
    fn event(event, value) {
        if event == "startup" {
            random_walk( 1.0,  0.7,  3);
            set_proximity_tracking( true,  5.0);
            set_attr( "target",  "");
        }
        if event == "proximity_warning" {
            let hostile = is_hostile( value);
            if hostile == 1 {
                if target() == "" {
                    set_target( value);
                }
                follow_attack( value,  0.7);
            }
        }
        if event == "engagement_over" {
            clear_target();
            random_walk( 1.0,  0.7,  3);
            set_proximity_tracking( true,  5.0);
        }
        if event == "kill" {
            clear_target();
            random_walk( 1.0,  0.7,  3);
            set_proximity_tracking( true,  5.0);
        }
        if event == "arrived" {
            set_proximity_tracking( true,  5.0);
            random_walk( 1.0,  0.7,  3);
        }
        if event == "death" {
            drop_items( "");
            set_attr( "visible",  false);
        }
        if event == "damaged" {
            let amount = value.amount;
            message( value.attacker_id,  "You hit the Orc Brute for " + amount + " damage",  "");
            set_target( value.attacker_id);
            follow_attack( value.attacker_id,  0.7);
            set_proximity_tracking( true,  5.0);
        }
    }
  }
}
