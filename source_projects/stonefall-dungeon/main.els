tiles {
  # Walls
  "#" = wall-stone
  "%" = wall-stone
  "&" = wall-stone
  "4" = wall-stone
  "!" = wall-niche
  "?" = wall-stone profile=pillar

  # Floors: normal, tall, low
  "." = floor-stone ceiling=ceiling-stone ceiling_height=3.0
  "," = floor-stone ceiling=ceiling-stone ceiling_height=4.25
  ";" = floor-stone ceiling=ceiling-stone ceiling_height=2.25
  ":" = floor-stone ceiling=ceiling-stone ceiling_height=3.0
  "_" = floor-stone ceiling=ceiling-stone ceiling_height=4.25
  "~" = floor-stone ceiling=ceiling-stone ceiling_height=2.25
  "-" = floor-stone ceiling=ceiling-stone ceiling_height=3.0
  "*" = floor-stone ceiling=ceiling-stone ceiling_height=3.0
  "/" = floor-stone ceiling=ceiling-stone ceiling_height=4.25

  "@" = floor-stone ceiling=ceiling-stone ceiling_height=3.0
  "L" = floor-stone ceiling=ceiling-stone ceiling_height=3.0
  "O" = floor-stone ceiling=ceiling-stone ceiling_height=4.25
  "B" = floor-stone ceiling=ceiling-stone ceiling_height=2.25
  "S" = floor-stone ceiling=ceiling-stone ceiling_height=4.25
  "A" = floor-stone ceiling=ceiling-stone ceiling_height=4.25
  "W" = floor-stone ceiling=ceiling-stone ceiling_height=2.25
  "h" = floor-stone ceiling=ceiling-stone ceiling_height=2.25
  "b" = floor-stone ceiling=ceiling-stone ceiling_height=4.25
  "x" = floor-stone ceiling=ceiling-stone ceiling_height=2.25
}
