Item "exit" {
  name = "Exit Marker"
  glyph = "x"

  data {
    [attributes]
    source_id = "exit"
    source_symbol = "x"
    terminal_glyph = "x"
    takeable = false
    blocking = true
    visible = true
    unlocked = false
  }

  script {
    fn event(event, value) {
        if event == "intent" {
            let intent = value.string;
            if intent == "look" {
                let keys = inventory_items_of( value.subject_id,  "Bone Key");
                if keys.count > 0 {
                    set_attr( "unlocked",  true);
                    set_attr( "blocking",  false);
                    message( value.subject_id,  "The Bone Key turns. Cold air floods the stair as the way out of Stonefall opens.",  "success");
                } else {
                    message( value.subject_id,  "An iron ward seals the stair. The lock bears the same bone mark as the Warden below.",  "warning");
                }
            }
            if intent == "use" {
                let keys = inventory_items_of( value.subject_id,  "Bone Key");
                if keys.count > 0 {
                    set_attr( "unlocked",  true);
                    set_attr( "blocking",  false);
                    message( value.subject_id,  "The Bone Key turns. Cold air floods the stair as the way out of Stonefall opens.",  "success");
                } else {
                    message( value.subject_id,  "An iron ward seals the stair. The lock bears the same bone mark as the Warden below.",  "warning");
                }
            }
        }
        if event == "bumped_by_entity" {
            let unlocked = get_attr( "unlocked");
            if unlocked == false {
                let keys = inventory_items_of( value,  "Bone Key");
                if keys.count > 0 {
                    set_attr( "unlocked",  true);
                    set_attr( "blocking",  false);
                    message( value,  "The Bone Key turns. Cold air floods the stair as the way out of Stonefall opens.",  "success");
                } else {
                    message( value,  "An iron ward seals the stair. The lock bears the same bone mark as the Warden below.",  "warning");
                }
            }
        }
    }
  }
}
