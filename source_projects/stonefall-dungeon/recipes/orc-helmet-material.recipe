Material orc_helmet_material
    name = "Orc Worn Dark Iron"
    wrap = Repeat
    seed = 613

    Noise HammerMarks
        type = Value
        fractal = FBm
        scale = F2(18.0, 14.0)
        octaves = 3
        persistence = 0.42
        seed = 31

    Value SteelVariation
        source = Clamp(0.08 + HammerMarks * 0.25 + (1.0 - V) * 0.05, 0.0, 1.0)

    Color SteelShadow
        exact = #10151c

    Color SteelHighlight
        exact = #2e3947

    Color HammeredSteel
        source = Mix(SteelShadow, SteelHighlight, SteelVariation)

    Surface
        color = HammeredSteel
        palette = BaseOnly
        roughness = Clamp(0.58 + HammerMarks * 0.16, 0.0, 1.0)
        metallic = 0.68
        opacity = 1.0
        emission = 0.0
        normal = HammerMarks
        normal_strength = 0.12
