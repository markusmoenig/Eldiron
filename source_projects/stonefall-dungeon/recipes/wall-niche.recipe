Tile
    name = "Wall Niche"
    blocking = true
    size = I2(64, 64)
    coverage = I2(4, 4)
    wrap = Repeat
    seed = 42
    pixelate = 1

    Noise LocalWarp
        key = Id
        scale = I2(2, 2)
        octaves = 2
        persistence = 0.55
        seed = 7

    Noise BorderWear
        type = Gradient
        fractal = FBm
        scale = F2(11.0, 8.0)
        octaves = 3
        persistence = 0.52
        seed = 47

    Pattern Wall
        Bricks
            columns = 6
            rows = 9
            gap = 0.00
            bevel = 0.2
            rounding = 0.27
            rotation = Random(Id, -4.0, 4.0, 11)
            perturb = LocalWarp + Kerbs.height * 0.2
            perturb_amount = 0.040 + Random(Id, 0.0, 0.025, 15)
            seed = 19

    Pattern Kerbs
        Discs
            space = Wall.local
            cells = I2(4, 3)
            jitter = 0.92
            radius = 0.32 + Random(Wall.id, 0.0, 0.28, 5)
            falloff = 1.6
            perturb = LocalWarp
            perturb_amount = 0.5
            seed = 9

    Height Surface
        source = Wall.height

        Subtract
            source = Kerbs.height
            amount = 0.12

        Clamp
            min = 0.0
            max = 1.0

    Height RecessJoint
        source = 1.0 - Smoothstep(0.025, 0.080, Abs(Recess.distance) + (BorderWear - 0.5) * 0.028)

    MaterialMap
        base = dungeon/wall_mortar
        space = Global
        tiling = F2(4.0, 4.0)

        Layer
            material = dungeon/wall_stone
            mask = Pow(Wall.height, 1.6) * (1.0 - RecessJoint)
            space = Wall.local

    Geometry
        Niche Recess
            surface = niche-stone
            position = F2(0.12, 0.64)
            size = F2(0.76, 1.18)
            depth = 0.46
            sill = 0.12

    Output
        height = Surface
