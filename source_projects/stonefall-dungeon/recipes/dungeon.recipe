Material wall_stone
    name = "Wall Stone"
    wrap = Repeat
    seed = 301

    Noise Mineral
        key = Id
        type = Gradient
        fractal = Ridged
        scale = F2(3.0, 4.0)
        octaves = 3
        persistence = 0.52
        seed = 11

    Value WallDetail
        source = Smoothstep(0.16, 0.84, Mineral)

    Value WallUnitTone
        source = Random(Id, 0.0, 1.0, 53)

    Color WallShadow
        nearest = #2d2926

    Color WallBaseDark
        nearest = #575149

    Color WallBaseLight
        nearest = #686057

    Color WallBase
        source = Mix(WallBaseDark, WallBaseLight, WallUnitTone)

    Color WallColor
        source = Mix(WallShadow, WallBase, WallDetail)

    Surface
        color = WallColor
        palette = BaseOnly
        roughness = Clamp(0.32 + Mineral * 0.22, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emission = 0.0
        normal = Mineral
        normal_strength = 0.48

Material floor_stone
    name = "Floor Stone"
    wrap = Repeat
    seed = 307

    Noise Wear
        type = Gradient
        fractal = FBm
        scale = F2(5.0, 5.0)
        octaves = 3
        persistence = 0.46
        seed = 17

    Color FloorDark
        nearest = #292827

    Color FloorLight
        nearest = #55524d

    Color FloorColor
        source = Mix(FloorDark, FloorLight, Wear)

    Surface
        color = FloorColor
        palette = BaseOnly
        roughness = Clamp(0.24 + Wear * 0.20, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emission = 0.0
        normal = Wear
        normal_strength = 0.42

