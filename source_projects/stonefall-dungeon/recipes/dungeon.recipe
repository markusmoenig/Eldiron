Material wall_mortar
    name = "Mortar"
    wrap = Repeat
    seed = 317

    Noise Grit
        type = Value
        fractal = FBm
        scale = F2(8.0, 8.0)
        octaves = 3
        persistence = 0.48
        seed = 29

    Color MortarDark
        nearest = #171819

    Color MortarLight
        nearest = #343536

    Color MortarColor
        source = Mix(MortarDark, MortarLight, Grit * 0.58)

    Surface
        color = MortarColor
        palette = BaseOnly
        roughness = Clamp(0.70 + Grit * 0.16, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emission = 0.0
        normal = Grit
        normal_strength = 0.18
