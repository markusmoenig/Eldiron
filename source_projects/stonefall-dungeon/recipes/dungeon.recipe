Material wall_stone
    name = "Wall Stone"
    wrap = Repeat
    seed = 301

    Noise Mineral
        key = Id
        type = Gradient
        fractal = Ridged
        scale = F2(3.0, 4.0)
        octaves = 3
        persistence = 0.52
        seed = 11

    Value WallDetail
        source = Smoothstep(0.16, 0.84, Mineral)

    Value WallUnitTone
        source = Random(Id, 0.0, 1.0, 53)

    Color WallShadow
        nearest = #2d2926

    Color WallBaseDark
        nearest = #575149

    Color WallBaseLight
        nearest = #686057

    Color WallBase
        source = Mix(WallBaseDark, WallBaseLight, WallUnitTone)

    Color WallColor
        source = Mix(WallShadow, WallBase, WallDetail)

    Surface
        color = WallColor
        palette = BaseOnly
        roughness = Clamp(0.32 + Mineral * 0.22, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emission = 0.0
        normal = Mineral
        normal_strength = 0.48

