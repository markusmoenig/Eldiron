Material wall_stone
    name = "Stonefall Wall Stone"
    wrap = Repeat
    seed = 301

    Noise Mineral
        type = Gradient
        fractal = Ridged
        scale = F2(3.0, 4.0)
        octaves = 3
        persistence = 0.52
        seed = 11

    Height Tone
        source = Clamp(Input.height * 0.91 + Mineral * 0.09, 0.0, 1.0)

    Colorize
        source = Tone
        base = "#403A34"
        brightness = F2(-0.16, 0.15)
        saturation = F2(-0.04, 0.035)
        hue = F2(-0.005, 0.005)
        steps = 6
        range = F2(0.0, 1.0)

    MaterialData
        roughness = Clamp(0.72 + Mineral * 0.20, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emissive = 0.0

    Normal
        source = Clamp(Input.height + Mineral * 0.045, 0.0, 1.0)
        strength = 0.32

Material floor_stone
    name = "Stonefall Floor Stone"
    wrap = Repeat
