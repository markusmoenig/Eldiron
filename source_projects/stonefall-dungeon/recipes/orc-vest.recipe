Material orc_vest
    name = "Orc Patterned Vest"
    wrap = Repeat
    seed = 419

    Noise Wear
        type = Value
        fractal = FBm
        scale = F2(7.0, 9.0)
        octaves = 2
        persistence = 0.48
        seed = 23

    Value WarStrap
        source = 1.0 - Smoothstep(0.045, 0.105, Abs(U * 0.82 + V - 0.95))

    Value Pattern
        source = Clamp(WarStrap * 0.30 + Wear * 0.06, 0.0, 1.0)

    Color HideDark
        exact = #241a18

    Color OchreStitch
        exact = #4d3828

    Color VestColor
        source = Mix(HideDark, OchreStitch, Pattern)

    Surface
        color = VestColor
        palette = BaseOnly
        roughness = Clamp(0.76 + Wear * 0.14, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emission = 0.0
        normal = Pattern
        normal_strength = 0.16
