Sdf orc_helm
    name = "Orc Iron Skullcap"

    Shape Cap
        RoundedRectangle
            position = F2(0.5, 0.32)
            size = F2(0.50, 0.24)
            radius = 0.11

    Shape BrowRim
        Capsule
            from = F2(0.28, 0.445)
            to = F2(0.72, 0.445)
            radius = 0.016

    Shape Helmet
        Union
            a = Cap
            b = BrowRim

    Output
        coverage = Helmet
