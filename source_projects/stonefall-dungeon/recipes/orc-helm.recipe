Sdf orc_helm
    name = "Orc Steel Helm"

    Shape Dome
        Ellipse
            position = F2(0.5, 0.36)
            size = F2(0.78, 0.52)

    Shape FaceOpening
        RoundedRectangle
            position = F2(0.5, 0.56)
            size = F2(0.58, 0.30)
            radius = 0.08

    Shape Shell
        Subtract
            a = Dome
            b = FaceOpening

    Shape BrowRim
        Capsule
            from = F2(0.14, 0.47)
            to = F2(0.86, 0.47)
            radius = 0.045

    Shape ShellAndRim
        Union
            a = Shell
            b = BrowRim

    Shape LeftCheekGuard
        Capsule
            from = F2(0.19, 0.49)
            to = F2(0.19, 0.64)
            radius = 0.035

    Shape RightCheekGuard
        Capsule
            from = F2(0.81, 0.49)
            to = F2(0.81, 0.64)
            radius = 0.035

    Shape WithLeftGuard
        Union
            a = ShellAndRim
            b = LeftCheekGuard

    Shape WithCheekGuards
        Union
            a = WithLeftGuard
            b = RightCheekGuard

    Shape NasalGuard
        Capsule
            from = F2(0.5, 0.47)
            to = F2(0.5, 0.68)
            radius = 0.026

    Shape Helmet
        Union
            a = WithCheekGuards
            b = NasalGuard

    Output
        coverage = Helmet
