              "parts": [],
              "source": "browser-async-pbr-material",
              "bundle": "{\"version\": 1, \"source_library\": \"materialz-0.96.0-35662c6ff104a97b\", \"root\": {\"id\": \"browser-async-pbr-material\", \"recipe\": \"# Two bricks in each square, rotated by the parent cell's parity.\\n# Cell Data is evaluated in the instance scope passed through row connections.\\nproject 1\\nmaterial \\\"filtered-basketweave\\\" called \\\"Filtered Basketweave\\\"\\n  mode bsdf\\n  tiling raw\\n  default roughness to 0.78\\n  default specular to 0.3\\n  row \\\"parity\\\" called \\\"Group Parity\\\"\\n    use \\\"Cell Data\\\"\\n      set \\\"scope\\\" to 1\\n      set \\\"output\\\" to 7\\n  row \\\"tone\\\" called \\\"Brick Tone\\\"\\n    use \\\"Cell Data\\\"\\n      set \\\"scope\\\" to 1\\n  row \\\"shape\\\" called \\\"Brick\\\"\\n    use \\\"Rounded Rectangle\\\"\\n      set \\\"halfSize\\\" to 0.48 0.48\\n      set \\\"radius\\\" to 0.035\\n  row \\\"profile\\\" called \\\"Bevel\\\"\\n    use \\\"Distance Profile\\\"\\n      input from row \\\"shape\\\" distance\\n      set \\\"width\\\" to 0.045\\n      set \\\"profile\\\" to 2\\n    use \\\"Multiply\\\"\\n      set \\\"localValue\\\" from row \\\"tone\\\" xxx mapped 0.78 to 1\\n  row \\\"grain\\\" called \\\"Clay Grain\\\"\\n    use \\\"Organic Noise\\\"\\n      set \\\"scaleValue\\\" to 8\\n    use \\\"Levels\\\"\\n      set \\\"outputLow\\\" to 0.93\\n  row \\\"brick\\\" called \\\"Surface\\\"\\n    use \\\"Multiply\\\"\\n      input from row \\\"profile\\\" xyz\\n      set \\\"localValue\\\" from row \\\"grain\\\" xxx\\n  row \\\"pair\\\" called \\\"Brick Pair\\\"\\n    use \\\"Grid\\\"\\n      input from row \\\"brick\\\" xyz\\n      set \\\"cells\\\" to 1 2\\n      set \\\"gap\\\" to 0.015 0.025\\n    use \\\"Transform\\\"\\n      set \\\"rot\\\" from row \\\"parity\\\" x mapped 0 to 90\\n  row \\\"pattern\\\" called \\\"Layout\\\"\\n    use \\\"Grid\\\"\\n      input from row \\\"pair\\\" xyz\\n      set \\\"cells\\\" to 6 6\\n      set \\\"gap\\\" to 0.025 0.025\\n  row \\\"filtered\\\" called \\\"Image Filter\\\"\\n    use \\\"Directional Blur\\\"\\n      input from row \\\"pattern\\\" xyz\\n      set \\\"samples\\\" to 9\\n      set \\\"radius\\\" to 2\\n  row \\\"surface\\\" called \\\"Clay\\\"\\n    use \\\"Color Ramp\\\"\\n      input from row \\\"filtered\\\" xxx\\n      set \\\"position0\\\" to 0\\n      set \\\"color0\\\" to 0.1 0.088 0.065 1\\n      set \\\"position1\\\" to 0.18\\n      set \\\"color1\\\" to 0.18 0.043 0.018 1\\n      set \\\"position2\\\" to 0.7\\n      set \\\"color2\\\" to 0.44 0.12 0.035 1\\n      set \\\"color3\\\" to 0.68 0.24 0.075 1\\n  output base color from row \\\"surface\\\" xyz\\n  output height from row \\\"pattern\\\" x mapped 0 to 0.025\\n\"}, \"selected_material\": \"filtered-basketweave\", \"dependencies\": [], \"instances\": []}",
