Material stone
    name = "Dungeon Stone"
    wrap = Repeat
    seed = 73

    Noise Mineral
        type = Gradient
        fractal = Ridged
        scale = F2(4.0, 3.0)
        octaves = 3
        persistence = 0.52
        seed = 11

    Height Tone
        source = Clamp(Input.height * 0.90 + Mineral * 0.10, 0.0, 1.0)

    Colorize
        source = Tone
        palette = BaseOnly
        base = DarkBrown
        brightness = F2(-0.16, 0.18)
        saturation = F2(-0.05, 0.04)
        steps = 32
        range = F2(0.0, 1.0)

    MaterialData
        roughness = Clamp(0.66 + Mineral * 0.26, 0.0, 1.0)
        metallic = 0.0
        opacity = 1.0
        emissive = 0.0

    Normal
        source = Clamp(Input.height + Mineral * 0.04, 0.0, 1.0)
        strength = 0.30

Material worn_metal
    name = "Worn Metal"
    wrap = Repeat
    seed = 79

    Noise Wear
        type = Gradient
        fractal = Billow
        scale = F2(7.0, 7.0)
        octaves = 3
        persistence = 0.48

    Colorize
        source = Clamp(Input.height * 0.8 + Wear * 0.2, 0.0, 1.0)
        base = Gray
        brightness = F2(-0.20, 0.16)
        saturation = F2(-0.08, 0.02)
        steps = 6

    MaterialData
        roughness = Clamp(0.22 + Wear * 0.58, 0.0, 1.0)
        metallic = 0.88
        opacity = 1.0
        emissive = 0.0

    Normal
        source = Clamp(Input.height + Wear * 0.035, 0.0, 1.0)
        strength = 0.22
