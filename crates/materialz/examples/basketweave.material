project 1

material "basketweave" called "Basketweave Bricks"
  mode bsdf
  tiling raw
  period 1.0 1.0
  seam blend 0.15
  default roughness to 0.78
  default specular to 0.3
  row "parity" called "Group Parity"
    use "Cell Data"
      set "output" to 7.0
      set "scope" to 1.0
  row "tone" called "Brick Tone"
    use "Cell Data"
      set "scope" to 1.0
  row "shape" called "Brick"
    use "Rounded Rectangle"
      set "halfSize" to 0.48 0.48
      set "radius" to 0.035
  row "profile" called "Bevel"
    use "Distance Profile"
      input disconnected
    use "Multiply"
      input disconnected
      set "globalValue" from row "shape" distance
      set "localValue" from row "tone" xxx mapped 0.78 to 1.0
  row "grain" called "Clay Grain"
    use "Organic Noise"
      set "scaleValue" to 8.0
    use "Levels"
      set "outputLow" to 0.93
  row "brick" called "Surface"
    use "Multiply"
      input from row "profile" xyz
      set "localValue" from row "grain" xxx
  row "pair" called "Brick Pair"
    use "Grid"
      input from row "brick" xyz
      set "cells" to 1.0 2.0
      set "gap" to 0.015 0.025
    use "Transform"
      set "rot" from row "parity" x mapped 0.0 to 90.0
  row "pattern" called "Layout"
    use "Grid"
      input from row "pair" xyz
      set "cells" to 6.0 6.0
      set "gap" to 0.025 0.025
  row "surface" called "Clay"
    use "Color Ramp"
      input from row "pattern" xxx
      set "color0" to 0.1 0.088 0.065 1.0
      set "color1" to 0.18 0.043 0.018 1.0
      set "color2" to 0.44 0.12 0.035 1.0
      set "color3" to 0.68 0.24 0.075 1.0
      set "position0" to 0.0
      set "position1" to 0.18
      set "position2" to 0.7
  output base color from row "surface" xyz
  output height from row "pattern" x mapped 0.0 to 0.025
