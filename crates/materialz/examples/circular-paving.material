project 1
material "circular-paving" called "Circular Paving"
  mode bsdf
  tiling raw
  default roughness to 0.75
  default specular to 0.3
  row "variation" called "Cell Variation"
    use "Cell Data"
      set "scope" to 1
  row "shape" called "Shape"
    use "Rounded Rectangle"
      set "halfSize" from row "variation" random.xx mapped 0.39 to 0.48
      set "radius" to 0.06
  row "profile" called "Bevel"
    use "Distance Profile"
      input from row "shape" distance
      set "width" to 0.08
      set "profile" to 2
    use "Multiply"
      set "localValue" from row "variation" random.xxx mapped 0.72 to 1
  row "pattern" called "Rings"
    use "Grid"
      input from row "profile" xyz
      set "layout" to 1
      set "cells" to 12 10
      set "gap" to 0.03 0.05
      set "rowOffset" to 0.5
  row "color" called "Color"
    use "Color Ramp"
      input from row "pattern" xxx
      set "position0" to 0
      set "color0" to 0.04 0.042 0.047 1
      set "position1" to 0.1
      set "color1" to 0.1 0.08 0.055 1
      set "position2" to 0.7
      set "color2" to 0.28 0.23 0.16 1
      set "color3" to 0.48 0.41 0.29 1
  output base color from row "color" xyz
  output height from row "pattern" x mapped 0 to 0.04
