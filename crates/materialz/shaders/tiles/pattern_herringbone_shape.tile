tile 1
name "Herringbone (Pattern)"
category "Pattern"
description "Generates a herringbone pattern. Needs an input shape or pattern (by default Tile). Returns the cell id in the X component, the depth map in Y and the angle of the shape in degrees in the Z component. Use the Split Operator to access the individual components."
group "Herringbone Pattern" true
param float VCELLST "Cells" default 16 range 1 200
tooltip "The vertical amount of shapes."
param float inRatio "Ratio" default 4 range 1 14
tooltip "Width / height ratio of the individual shapes."
param float inGap "Gap" default 0.2 range 0.0 1.0
tooltip "Gap between the shapes in percent."
param float inMaxRandRot "Max Rotation" default 0.0 range 0.0 10
tooltip "Maximum random rotation per shape in degrees. A value of 0 means no rotation, a value of 10 means each shape gets randomly rotated up to 10 degrees."
param float probability "Probability" default 1.0 range 0.0 1
tooltip "The probability that a given shape is drawn, 1. always draws every shape, lower values draw less and less shapes."
group "Shapes" false
param vec2 shapeN "Amount" default 1 1 range 0 50
tooltip "The amount of shapes in the x and y direction."
param vec2 shapeGap "Gap" default 0.0 0.0 range 0 1
tooltip "The gap between the shapes."
group "About" true
group "Sampling" true
param float time "Time Offset" default 0
param vec3 extra3 "Input 3" default 0 0 0

