let v27 = v26
let v28 = vec2((v22).x*(v27).x+(v22).y*(v27).y, (v22).x*(v27).z+(v22).y*(v27).w)
let v29 = hash33(vec3(v21, 2))
let v30 = (v29).x
let v31 = vec2((v11 - (2. * v4)))
