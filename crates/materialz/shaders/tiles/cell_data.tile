tile 1
name "Cell Data"
category "System"
description "Periodic cell, row and column random values, local coordinates or cell centers. Integer cell counts repeat over one UV unit. Offset is measured in cells. Useful for stable per-element color, width, seed and placement controls. Preserves incoming alpha and optional distance."
output_field random "Cell Random" 0 x
output_field local "Local UV" 3 xy
output_field indices "Indices" 6 xy
output_field parity "Parity" 7 x
output_field group_random "Group Random" 8 x
output_field group "Group Key" 9 xyz
output_field key "Cell Key" 10 xyz
output_field center "Instance Center" 11 xyz
output_field size "Instance Size" 12 xyz
output_field angle "Instance Angle" 13 x
group "Grid" true
param vec2 cells "Cells" default 8 8 range 1 1024
tooltip "Integer cell counts per unit. Values are rounded, made positive and clamped to 1..1024."
param vec2 offset "Offset" default 0 0 range -1 1
tooltip "Grid offset in cell units. A half-cell offset centers cells at integer grid coordinates."
param float seed "Seed" default 0 range -1000 1000
param float scope "Scope" default 0 range 0 1
choices "UV Grid" "Instance"
group "Output" true
param float output "Output" default 0 range 0 13
choices "Cell Random" "Row Random" "Column Random" "Local UV" "Cell Center" "Cell Color" "Indices" "Parity" "Group Random" "Group Key" "Cell Key" "Instance Center" "Instance Size" "Instance Angle"

let count = clamp(round(abs(cells)), 1, 1024)
let p = (uv + 0.5) * count + offset
let cell = floor(p)
let wrapped = mod(cell, count)
let scoped = logical_and(equal(scope, 1), instance_valid)
let instanceKey = select(instance_valid, instance_cell, vec3(0))
let key = select(equal(scope, 1), instanceKey, vec3(wrapped, 0))
let group = select(logical_and(equal(scope, 1), instance_valid), instance_group, key)
let random = hash33(vec3(key.xy, key.z + floor(seed)))
let rowRandom = hash33(vec3(0, key.y, key.z + floor(seed)))
let columnRandom = hash33(vec3(key.x, 0, key.z + floor(seed)))
let local = select(equal(scope, 1), vec3(uv + 0.5, 0), vec3(fract(p), 0))
let center = select(equal(scope, 1), vec3(0), vec3((cell + 0.5 - offset) / count - 0.5, 0))
let result = select(equal(output, 0), vec3(random.x), select(equal(output, 1), vec3(rowRandom.x), select(equal(output, 2), vec3(columnRandom.x), select(equal(output, 3), local, select(equal(output, 4), center, random)))))
let extended = select(equal(output, 6), vec3(key.xy, 0), select(equal(output, 7), vec3(mod(key.x + key.y, 2)), select(equal(output, 8), vec3(hash33(group + vec3(0, 0, floor(seed))).x), select(equal(output, 9), group, key))))
let frame = select(equal(output, 11), instance_origin, select(equal(output, 12), vec3(length(instance_axis_x), length(instance_axis_y), 1), vec3(atan2(instance_axis_x.y, nonzero(instance_axis_x.x)) * 57.2957795131)))
image = vec4(select(greater(output, 10), frame, select(less(output, 6), result, extended)), input.a)
