tile 1
name "Random"
category "Pattern"
description "Creates a random distribution of the input shape. Returns the cell id in the X component, the depth map in Y and the angle of the shape in degrees in the Z component. Use the Split Operator to access the individual components."
group "Random Pattern" true
param float VCELLST "Cells" default 6 range 1 100
tooltip "The vertical amount of cells."
param float RATIO "Ratio" default 1.0 range 0.01 10
tooltip "Cell length / width ratio."
param float BLEND "Blend" default 0 range 0 1
choices "Addition" "Maximum"
param float DEPTH "Layers" default 1 range 1 3
tooltip "Amount of shape layers."
param float LACUNARITY "Lacunarity" default 4.0 range 0.0 10.0
tooltip "The amount the shapes get smaller per layer."
group "Shapes" false
param float RADIUSA "Scale" default 0.5 range 0.01 3
tooltip "Scale of the cells."
param float RADIUS_D "Size Distribution" default 1.0 range 0.0 2
tooltip "Size distribution of the cells. Higher values vary the size more."
param float AMP_D "Intensity Distribution" default 0.0 range 0.0 2
tooltip "Intensity distribution of the cells. Higher values vary the intensity of cells more."
param float NB "Shapes per Cell" default 1 range 1 3
tooltip "Amount of shapes per cell."
param float ROTshape1 "Random Rot." default 180.0 range 0.0 180
tooltip "Maximum random rotation in degrees."
group "About" true
group "Sampling" true
param float time "Time Offset" default 0
param vec3 extra3 "Input 3" default 0 0 0

