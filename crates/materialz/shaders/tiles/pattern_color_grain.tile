tile 1
name "Tileable Color Grain"
category "Pattern"
description "Creates a grainy color pattern based on two weighted colors."
group "Color Grain" true
param color colorA "Color A" default 0 0 0 1
param float weightA "Weight" default 1.4 range 0.0 2.0
param color colorB "Color B" default 1 1 1 1
param float weightB "Weight" default 0.6 range 0.0 2.0
group "Scale" true
param float globalScale "Global" default 0.6 range 0.0 1.0
param vec2 localScale "Local" default 1. 1. range -1000 1000
param float repeatScale "Repeat" default 16. range 0.0 16.0
group "About" true

let v0 = uv
let v1 = ((uv * 16.) * repeatScale)
let v2 = (v1 * repeatScale)
let v3 = vec2(0, 1)
let v4 = floor(v2)
let v5 = (v2 - v4)
let v6 = ((v5 * v5) * (3. - (2. * v5)))
let v7 = mod(((v4 + (v3).xx) * (globalScale * localScale)), repeatScale)
let v8 = v7
let v9 = sin(dot(v8, vec2(27, 57)))
let v10 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v9)) * 2.) - 1.))
let v11 = 1
let v12 = mod(((v4 + (v3).yx) * (globalScale * localScale)), repeatScale)
let v13 = v12
let v14 = sin(dot(v13, vec2(27, 57)))
let v15 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v14)) * 2.) - 1.))
let v16 = 1
let v17 = mix(dot(v10, (v5 - (v3).xx)), dot(v15, (v5 - (v3).yx)), (v6).x)
let v18 = mod(((v4 + (v3).xy) * (globalScale * localScale)), repeatScale)
let v19 = v18
let v20 = sin(dot(v19, vec2(27, 57)))
let v21 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v20)) * 2.) - 1.))
let v22 = 1
let v23 = mod(((v4 + (v3).yy) * (globalScale * localScale)), repeatScale)
let v24 = v23
let v25 = sin(dot(v24, vec2(27, 57)))
let v26 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v25)) * 2.) - 1.))
let v27 = 1
let v28 = mix(dot(v21, (v5 - (v3).xy)), dot(v26, (v5 - (v3).yy)), (v6).x)
let v29 = mix(v17, v28, (v6).y)
let v30 = select(0, 0, ((v29 * .5) + .5))
let v31 = 1
let v32 = (v1 * (repeatScale * 2.))
let v33 = vec2(0, 1)
let v34 = floor(v32)
let v35 = (v32 - v34)
let v36 = ((v35 * v35) * (3. - (2. * v35)))
let v37 = mod(((v34 + (v33).xx) * (globalScale * localScale)), (repeatScale * 2.))
let v38 = v37
let v39 = sin(dot(v38, vec2(27, 57)))
let v40 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v39)) * 2.) - 1.))
let v41 = 1
