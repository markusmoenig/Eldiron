let v193 = 1
let v194 = mix(dot(v186, (v167 - (v165).xy)), dot(v192, (v167 - (v165).yy)), (v168).x)
let v195 = mix(v181, v194, (v168).y)
let v196 = select(0, 0, ((v195 * .5) + .5))
let v197 = 1
let v198 = select(0, 0, (((v128 * .57) + (v162 * .28)) + (v196 * .15)))
let v199 = 1
let v200 = mix((v94 * weightA), (v94 * weightB), v198)
let v201 = v200
image = vec4(v201, input.a)
