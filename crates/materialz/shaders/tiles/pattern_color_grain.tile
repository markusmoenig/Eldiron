let v43 = v42
let v44 = sin(dot(v43, vec2(27, 57)))
let v45 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v44)) * 2.) - 1.))
let v46 = 1
let v47 = mix(dot(v40, (v35 - (v33).xx)), dot(v45, (v35 - (v33).yx)), (v36).x)
let v48 = mod(((v34 + (v33).xy) * (globalScale * localScale)), (repeatScale * 2.))
let v49 = v48
let v50 = sin(dot(v49, vec2(27, 57)))
let v51 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v50)) * 2.) - 1.))
let v52 = 1
let v53 = mod(((v34 + (v33).yy) * (globalScale * localScale)), (repeatScale * 2.))
let v54 = v53
let v55 = sin(dot(v54, vec2(27, 57)))
let v56 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v55)) * 2.) - 1.))
let v57 = 1
let v58 = mix(dot(v51, (v35 - (v33).xy)), dot(v56, (v35 - (v33).yy)), (v36).x)
let v59 = mix(v47, v58, (v36).y)
let v60 = select(0, 0, ((v59 * .5) + .5))
let v61 = 1
let v62 = (v1 * (repeatScale * 4.))
let v63 = vec2(0, 1)
let v64 = floor(v62)
let v65 = (v62 - v64)
let v66 = ((v65 * v65) * (3. - (2. * v65)))
let v67 = mod(((v64 + (v63).xx) * (globalScale * localScale)), (repeatScale * 4.))
let v68 = v67
let v69 = sin(dot(v68, vec2(27, 57)))
let v70 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v69)) * 2.) - 1.))
let v71 = 1
