let v73 = v72
let v74 = sin(dot(v73, vec2(27, 57)))
let v75 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v74)) * 2.) - 1.))
let v76 = 1
let v77 = mix(dot(v70, (v65 - (v63).xx)), dot(v75, (v65 - (v63).yx)), (v66).x)
let v78 = mod(((v64 + (v63).xy) * (globalScale * localScale)), (repeatScale * 4.))
let v79 = v78
let v80 = sin(dot(v79, vec2(27, 57)))
let v81 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v80)) * 2.) - 1.))
let v82 = 1
let v83 = mod(((v64 + (v63).yy) * (globalScale * localScale)), (repeatScale * 4.))
let v84 = v83
let v85 = sin(dot(v84, vec2(27, 57)))
let v86 = select(0, vec2(0), ((fract((vec2(2097152, 262144) * v85)) * 2.) - 1.))
let v87 = 1
let v88 = mix(dot(v81, (v65 - (v63).xy)), dot(v86, (v65 - (v63).yy)), (v66).x)
let v89 = mix(v77, v88, (v66).y)
let v90 = select(0, 0, ((v89 * .5) + .5))
let v91 = 1
let v92 = select(0, 0, (((v30 * .57) + (v60 * .28)) + (v90 * .15)))
let v93 = 1
let v94 = mix((colorA.rgb).xyz, (colorB.rgb).xyz, v92)
let v95 = (((uv * 32.) - .5) * repeatScale)
let v96 = (v95 * repeatScale)
let v97 = vec2(0, 1)
let v98 = floor(v96)
let v99 = (v96 - v98)
let v100 = ((v99 * v99) * (3. - (2. * v99)))
let v101 = mod(((v98 + (v97).xx) * (globalScale * localScale)), repeatScale)
let v102 = v101
