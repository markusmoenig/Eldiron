let v114 = mod(((v98 + (v97).xy) * (globalScale * localScale)), repeatScale)
let v115 = v114
let v116 = sin(dot(v115, vec2(27, 57)))
let v117 = ((fract((vec2(2097152, 262144) * v116)) * 2.) - 1.)
let v118 = select(0, vec2(0), v117)
