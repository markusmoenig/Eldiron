tile 1
name "Cracks"
category "Pattern"
description "Generates a pattern of random cracks. Returns the cell id in the X component and the depth map in Y component. Use the Split Operator to access the individual components."
group "Cracks Pattern" true
param float inCell "Cells" default 4 range 1 20
tooltip "The vertical amount of cells."
param float inType "Type" default 1 range 0 1
choices "Crest" "Fault"
param float RATIO "Ratio" default 2.0 range 0.01 10
tooltip "Tile length / width ratio."
param float probability "Probability" default 1.0 range 0.0 1
tooltip "The probability that a given shape is drawn, 1. always draws every shape, lower values draw less and less shapes."
group "Cell" false
param float STONE_slope "Cell Slope" default 0.3 range -1.0 1.0
param float STONE_height "Cell Height" default 1.0 range 0.0 1.0
param float STONE_profile "Profile" default 1.0 range 0.0 2.0
group "Crack" false
param float CRACK_zebra_scale "Zebra Scale" default 1.5 range 0.0 10.0
