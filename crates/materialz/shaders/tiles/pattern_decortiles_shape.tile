tooltip "The vertical amount of cells."
param float RATIO "Ratio" default 2.8 range 0.01 14.
tooltip "Width / height ratio of the individual tiles."
param float inGap "Gap" default 0.2 range 0.0 1.0
tooltip "Gap between the tiles in percent."
param float inMaxRandRot "Max Rotation" default 0.0 range 0.0 10
tooltip "Maximum random rotation per tile in degrees. A value of 0 means no rotation, a value of 10 means each tile gets randomly rotated up to 10 degrees."
