tile 1
name "Spots"
category "Noise"
description "Creates random spots of configurable styles and sizes."
group "Spot Noise" true
param float VCELLST "Cells" default 20 range 1 40
tooltip "The vertical amount of cells."
param float RATIO "Ratio" default 1.0 range 0.01 100
tooltip "Tile length / width ratio."
param float SHAPE "Profile" default 1 range 0 3
choices "Blob" "Gaussian" "Hemisphere" "Antisphere"
param float BLEND "Blend" default 0 range 0 1
choices "Addition" "Maximum"
group "Spots" false
param float RADIUSA "Radius" default 1.0 range 0.01 3
tooltip "Radius of the spots."
param float RADIUS_D "Size Distribution" default 0.0 range 0.0 2
tooltip "Size distribution of the spots."
param float NB "Dots per Cell" default 1 range 1 3
tooltip "Amount of dots per cell."
group "About" true

