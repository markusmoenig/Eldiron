tile 1
name "Organic fBm"
category "Noise"
description "Dave Hoskins' matching tileable value fBm, with its original amplitude, gain and final clamp. No input noise is needed. Integer frequency repeats over one UV unit."
references "Dave Hoskins; shaders/original/fbm_davestileablefbm.fs"
group "Fractal" true
param float layers "Octaves" default 5 range 2 20
param float amplitude "Amplitude" default 0.6 range 0.001 10
param float gain "Gain" default 0.5 range 0.001 3
param float scaleValue "Frequency" default 10 range 0.001 40

let point = mod(uv, scaleValue)
state frequency = scaleValue
state weight = amplitude
state total = 0
repeat 20 times layers while 1
let v0 = vec3(frequency)
let v1 = (point * (v0).x)
let v2 = vec2(0)
let v3 = fract(v1)
let v4 = floor(v1)
let v5 = ((v3 * v3) * (3.0 - (2.0 * v3)))
let v6 = mod(v4, (v0).x)
let v7 = (sin(dot(v6, vec2(27.16898, 38.90563))) * 5151.5473453)
let v8 = fract(v7)
let v9 = mod((v4 + vec2(1.0, 0.0)), (v0).x)
let v10 = (sin(dot(v9, vec2(27.16898, 38.90563))) * 5151.5473453)
let v11 = fract(v10)
let v12 = mod((v4 + vec2(0.0, 1.0)), (v0).x)
let v13 = (sin(dot(v12, vec2(27.16898, 38.90563))) * 5151.5473453)
let v14 = fract(v13)
let v15 = mod((v4 + vec2(1.0, 1.0)), (v0).x)
let v16 = (sin(dot(v15, vec2(27.16898, 38.90563))) * 5151.5473453)
let v17 = fract(v16)
let v18 = mix(mix(v8, v11, (v5).x), mix(v14, v17, (v5).x), (v5).y)
let v19 = v18
let v20 = vec3(v19)
update total = total + v19 * weight
update weight = weight * gain
update frequency = frequency * 2
end repeat
image = vec4(vec3(min(total, 1)), input.a)
