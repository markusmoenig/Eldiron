state v55 = inGap
state v56 = inMaxRandRot
state v57 = BRICK
state v58 = probability
state v59 = shapeN
state v60 = shapeGap
state v61 = SUPERCELL
state v62 = SUPERGAP
state v63 = (sample_time + time)
