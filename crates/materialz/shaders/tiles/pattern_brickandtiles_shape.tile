state v136 = v90
repeat 64 times (((((v84).x / 2.) - v90) / 1) + 1) while less_equal(v136, ((v131).x / 2.))
let v138 = (v134 + 1)
let v139 = hash33(vec3((vec3(v126, (.9 / v134), 0) * 4294967295.0)))
let v140 = v139
let v141 = (v140).x
let v142 = (sample_context((v124 + (vec2(v136, v135) * v132)), v94, v95, v110, vec3(v133, v141), vec3(v118, 0, 0), v98)).rgb
let v143 = (v119 + v142)
let v144 = (v136 + 1)
let v145 = (v138 + 1)
update v119 = v143
update v134 = v145
update v136 = v144
end repeat
let v150 = (v88 + 1)
update v72 = v119
update v87 = v134
update v88 = v150
end repeat
let v155 = select(equal(v23, 0), v72, v8)
let v156 = vec3(v29, (v155).y, (v155).z)
let v157 = vec3((v156).x, (v156).y, v32)
let v158 = step(v29, probability)
let v159 = vec3((v157).x, mix(0., (v157).g, v158), (v157).z)
let v160 = v159
image = vec4(v160, input.a)
