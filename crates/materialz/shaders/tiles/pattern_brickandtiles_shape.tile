let v14 = (floor((v12 / SUPERCELL)) * SUPERCELL)
let v15 = mod(v12, SUPERCELL)
let v16 = ((v15 - SUPERGAP) / (SUPERCELL - (2. * SUPERGAP)))
let v17 = 1
let v18 = select(different(v16, clamp(v16, 0., 1.)), v17, v6)
let v19 = clamp(v16, 0., 1.)
let v20 = (v14 + (v19 * SUPERCELL))
let v21 = select(different(SUPERCELL, vec2(0)), v18, v6)
let v22 = select(different(SUPERCELL, vec2(0)), v20, v12)
let v23 = select(BRICK, v6, v21)
let v24 = select(BRICK, v13, v22)
let v25 = vec2(select(equal(v5, vec2(0)), v24, mod(v24, v5)))
let v26 = v25
let v27 = (v11 * (fract(v24) - (1. / 2.)))
let v28 = hash33(vec3(v26, 2))
let v29 = (v28).x
let v30 = hash33(vec3(v26, 1))
let v31 = (v30).x
let v32 = (v2 + (v3 * ((-1.) + (2. * v31))))
let v33 = vec4(sin((radians(v32) + (vec4(1, 0, 2, 1) * 1.5707))))
let v34 = v33
let v35 = vec2((v27).x*(v34).x+(v27).y*(v34).y, (v27).x*(v34).z+(v27).y*(v34).w)
let v36 = vec2((v11 - (2. * v4)))
let v37 = (shapeN - 1.)
let v38 = (v36 / shapeN)
let v39 = ((v36 / shapeN) - shapeGap)
let v40 = vec2(min((v39).x, (v39).y))
let v41 = select(greater((shapeN).x, 1.0), v40, v39)
let v42 = 1.
let v43 = ((-(v37).y) / 2.)
