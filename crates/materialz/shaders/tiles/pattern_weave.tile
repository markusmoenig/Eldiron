tile 1
name "Weave"
category "Pattern"
description "Generates a weave pattern. The pattern can be modified via the pattern size properties."
group "Weave Pattern" true
param float scale "Scale" default 1.0 range 0.01 10.0
param float xSize "Pattern X-Size" default 0.5 range 0.0 1.0
param float ySize "Pattern Y-Size" default 0.5 range 0.0 1.0
param color color1 "Color #1" default 1.0 1.0 1.0 1.0
param color color2 "Color #2" default 0.0 0.0 0.0 1.0
group "About" true

let v0 = (((((uv * vec2(256)) * 1.) / scale) * 1.) / 2.0)
let v1 = vec4(1, 1, 1, 1)
let v2 = ((((uv * 1.) / scale) * 1.) / 2.0)
let v3 = vec2(xSize, ySize)
let v4 = (v2 * 8.)
let v5 = floor(v4)
let v6 = mod(((v5).x + (v5).y), 2.)
let v7 = mod((v5).y, 2.)
let v8 = fract(v4)
let v9 = vec2((1. - (v8).x), (v8).y)
let v10 = select(equal(v6, 1.), v9, v8)
let v11 = (v10 + vec2((-(v10).y), (v10).x))
let v12 = (sign((v7 - .5)) * sign((v6 - .5)))
let v13 = (((v3).y * cos(((.5 * 3.1415927) * (v11).y))) * v12)
let v14 = ((v3).x + v13)
let v15 = (abs((v11).x) - v14)
let v16 = smoothstep(0., .1, abs(v15))
let v17 = step(0., v15)
let v18 = ((v3).x + ((v3).y * cos(((.5 * 3.1415927) * (v11).x))))
let v19 = v18
let v20 = ((1. - v19) * v12)
let v21 = (((v11).y - 1.) - v20)
let v22 = step(0., v21)
let v23 = mod((v7 + v22), 2.)
let v24 = mod(((v7 + v6) + v22), 2.)
let v25 = select(less(v24, 1.), v17, 0.)
let v26 = (select(less(v24, 1.), v16, 1.) * smoothstep(0., .1, abs(v21)))
let v27 = v26
let v28 = (cos(((8. * 31.4) * (v2).x)) * cos(((8. * 31.4) * (v2).y)))
let v29 = ((2. * 31.4) * select(greater(v12, 0.), (2. - (v11).y), (v11).y))
let v30 = select(equal(v24, 1.), cos(((v29 * (v3).x) / v19)), cos(((2. * 31.4) * (((v11).x * (v3).x) / v14))))
let v31 = ((v25 * v28) + ((1. - v25) * v30))
let v32 = vec4((v31 * v27))
let v33 = (((v32).r * (color1.rgb).r) + ((1.0 - (v32).r) * (color2.rgb).r))
let v34 = vec4(v33, (v32).y, (v32).z, (v32).w)
let v35 = (((v34).g * (color1.rgb).g) + ((1.0 - (v34).g) * (color2.rgb).g))
let v36 = vec4((v34).x, v35, (v34).z, (v34).w)
let v37 = (((v36).b * (color1.rgb).b) + ((1.0 - (v36).b) * (color2.rgb).b))
let v38 = vec4((v36).x, (v36).y, v37, (v36).w)
let v39 = (v38).xyz
image = vec4(v39, input.a)
