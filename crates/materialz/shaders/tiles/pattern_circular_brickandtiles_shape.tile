let v144 = (v140 + 1)
let v145 = hash33(vec3((vec3(v134, (.9 / v140), 0) * 4294967295.0)))
let v146 = v145
let v147 = (v146).x
let v148 = (sample_context((v133 + (vec2(v142, v141) * v138)), v99, v100, v116, vec3(v139, v147), vec3(v125, 0, 0), v103)).rgb
