project 1
result from material "surface"
material "surface" called "Woodland / Worn Earth"
  mode pbr
  tiling seamless
  period 1 1
  seam blend 0.2
  default roughness to 0.97
  row "patches" called "Earth and Leaf Litter"
    use "Perlin Noise" id "patches"
      set "globalScale" to 1.9
      set "localScale" to 1.4 1
  row "color" called "Earth Ramp"
    use "Color Ramp" id "colors"
      input from row "patches" xxx
      set "position0" to 0.12
      set "color0" to 0.01 0.01 0.01 1
      set "position1" to 0.33
      set "color1" to 0.02 0.02 0.02 1
      set "position2" to 0.72
      set "color2" to 0.03 0.03 0.03 1
      set "position3" to 0.94
      set "color3" to 0.04 0.04 0.04 1
      set "interpolation" to 0
  output base color from row "color" xyz
