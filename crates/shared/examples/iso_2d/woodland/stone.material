project 1
result from material "surface"
material "surface" called "Woodland / Weathered Stone"
  mode pbr
  tiling seamless
  period 1 1
  seam blend 0.15
  default roughness to 0.94
  row "grain" called "Stone Patches"
    use "Perlin Noise" id "patches"
      set "globalScale" to 2.2
      set "localScale" to 1.2 1
  row "color" called "Stone and Lichen"
    use "Color Ramp" id "colors"
      input from row "grain" xxx
      set "position0" to 0.05
      set "color0" to 0.01 0.01 0.01 1
      set "position1" to 0.32
      set "color1" to 0.02 0.02 0.02 1
      set "position2" to 0.72
      set "color2" to 0.03 0.03 0.03 1
      set "position3" to 0.94
      set "color3" to 0.04 0.04 0.04 1
      set "interpolation" to 0
  output base color from row "color" xyz
