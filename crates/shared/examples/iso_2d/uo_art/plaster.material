project 1
result from material "surface"
material "surface" called "Art Study / Lime Plaster"
  mode pbr
  tiling raw
  default roughness to 0.98
  row "patches" called "Uneven Lime Wash"
    use "Perlin Noise" id "patches"
      set "globalScale" to 3
  row "grain" called "Fine Mineral Grain"
    use "White Noise" id "grain"
      set "cells" to 110 110
    use "Multiply" id "grain-strength"
      set "localValue" to 0.07 0.07 0.07
    use "Add" id "wash"
      set "localValue" from row "patches" xxx mapped 0.44 to 0.8
  row "color" called "Palette Surface"
    use "Color Ramp" id "colors"
      input from row "grain" xxx
      set "position0" to 0.1
      set "color0" to 0.04 0.03 0.02 1
      set "position1" to 0.35
      set "color1" to 0.19 0.17 0.12 1
      set "position2" to 0.65
      set "color2" to 0.49 0.45 0.31 1
      set "position3" to 0.9
      set "color3" to 0.68 0.63 0.47 1
      set "interpolation" to 1
  output base color from row "color" xyz
