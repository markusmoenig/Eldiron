project 1
result from material "surface"
material "surface" called "Art Study / Earth"
  mode pbr
  tiling raw
  default roughness to 0.93
  row "patches" called "Quiet World Variation"
    use "Perlin Noise" id "patches"
      set "globalScale" to 7
  row "grain" called "Fine Grain"
    use "White Noise" id "grain"
      set "cells" to 68 68
      set "seed" to 53
    use "Multiply" id "weathering"
      set "localValue" from row "patches" xxx mapped 0.7 to 1.1
  row "color" called "Palette Surface"
    use "Color Ramp" id "colors"
      input from row "grain" xxx
      set "position0" to 0.1
      set "color0" to 0.022174 0.006995 0.004777 1
      set "position1" to 0.35
      set "color1" to 0.051269 0.019382 0.012983 1
      set "position2" to 0.65
      set "color2" to 0.097587 0.042311 0.028426 1
      set "position3" to 0.9
      set "color3" to 0.165132 0.138432 0.088656 1
      set "interpolation" to 1
  output base color from row "color" xyz
