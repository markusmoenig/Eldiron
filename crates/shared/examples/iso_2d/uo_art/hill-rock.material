project 1
result from material "surface"
material "surface" called "Unending Night / Weathered hill rock"
  mode pbr
  tiling raw
  default roughness to 0.42
  default metallic to 0
  row "faces" called "Fractured slate"
    use "Voronoi" id "facets"
      set "globalScale" to 1.6
      set "localScale" to 1.6 0.7
      set "seed" to 67
  row "joints" called "Fine cracks between mineral faces"
    use "Subtract" id "cell-edge"
      input from row "faces" zzz
      set "localValue" from row "faces" yyy
    use "Smooth Step" id "crack-width"
      set "lowerEdge" to 0.02 0.02 0.02
      set "upperEdge" to 0.12 0.12 0.12
  row "face-tone" called "Quiet mineral face variation"
    use "Multiply" id "face-variation"
      input from row "faces" xxx
      set "localValue" to 0.34 0.34 0.34
  row "weathering" called "Fine natural weathering"
    use "Perlin Noise" id "weathering-noise"
      set "globalScale" to 1.4
    use "Multiply" id "weathering-level"
      set "localValue" to 0.32 0.32 0.32
  row "grain" called "Fine mineral grain"
    use "White Noise" id "grain"
      set "cells" to 68 68
      set "seed" to 79
    use "Multiply" id "grain-level"
      set "localValue" to 0.24 0.24 0.24
  row "surface" called "Weathered stone faces"
    use "Add" id "weathering"
      input from row "face-tone" xxx
      set "localValue" from row "weathering" xxx
    use "Add" id "mineral-grain"
      set "localValue" from row "grain" xxx
    use "Multiply" id "weathered-joints"
      set "localValue" from row "joints" xxx mapped 0.6 to 1
  row "color" called "Guildhall stone ramp"
    use "Color Ramp" id "colors"
      input from row "surface" xxx
      set "position0" to 0.08
      set "color0" to 0.02 0.02 0.02 1
      set "position1" to 0.29
      set "color1" to 0.06 0.06 0.06 1
      set "position2" to 0.52
      set "color2" to 0.15 0.15 0.15 1
      set "position3" to 0.80
      set "color3" to 0.3 0.3 0.3 1
      set "interpolation" to 1
  row "roughness" called "Subtle mineral highlights"
    use "Multiply" id "roughness-spread"
      input from row "faces" xxx
      set "localValue" to 0.2 0.2 0.2
    use "Add" id "roughness-base"
      set "localValue" to 0.34 0.34 0.34
  output base color from row "color" xyz
  output roughness from row "roughness" x
