project 1
result from material "surface"
material "surface" called "Art Study / Oak"
  mode pbr
  tiling raw
  default roughness to 0.93
  row "grain" called "Saw Grain"
    use "Perlin Noise" id "grain"
      set "globalScale" to 5
      set "localScale" to 4 0.12
    use "Multiply" id "wood-grit"
      set "localValue" from row "pores" xxx mapped 0.72 to 1.15
    use "Levels" id "grain-contrast"
      set "outputLow" to 0.22
      set "outputHigh" to 0.76
  row "pores" called "Wood Pores"
    use "White Noise" id "pores"
      set "cells" to 96 96
  row "color" called "Palette Surface"
    use "Color Ramp" id "colors"
      input from row "grain" xxx
      set "position0" to 0.1
      set "color0" to 0.022174 0.006995 0.004777 1
      set "position1" to 0.35
      set "color1" to 0.097587 0.042311 0.028426 1
      set "position2" to 0.65
      set "color2" to 0.250158 0.130136 0.090842 1
      set "position3" to 0.9
      set "color3" to 0.496933 0.300544 0.212231 1
      set "interpolation" to 1
  output base color from row "color" xyz
