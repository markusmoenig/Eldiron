project 1
result from material "surface"
material "surface" called "Art Study / Bark"
  mode pbr
  tiling raw
  default roughness to 0.93
  row "grain" called "Broken Vertical Bark"
    use "Perlin Noise" id "grain"
      set "globalScale" to 9
      set "localScale" to 3 0.35
    use "Multiply" id "bark-grit"
      set "localValue" from row "dust" xxx mapped 0.72 to 1.13
  row "dust" called "Bark Pores"
    use "White Noise" id "dust"
      set "cells" to 97 61
  row "color" called "Palette Surface"
    use "Color Ramp" id "colors"
      input from row "grain" xxx
      set "position0" to 0.1
      set "color0" to 0.022174 0.006995 0.004777 1
      set "position1" to 0.35
      set "color1" to 0.051269 0.019382 0.012983 1
      set "position2" to 0.65
      set "color2" to 0.162029 0.078187 0.052861 1
      set "position3" to 0.9
      set "color3" to 0.361307 0.205079 0.141263 1
      set "interpolation" to 1
  output base color from row "color" xyz
