# 32px navigation artwork. Editable stock MZ rows; colors bind to the project palette.
project 1
result from material "icon"
material "icon" called "Use - Leather Glove"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "palm" called "Gloved palm"
    use "Rounded Rectangle" id "palm-shape-0"
      set "center" to 0 0.1
      set "halfSize" to 0.22 0.2
      set "radius" to 0.085
    use "Directional Gradient" id "palm-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "palm-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "palm-outline"
      set "width" to 0.018
  row "finger-0" called "Glove finger 1"
    use "Rounded Rectangle" id "finger-0-shape-0"
      set "center" to -0.165 -0.12
      set "halfSize" to 0.048 0.16
      set "radius" to 0.045
    use "Directional Gradient" id "finger-0-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "finger-0-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "finger-0-outline"
      set "width" to 0.018
  row "finger-1" called "Glove finger 2"
    use "Rounded Rectangle" id "finger-1-shape-0"
      set "center" to -0.055 -0.19
      set "halfSize" to 0.048 0.2
      set "radius" to 0.045
    use "Directional Gradient" id "finger-1-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "finger-1-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "finger-1-outline"
      set "width" to 0.018
  row "finger-2" called "Glove finger 3"
    use "Rounded Rectangle" id "finger-2-shape-0"
      set "center" to 0.055 -0.21
      set "halfSize" to 0.048 0.22
      set "radius" to 0.045
    use "Directional Gradient" id "finger-2-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "finger-2-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "finger-2-outline"
      set "width" to 0.018
  row "finger-3" called "Glove finger 4"
    use "Rounded Rectangle" id "finger-3-shape-0"
      set "center" to 0.165 -0.15
      set "halfSize" to 0.048 0.18
      set "radius" to 0.045
    use "Directional Gradient" id "finger-3-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "finger-3-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "finger-3-outline"
      set "width" to 0.018
  row "thumb" called "Angled glove thumb"
    use "Rounded Rectangle" id "thumb-shape-0"
      set "center" to -0.24 0.05
      set "halfSize" to 0.075 0.16
      set "radius" to 0.055
    use "Directional Gradient" id "thumb-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "thumb-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "thumb-outline"
      set "width" to 0.018
    use "Transform" id "thumb-placement"
      set "rot" to -25
  row "cuff" called "Dark leather cuff"
    use "Rounded Rectangle" id "cuff-shape-0"
      set "center" to 0 0.33
      set "halfSize" to 0.19 0.065
      set "radius" to 0.02
    use "Directional Gradient" id "cuff-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "cuff-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "cuff-outline"
      set "width" to 0.018
  row "cuff-trim" called "Brass cuff edge"
    use "Rounded Rectangle" id "cuff-trim-shape-0"
      set "center" to 0 0.28
      set "halfSize" to 0.19 0.017
      set "radius" to 0.005
    use "Color" id "cuff-trim-color"
  row "composite-1" called "Finger 0 over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "palm" xyz
      set "foreground" from row "finger-0" xyzw
  row "composite-2" called "Finger 1 over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "finger-1" xyzw
  row "composite-3" called "Finger 2 over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "finger-2" xyzw
  row "composite-4" called "Finger 3 over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "finger-3" xyzw
  row "composite-5" called "Thumb over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "thumb" xyzw
  row "composite-6" called "Cuff over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "cuff" xyzw
  row "composite-7" called "Cuff Trim over previous layers"
    use "Alpha Over" id "composite-7"
      input from row "composite-6" xyz
      set "foreground" from row "cuff-trim" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-7" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-7" xyz
  output opacity from row "pixel-alpha" x
