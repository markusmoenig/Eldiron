# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Feather"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "vane" called "Ivory feather vane"
    use "Circle" id "vane-shape-0"
      set "center" to -0.2 0
      set "radius" to 0.63
    use "Circle" id "vane-shape-1"
      combine intersect
      set "center" to 0.2 0
      set "radius" to 0.63
    use "Directional Gradient" id "vane-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "vane-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "vane-outline"
      set "width" to 0.04
    use "Transform" id "vane-placement"
      set "offset" to 0 -0.04
      set "localScale" to 0.38 0.61
      set "rot" to 0
  row "quill" called "Central quill"
    use "Rounded Rectangle" id "quill-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.015 0.38
      set "radius" to 0.01
    use "Color" id "quill-color"
    use "Transform" id "quill-placement"
      set "offset" to 0 0.02
      set "localScale" to 1 1
      set "rot" to 180
  row "barb-0" called "Feather barb"
    use "Rounded Rectangle" id "barb-0-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.006 0.103078
      set "radius" to 0.004
    use "Color" id "barb-0-color"
    use "Transform" id "barb-0-placement"
      set "offset" to 0 -0.24
      set "localScale" to 1 1
      set "rot" to -112.834
  row "barb-1" called "Feather barb"
    use "Rounded Rectangle" id "barb-1-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.006 0.103078
      set "radius" to 0.004
    use "Color" id "barb-1-color"
    use "Transform" id "barb-1-placement"
      set "offset" to 0 -0.12
      set "localScale" to 1 1
      set "rot" to -112.834
  row "barb-2" called "Feather barb"
    use "Rounded Rectangle" id "barb-2-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.006 0.103078
      set "radius" to 0.004
    use "Color" id "barb-2-color"
    use "Transform" id "barb-2-placement"
      set "offset" to 0 0
      set "localScale" to 1 1
      set "rot" to -112.834
  row "barb-3" called "Feather barb"
    use "Rounded Rectangle" id "barb-3-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.006 0.103078
      set "radius" to 0.004
    use "Color" id "barb-3-color"
    use "Transform" id "barb-3-placement"
      set "offset" to 0 0.12
      set "localScale" to 1 1
      set "rot" to -112.834
  row "barb-4" called "Feather barb"
    use "Rounded Rectangle" id "barb-4-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.006 0.103078
      set "radius" to 0.004
    use "Color" id "barb-4-color"
    use "Transform" id "barb-4-placement"
      set "offset" to 0 0.22
      set "localScale" to 1 1
      set "rot" to -112.834
  row "composite-1" called "Quill over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "vane" xyz
      set "foreground" from row "quill" xyzw
  row "composite-2" called "Barb 0 over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "barb-0" xyzw
  row "composite-3" called "Barb 1 over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "barb-1" xyzw
  row "composite-4" called "Barb 2 over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "barb-2" xyzw
  row "composite-5" called "Barb 3 over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "barb-3" xyzw
  row "composite-6" called "Barb 4 over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "barb-4" xyzw
  row "icon-pose" called "Inventory pose"
    use "Transform" id "icon-pose"
      input from row "composite-6" xyz
      set "rot" to 32
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "icon-pose" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-pose" xyz
  output opacity from row "pixel-alpha" x
