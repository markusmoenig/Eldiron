# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Sunstone Outcrop"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "rock" called "Rock bed"
    use "Polygon" id "rock-shape-0"
      set "center" to 0 0.22
      set "radius" to 0.33
      set "sides" to 7
      set "rotation" to -15
    use "Directional Gradient" id "rock-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "rock-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "rock-outline"
      set "width" to 0.018
  row "left-shard" called "Crystal facets"
    use "Polygon" id "left-shard-shape-0"
      set "center" to 0 0
      set "radius" to 0.25
      set "sides" to 5
      set "rotation" to -90
    use "Directional Gradient" id "left-shard-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "left-shard-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "left-shard-outline"
      set "width" to 0.018
    use "Transform" id "left-shard-placement"
      set "offset" to -0.15 -0.01
      set "localScale" to 0.4891 1.022
      set "rot" to 0
  row "left-shard-facet" called "Crystal light facet"
    use "Rounded Rectangle" id "left-shard-facet-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.00949 0.165069
      set "radius" to 0.00632667
    use "Color" id "left-shard-facet-color"
    use "Transform" id "left-shard-facet-placement"
      set "offset" to -0.133575 -0.05015
      set "localScale" to 1 1
      set "rot" to -5.71059
  row "right-shard" called "Crystal facets"
    use "Polygon" id "right-shard-shape-0"
      set "center" to 0 0
      set "radius" to 0.25
      set "sides" to 5
      set "rotation" to -90
    use "Directional Gradient" id "right-shard-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "right-shard-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "right-shard-outline"
      set "width" to 0.018
    use "Transform" id "right-shard-placement"
      set "offset" to 0.15 -0.06
      set "localScale" to 0.5695 1.19
      set "rot" to 0
  row "right-shard-facet" called "Crystal light facet"
    use "Rounded Rectangle" id "right-shard-facet-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.01105 0.192204
      set "radius" to 0.00736667
    use "Color" id "right-shard-facet-color"
    use "Transform" id "right-shard-facet-placement"
      set "offset" to 0.169125 -0.10675
      set "localScale" to 1 1
      set "rot" to -5.71059
  row "main-shard" called "Crystal facets"
    use "Polygon" id "main-shard-shape-0"
      set "center" to 0 0
      set "radius" to 0.25
      set "sides" to 5
      set "rotation" to -90
    use "Directional Gradient" id "main-shard-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "main-shard-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "main-shard-outline"
      set "width" to 0.018
    use "Transform" id "main-shard-placement"
      set "offset" to 0 -0.13
      set "localScale" to 0.6298 1.316
      set "rot" to 0
  row "main-shard-facet" called "Crystal light facet"
    use "Rounded Rectangle" id "main-shard-facet-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.01222 0.212555
      set "radius" to 0.00814667
    use "Color" id "main-shard-facet-color"
    use "Transform" id "main-shard-facet-placement"
      set "offset" to 0.02115 -0.1817
      set "localScale" to 1 1
      set "rot" to -5.71059
  row "composite-1" called "Left Shard over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "rock" xyz
      set "foreground" from row "left-shard" xyzw
  row "composite-2" called "Left Shard Facet over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "left-shard-facet" xyzw
  row "composite-3" called "Right Shard over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "right-shard" xyzw
  row "composite-4" called "Right Shard Facet over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "right-shard-facet" xyzw
  row "composite-5" called "Main Shard over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "main-shard" xyzw
  row "composite-6" called "Main Shard Facet over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "main-shard-facet" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
