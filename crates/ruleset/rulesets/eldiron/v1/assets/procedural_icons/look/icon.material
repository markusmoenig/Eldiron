# 32px navigation artwork. Editable stock MZ rows; colors bind to the project palette.
project 1
result from material "icon"
material "icon" called "Look - Watchful Eye"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "eye" called "Ivory eye silhouette"
    use "Circle" id "eye-shape-0"
      set "center" to 0 0
      set "radius" to 0.4
    use "Directional Gradient" id "eye-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "eye-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "eye-outline"
      set "width" to 0.018
    use "Transform" id "eye-placement"
      set "localScale" to 1 0.50
  row "iris" called "Blue iris"
    use "Circle" id "iris-shape-0"
      set "center" to 0 0
      set "radius" to 0.17
    use "Directional Gradient" id "iris-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "iris-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "iris-outline"
      set "width" to 0.018
  row "pupil" called "Dark pupil"
    use "Circle" id "pupil-shape-0"
      set "center" to 0 0
      set "radius" to 0.08
    use "Color" id "pupil-color"
  row "glint" called "Small reflected highlight"
    use "Circle" id "glint-shape-0"
      set "center" to -0.045 -0.055
      set "radius" to 0.03
    use "Color" id "glint-color"
  row "composite-1" called "Iris over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "eye" xyz
      set "foreground" from row "iris" xyzw
  row "composite-2" called "Pupil over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "pupil" xyzw
  row "composite-3" called "Glint over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "glint" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-3" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-3" xyz
  output opacity from row "pixel-alpha" x
