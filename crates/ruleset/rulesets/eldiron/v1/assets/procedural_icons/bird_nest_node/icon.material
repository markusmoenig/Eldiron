# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Bird Nest Node"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "twigs-0" called "Woven nest twigs"
    use "Circle" id "twigs-0-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "twigs-0-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "twigs-0-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "twigs-0-outline"
      set "width" to 0.0588235
    use "Transform" id "twigs-0-placement"
      set "offset" to -0.04 0.13
      set "localScale" to 0.34 0.12
      set "rot" to 12
  row "twigs-1" called "Woven nest twigs"
    use "Circle" id "twigs-1-shape-0"
