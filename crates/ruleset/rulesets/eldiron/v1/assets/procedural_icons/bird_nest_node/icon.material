  row "straw" called "Crossing straw"
    use "Rounded Rectangle" id "straw-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.009 0.237592
      set "radius" to 0.006
    use "Color" id "straw-color"
    use "Transform" id "straw-placement"
      set "offset" to -0.035 0.235
      set "localScale" to 1 1
      set "rot" to -81.5289
  row "composite-1" called "Twigs 1 over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "twigs-0" xyz
      set "foreground" from row "twigs-1" xyzw
  row "composite-2" called "Twigs 2 over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "twigs-2" xyzw
  row "composite-3" called "Nest Hollow over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "nest-hollow" xyzw
  row "composite-4" called "Egg 0 over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "egg-0" xyzw
  row "composite-5" called "Egg 1 over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "egg-1" xyzw
  row "composite-6" called "Egg 2 over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "egg-2" xyzw
  row "composite-7" called "Straw over previous layers"
    use "Alpha Over" id "composite-7"
      input from row "composite-6" xyz
      set "foreground" from row "straw" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-7" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-7" xyz
  output opacity from row "pixel-alpha" x
