      set "interpolation" to 0
    use "Border" id "twigs-1-outline"
      set "width" to 0.0615385
    use "Transform" id "twigs-1-placement"
      set "offset" to 0.02 0.2
      set "localScale" to 0.325 0.12
      set "rot" to -12
