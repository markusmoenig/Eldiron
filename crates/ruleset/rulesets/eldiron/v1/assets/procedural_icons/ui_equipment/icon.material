# 32px navigation artwork. Editable stock MZ rows; colors bind to the project palette.
project 1
result from material "icon"
material "icon" called "Equipment - Steel Breastplate"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "plate" called "Shaped breastplate and shoulder plates"
    use "Rounded Rectangle" id "plate-shape-0"
      set "center" to 0 0.035
      set "halfSize" to 0.24 0.31
      set "radius" to 0.055
    use "Rounded Rectangle" id "plate-shape-1"
      combine union
      set "center" to 0 -0.22
      set "halfSize" to 0.35 0.09
      set "radius" to 0.035
    use "Circle" id "plate-shape-2"
      combine subtract
      set "center" to 0 -0.335
      set "radius" to 0.12
    use "Circle" id "plate-shape-3"
      combine subtract
      set "center" to -0.3 0.02
      set "radius" to 0.1
    use "Circle" id "plate-shape-4"
      combine subtract
      set "center" to 0.3 0.02
      set "radius" to 0.1
    use "Directional Gradient" id "plate-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "plate-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "plate-outline"
      set "width" to 0.018
  row "ridge" called "Raised central ridge"
    use "Rounded Rectangle" id "ridge-shape-0"
      set "center" to 0 0.035
      set "halfSize" to 0.015 0.22
      set "radius" to 0.008
    use "Color" id "ridge-color"
  row "waist" called "Brass waist band"
    use "Rounded Rectangle" id "waist-shape-0"
      set "center" to 0 0.3
      set "halfSize" to 0.22 0.045
      set "radius" to 0.015
    use "Directional Gradient" id "waist-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "waist-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "waist-outline"
      set "width" to 0.018
  row "rivets" called "Shoulder rivets"
    use "Circle" id "rivets-shape-0"
      set "center" to -0.28 -0.22
      set "radius" to 0.025
    use "Circle" id "rivets-shape-1"
      combine union
      set "center" to 0.28 -0.22
      set "radius" to 0.025
    use "Color" id "rivets-color"
  row "composite-1" called "Ridge over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "plate" xyz
      set "foreground" from row "ridge" xyzw
  row "composite-2" called "Waist over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "waist" xyzw
  row "composite-3" called "Rivets over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "rivets" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-3" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-3" xyz
  output opacity from row "pixel-alpha" x
