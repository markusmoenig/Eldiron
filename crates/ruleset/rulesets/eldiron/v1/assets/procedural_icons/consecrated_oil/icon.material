# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Consecrated Oil"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "glass" called "Glass bottle"
    use "Circle" id "glass-shape-0"
      set "center" to 0 0.11
      set "radius" to 0.255
    use "Rounded Rectangle" id "glass-shape-1"
      combine union
      set "center" to 0 -0.13
      set "halfSize" to 0.1 0.18
      set "radius" to 0.025
    use "Directional Gradient" id "glass-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "glass-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "glass-outline"
      set "width" to 0.018
  row "liquid" called "Oil"
    use "Circle" id "liquid-shape-0"
      set "center" to 0 0.11
      set "radius" to 0.205
    use "Rounded Rectangle" id "liquid-shape-1"
      combine intersect
      set "center" to 0 0
      set "halfSize" to 0.23 0.12
      set "radius" to 0
    use "Directional Gradient" id "liquid-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "liquid-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
  row "liquid-bottom" called "Rounded liquid base"
    use "Circle" id "liquid-bottom-shape-0"
      set "center" to 0 0.15
      set "radius" to 0.2
    use "Rounded Rectangle" id "liquid-bottom-shape-1"
      combine intersect
      set "center" to 0 0.16
      set "halfSize" to 0.21 0.18
      set "radius" to 0
    use "Directional Gradient" id "liquid-bottom-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "liquid-bottom-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
  row "cork" called "Bottle cork"
    use "Rounded Rectangle" id "cork-shape-0"
      set "center" to 0 -0.31
      set "halfSize" to 0.12 0.065
      set "radius" to 0.02
    use "Directional Gradient" id "cork-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "cork-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "cork-outline"
      set "width" to 0.018
  row "glass-glint" called "Glass reflection"
    use "Rounded Rectangle" id "glass-glint-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0175 0.0813941
      set "radius" to 0.0116667
    use "Color" id "glass-glint-color"
    use "Transform" id "glass-glint-placement"
      set "offset" to -0.145 0.07
      set "localScale" to 1 1
      set "rot" to 10.6197
  row "seal" called "Consecration seal"
    use "Circle" id "seal-shape-0"
      set "center" to 0.045 0.1
      set "radius" to 0.085
    use "Directional Gradient" id "seal-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "seal-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "seal-outline"
      set "width" to 0.018
  row "cross" called "Seal cross"
    use "Rounded Rectangle" id "cross-shape-0"
      set "center" to 0.045 0.1
      set "halfSize" to 0.016 0.05
      set "radius" to 0
    use "Rounded Rectangle" id "cross-shape-1"
      combine union
      set "center" to 0.045 0.1
      set "halfSize" to 0.045 0.016
      set "radius" to 0
    use "Color" id "cross-color"
  row "composite-1" called "Liquid over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "glass" xyz
      set "foreground" from row "liquid" xyzw
  row "composite-2" called "Liquid Bottom over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "liquid-bottom" xyzw
  row "composite-3" called "Cork over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "cork" xyzw
  row "composite-4" called "Glass Glint over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "glass-glint" xyzw
  row "composite-5" called "Seal over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "seal" xyzw
  row "composite-6" called "Cross over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "cross" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
