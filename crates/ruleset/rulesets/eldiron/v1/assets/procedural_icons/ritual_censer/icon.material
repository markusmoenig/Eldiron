# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Ritual Censer"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "handle" called "Hanging ring"
    use "Circle" id "handle-shape-0"
      set "center" to 0 -0.32
      set "radius" to 0.075
    use "Circle" id "handle-shape-1"
      combine subtract
      set "center" to 0 -0.32
      set "radius" to 0.04
    use "Directional Gradient" id "handle-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "handle-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "handle-outline"
      set "width" to 0.009
  row "chain-0" called "Suspension chain"
    use "Rounded Rectangle" id "chain-0-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0115 0.210297
      set "radius" to 0.00766667
    use "Color" id "chain-0-color"
    use "Border" id "chain-0-outline"
      set "width" to 0.007
    use "Transform" id "chain-0-placement"
      set "offset" to -0.1 -0.105
      set "localScale" to 1 1
      set "rot" to 28.393
  row "chain-1" called "Suspension chain"
    use "Rounded Rectangle" id "chain-1-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0115 0.210297
      set "radius" to 0.00766667
    use "Color" id "chain-1-color"
    use "Border" id "chain-1-outline"
      set "width" to 0.007
    use "Transform" id "chain-1-placement"
      set "offset" to 0.1 -0.105
      set "localScale" to 1 1
      set "rot" to -28.393
  row "bowl" called "Pierced brass bowl"
    use "Circle" id "bowl-shape-0"
      set "center" to 0 0.1
      set "radius" to 0.25
    use "Rounded Rectangle" id "bowl-shape-1"
      combine intersect
      set "center" to 0 0.22
      set "halfSize" to 0.3 0.13
      set "radius" to 0
    use "Directional Gradient" id "bowl-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "bowl-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "bowl-outline"
      set "width" to 0.018
  row "lid" called "Domed lid"
    use "Circle" id "lid-shape-0"
      set "center" to 0 0.1
      set "radius" to 0.24
    use "Rounded Rectangle" id "lid-shape-1"
      combine intersect
      set "center" to 0 0.03
      set "halfSize" to 0.27 0.08
      set "radius" to 0
    use "Directional Gradient" id "lid-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "lid-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "lid-outline"
      set "width" to 0.018
  row "vent" called "Incense vents"
    use "Rounded Rectangle" id "vent-shape-0"
      set "center" to -0.1 0.035
      set "halfSize" to 0.018 0.03
      set "radius" to 0.008
    use "Rounded Rectangle" id "vent-shape-1"
      combine union
      set "center" to 0 0.035
      set "halfSize" to 0.018 0.03
      set "radius" to 0.008
    use "Rounded Rectangle" id "vent-shape-2"
      combine union
      set "center" to 0.1 0.035
      set "halfSize" to 0.018 0.03
      set "radius" to 0.008
    use "Color" id "vent-color"
  row "foot" called "Censer foot"
    use "Rounded Rectangle" id "foot-shape-0"
      set "center" to 0 0.34
      set "halfSize" to 0.1 0.028
      set "radius" to 0.02
    use "Directional Gradient" id "foot-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "foot-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "foot-outline"
      set "width" to 0.018
  row "composite-1" called "Chain 0 over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "handle" xyz
      set "foreground" from row "chain-0" xyzw
  row "composite-2" called "Chain 1 over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "chain-1" xyzw
  row "composite-3" called "Bowl over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "bowl" xyzw
  row "composite-4" called "Lid over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "lid" xyzw
  row "composite-5" called "Vent over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "vent" xyzw
  row "composite-6" called "Foot over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "foot" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "bowl" w mapped 0 to 0.85
  output roughness from row "bowl" w mapped 0.8 to 0.35
