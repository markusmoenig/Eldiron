# Fixed 32px procedural sword; authored colors use companion palette-index bindings.
project 1
result from material "sword"
material "sword" called "Sword Icon"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "blade" called "Pointed Blade - Shape Intersection"
    use "Polygon" id "blade-point"
      set "sides" to 3
      set "radius" to 0.42
      set "rotation" to -90
      set "center" to 0 -0.03
    use "Rounded Rectangle" id "blade-sides"
      combine intersect
      set "halfSize" to 0.078125 0.3
      set "center" to 0 -0.15
      set "radius" to 0
    use "Directional Gradient" id "blade-colors-gradient"
      set "angle" to 180
      set "scale" to 5
      set "offset" to 0.5
    use "Color Ramp" id "blade-colors"
      set "position0" to 0.08
      set "position1" to 0.3
      set "position2" to 0.5
      set "position3" to 0.8
      set "interpolation" to 0
    use "Border" id "blade-outline"
      set "width" to 0.025
  row "fuller" called "Blade Groove"
    use "Rounded Rectangle" id "fuller-shape"
      set "halfSize" to 0.0078125 0.21875
      set "center" to 0.015625 -0.125
      set "radius" to 0.0078125
    use "Color" id "fuller-color"
  row "guard" called "Crossguard with Round Finials"
    use "Rounded Rectangle" id "guard-bar"
      set "halfSize" to 0.1875 0.03515625
      set "center" to 0 0.1484375
      set "radius" to 0.0234375
    use "Circle" id "guard-finial-left"
      combine union
      set "radius" to 0.04296875
      set "center" to -0.15625 0.1171875
    use "Circle" id "guard-finial-right"
      combine union
      set "radius" to 0.04296875
      set "center" to 0.15625 0.1171875
    use "Directional Gradient" id "guard-colors-gradient"
      set "angle" to 225
      set "scale" to 2.82842712
      set "offset" to 0.85
    use "Color Ramp" id "guard-colors"
      set "position0" to 0.08
      set "position1" to 0.3
      set "position2" to 0.5
      set "position3" to 0.8
      set "interpolation" to 0
    use "Border" id "guard-outline"
      set "width" to 0.02
  row "grip-mask" called "Grip Silhouette"
    use "Rounded Rectangle" id "grip-shape"
      set "halfSize" to 0.046875 0.10546875
      set "center" to 0 0.2890625
      set "radius" to 0.015625
  row "grip" called "Wrapped Leather Grip"
    use "Coordinates" id "wrap-coordinates"
      input from row "grip-mask" xyz
    use "Vector Math" id "wrap-direction"
      set "operation" to 2
      set "other" to 0.45 1 0
    use "Multiply" id "wrap-frequency"
      set "localValue" to 32 32 32
    use "Fract" id "wrap-repeat"
    use "Color Ramp" id "grip-colors"
      set "position0" to 0
      set "position1" to 0.25
      set "position2" to 0.65
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "grip-outline"
      set "width" to 0.015625
  row "pommel" called "Metal Pommel"
    use "Circle" id "pommel-shape"
      set "radius" to 0.0625
      set "center" to 0 0.421875
    use "Directional Gradient" id "pommel-colors-gradient"
      set "angle" to 225
      set "scale" to 7.07106781
      set "offset" to 2.6
    use "Color Ramp" id "pommel-colors"
      set "position0" to 0.08
      set "position1" to 0.3
      set "position2" to 0.5
      set "position3" to 0.8
      set "interpolation" to 0
    use "Border" id "pommel-outline"
      set "width" to 0.015625
  row "jewel" called "Pommel Inlay"
    use "Circle" id "jewel-shape"
      set "radius" to 0.0234375
      set "center" to 0 0.421875
    use "Color" id "jewel-color"
  row "grooved-blade" called "Groove Over Blade"
    use "Alpha Over" id "grooved-blade-over"
      input from row "blade" xyz
      set "foreground" from row "fuller" xyzw
  row "guard-over-blade" called "Guard Over Blade"
    use "Alpha Over" id "guard-over-blade-over"
      input from row "grooved-blade" xyz
      set "foreground" from row "guard" xyzw
  row "grip-over-guard" called "Grip Over Guard"
    use "Alpha Over" id "grip-over-guard-over"
      input from row "guard-over-blade" xyz
      set "foreground" from row "grip" xyzw
  row "pommel-over-grip" called "Pommel Over Grip"
    use "Alpha Over" id "pommel-over-grip-over"
      input from row "grip-over-guard" xyz
      set "foreground" from row "pommel" xyzw
  row "finished" called "Inlay Over Pommel"
    use "Alpha Over" id "finished-over"
      input from row "pommel-over-grip" xyz
      set "foreground" from row "jewel" xyzw
  row "oriented" called "Icon Pose"
    use "Transform" id "icon-pose"
      input from row "finished" xyz
      set "globalScale" to 1.14
      set "rot" to 45
  row "pixel-alpha" called "Pixel Silhouette"
    use "Compare/Select" id "silhouette"
      input from row "oriented" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "oriented" xyz
  output opacity from row "pixel-alpha" x
