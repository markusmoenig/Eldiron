# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Moonleaf"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "stem-0" called "Leafy stem"
    use "Rounded Rectangle" id "stem-0-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0175 0.300666
      set "radius" to 0.0116667
    use "Color" id "stem-0-color"
    use "Border" id "stem-0-outline"
      set "width" to 0.008
    use "Transform" id "stem-0-placement"
      set "offset" to -0.02 0.02
      set "localScale" to 1 1
      set "rot" to 176.186
  row "leaf-0-0" called "Leaf 0 0"
    use "Circle" id "leaf-0-0-shape-0"
      set "center" to -0.23 0
      set "radius" to 0.7
    use "Circle" id "leaf-0-0-shape-1"
      combine intersect
      set "center" to 0.23 0
      set "radius" to 0.7
    use "Directional Gradient" id "leaf-0-0-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "leaf-0-0-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "leaf-0-0-outline"
      set "width" to 0.04
    use "Transform" id "leaf-0-0-placement"
      set "offset" to -0.1105 0.13
      set "localScale" to 0.24 0.12
      set "rot" to -45
  row "leaf-0-1" called "Leaf 0 1"
    use "Circle" id "leaf-0-1-shape-0"
      set "center" to -0.23 0
      set "radius" to 0.7
    use "Circle" id "leaf-0-1-shape-1"
      combine intersect
      set "center" to 0.23 0
      set "radius" to 0.7
    use "Directional Gradient" id "leaf-0-1-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "leaf-0-1-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "leaf-0-1-outline"
      set "width" to 0.04
    use "Transform" id "leaf-0-1-placement"
      set "offset" to 0.102 0.015
      set "localScale" to 0.24 0.12
      set "rot" to 45
  row "leaf-0-2" called "Leaf 0 2"
    use "Circle" id "leaf-0-2-shape-0"
      set "center" to -0.23 0
      set "radius" to 0.7
    use "Circle" id "leaf-0-2-shape-1"
      combine intersect
      set "center" to 0.23 0
      set "radius" to 0.7
    use "Directional Gradient" id "leaf-0-2-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "leaf-0-2-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "leaf-0-2-outline"
      set "width" to 0.04
    use "Transform" id "leaf-0-2-placement"
      set "offset" to -0.119 -0.1
      set "localScale" to 0.24 0.12
      set "rot" to -45
  row "leaf-0-3" called "Leaf 0 3"
    use "Circle" id "leaf-0-3-shape-0"
      set "center" to -0.23 0
      set "radius" to 0.7
    use "Circle" id "leaf-0-3-shape-1"
      combine intersect
      set "center" to 0.23 0
      set "radius" to 0.7
    use "Directional Gradient" id "leaf-0-3-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "leaf-0-3-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "leaf-0-3-outline"
      set "width" to 0.04
    use "Transform" id "leaf-0-3-placement"
      set "offset" to 0.068 -0.22
      set "localScale" to 0.24 0.12
      set "rot" to 25
  row "moon" called "Silver crescent flower"
    use "Circle" id "moon-shape-0"
      set "center" to -0.04 -0.32
      set "radius" to 0.075
    use "Circle" id "moon-shape-1"
      combine subtract
      set "center" to -0.01 -0.345
      set "radius" to 0.063
    use "Directional Gradient" id "moon-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "moon-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "moon-outline"
      set "width" to 0.008
  row "composite-1" called "Leaf 0 0 over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "stem-0" xyz
      set "foreground" from row "leaf-0-0" xyzw
  row "composite-2" called "Leaf 0 1 over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "leaf-0-1" xyzw
  row "composite-3" called "Leaf 0 2 over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "leaf-0-2" xyzw
  row "composite-4" called "Leaf 0 3 over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "leaf-0-3" xyzw
  row "composite-5" called "Moon over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "moon" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-5" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-5" xyz
  output opacity from row "pixel-alpha" x
