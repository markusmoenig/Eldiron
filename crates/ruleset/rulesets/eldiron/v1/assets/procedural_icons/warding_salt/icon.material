# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Warding Salt"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "sack" called "Reagent pouch"
    use "Rounded Rectangle" id "sack-shape-0"
      set "center" to 0 0.1
      set "halfSize" to 0.26 0.24
      set "radius" to 0.12
    use "Polygon" id "sack-shape-1"
      combine union
      set "center" to 0 -0.13
      set "radius" to 0.2
      set "sides" to 3
      set "rotation" to -90
    use "Directional Gradient" id "sack-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "sack-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "sack-outline"
      set "width" to 0.018
  row "tie" called "Cord tie"
    use "Rounded Rectangle" id "tie-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.02 0.16
      set "radius" to 0.0133333
    use "Color" id "tie-color"
    use "Border" id "tie-outline"
      set "width" to 0.012
    use "Transform" id "tie-placement"
      set "offset" to 0 -0.12
      set "localScale" to 1 1
      set "rot" to -90
  row "label" called "Salt crystal label"
    use "Polygon" id "label-shape-0"
      set "center" to 0 0.09
      set "radius" to 0.105
      set "sides" to 4
      set "rotation" to 0
    use "Directional Gradient" id "label-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "label-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "label-outline"
      set "width" to 0.018
  row "grains" called "Spilled salt"
    use "Rounded Rectangle" id "grains-shape-0"
      set "center" to -0.23 0.36
      set "halfSize" to 0.022 0.022
      set "radius" to 0
    use "Rounded Rectangle" id "grains-shape-1"
      combine union
      set "center" to 0.18 0.34
      set "halfSize" to 0.025 0.025
      set "radius" to 0
    use "Rounded Rectangle" id "grains-shape-2"
      combine union
      set "center" to 0.28 0.36
      set "halfSize" to 0.016 0.016
      set "radius" to 0
    use "Color" id "grains-color"
  row "composite-1" called "Tie over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "sack" xyz
      set "foreground" from row "tie" xyzw
  row "composite-2" called "Label over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "label" xyzw
  row "composite-3" called "Grains over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "grains" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-3" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-3" xyz
  output opacity from row "pixel-alpha" x
