# 32px procedural round shield. Colors are authored in the companion palette variants.
project 1
result from material "shield"
material "shield" called "Riveted Shield "
  mode pbr
  tiling raw
  default roughness to 0.45
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "rim" called "Metal Rim"
    use "Circle" id "rim-shape"
      set "radius" to 0.4375
    use "Directional Gradient" id "rim-colors-gradient"
      set "angle" to 225
      set "scale" to 1.20208153
      set "offset" to 0.5
    use "Color Ramp" id "rim-colors"
      set "position0" to 0.18
      set "position1" to 0.43
      set "position2" to 0.57
      set "position3" to 0.82
      set "interpolation" to 0
    use "Border" id "outer-outline"
      set "width" to 0.03125
  row "face" called "Painted Face"
    use "Circle" id "face-shape"
      set "radius" to 0.34375
    use "Directional Gradient" id "face-colors-gradient"
      set "angle" to 225
      set "scale" to 1.20208153
      set "offset" to 0.5
    use "Color Ramp" id "face-colors"
      set "position0" to 0.18
      set "position1" to 0.43
      set "position2" to 0.57
      set "position3" to 0.82
      set "interpolation" to 0
    use "Border" id "face-outline"
      set "width" to 0.03125
  row "emblem" called "Raised Cross"
    use "Rounded Rectangle" id "cross-vertical"
      set "halfSize" to 0.046875 0.203125
      set "radius" to 0.015625
      set "center" to 0 -0.03125
    use "Rounded Rectangle" id "cross-horizontal"
      combine union
      set "halfSize" to 0.171875 0.046875
      set "radius" to 0.015625
      set "center" to 0 -0.078125
    use "Color" id "emblem-color"
    use "Border" id "emblem-outline"
      set "width" to 0.015625
  row "boss" called "Central Boss"
    use "Circle" id "boss-shape"
      set "radius" to 0.109375
    use "Directional Gradient" id "boss-colors-gradient"
      set "angle" to 225
      set "scale" to 1.20208153
      set "offset" to 0.5
    use "Color Ramp" id "boss-colors"
      set "position0" to 0.36
      set "position1" to 0.46
      set "position2" to 0.54
      set "position3" to 0.64
      set "interpolation" to 0
    use "Border" id "boss-outline"
      set "width" to 0.03125
  row "rivet" called "One Rivet"
    use "Circle" id "rivet-shape"
      set "radius" to 0.43
    use "Color" id "rivet-color"
    use "Border" id "rivet-outline"
      set "width" to 0.13
    use "Transform" id "rivet-cell-aspect"
      set "localScale" to 0.625 0.08
  row "rivet-ring" called "Radial Rivets - Grid Rings"
    use "Grid" id "radial-rivets"
      input from row "rivet" xyz
      set "layout" to 1
      set "cells" to 5 1
      set "offset" to 0 0.140625
      set "scale" to 1 1
      set "gap" to 0 0
  row "rivet-alpha" called "Rivet Pixel Mask"
    use "Compare/Select" id "rivet-threshold"
      input from row "rivet-ring" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  row "rivets" called "Rivet RGBA"
    use "Compose Channels" id "rivet-pixel-mask"
      set "x" from row "rivet-ring" x
      set "y" from row "rivet-ring" y
      set "z" from row "rivet-ring" z
      set "alpha" from row "rivet-alpha" x
  row "face-over-rim" called "Face Over Rim"
    use "Alpha Over" id "face-over-rim-over"
      input from row "rim" xyz
      set "foreground" from row "face" xyzw
  row "emblem-over-face" called "Emblem Over Face"
    use "Alpha Over" id "emblem-over-face-over"
      input from row "face-over-rim" xyz
      set "foreground" from row "emblem" xyzw
  row "boss-over-emblem" called "Boss Over Emblem"
    use "Alpha Over" id "boss-over-emblem-over"
      input from row "emblem-over-face" xyz
      set "foreground" from row "boss" xyzw
  row "finished" called "Rivets Over Shield"
    use "Alpha Over" id "finished-over"
      input from row "boss-over-emblem" xyz
      set "foreground" from row "rivets" xyzw
  row "pixel-alpha" called "Pixel Silhouette"
    use "Compare/Select" id "silhouette"
      input from row "finished" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  row "metal-finish" called "Metal rim, boss and rivets"
    use "One Minus" id "rim-metal-mask"
      input from row "face" www
    use "Max" id "boss-metal-mask"
      set "globalValue" to 1
      set "localValue" from row "boss" www
    use "Max" id "rivet-metal-mask"
      set "globalValue" to 1
      set "localValue" from row "rivet-alpha" xxx
  output metallic from row "metal-finish" x
  output roughness from row "metal-finish" x mapped 0.8 to 0.3
  output base color from row "finished" xyz
  output opacity from row "pixel-alpha" x
