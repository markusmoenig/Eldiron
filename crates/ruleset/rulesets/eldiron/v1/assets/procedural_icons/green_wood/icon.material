# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Green Wood"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "lower-bark" called "Cut log bark"
    use "Rounded Rectangle" id "lower-bark-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.26 0.12
      set "radius" to 0.04
    use "Directional Gradient" id "lower-bark-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "lower-bark-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "lower-bark-outline"
      set "width" to 0.018
    use "Transform" id "lower-bark-placement"
      set "offset" to 0.03 0.17
      set "localScale" to 1 1
      set "rot" to -10
  row "lower-cut" called "End grain"
    use "Circle" id "lower-cut-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "lower-cut-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "lower-cut-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "lower-cut-outline"
      set "width" to 0.15
    use "Transform" id "lower-cut-placement"
      set "offset" to -0.19 0.17
      set "localScale" to 0.08 0.11
      set "rot" to -10
  row "lower-rings" called "Growth ring"
    use "Circle" id "lower-rings-shape-0"
      set "center" to 0 0
      set "radius" to 0.7
    use "Circle" id "lower-rings-shape-1"
      combine subtract
      set "center" to 0 0
      set "radius" to 0.42
    use "Color" id "lower-rings-color"
    use "Transform" id "lower-rings-placement"
      set "offset" to -0.19 0.17
      set "localScale" to 0.08 0.11
      set "rot" to -10
  row "upper-bark" called "Cut log bark"
    use "Rounded Rectangle" id "upper-bark-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.26 0.12
      set "radius" to 0.04
    use "Directional Gradient" id "upper-bark-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "upper-bark-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "upper-bark-outline"
      set "width" to 0.018
    use "Transform" id "upper-bark-placement"
      set "offset" to -0.015 -0.055
      set "localScale" to 1 1
      set "rot" to 12
  row "upper-cut" called "End grain"
    use "Circle" id "upper-cut-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "upper-cut-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "upper-cut-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "upper-cut-outline"
      set "width" to 0.15
    use "Transform" id "upper-cut-placement"
      set "offset" to -0.235 -0.055
      set "localScale" to 0.08 0.11
      set "rot" to 12
  row "upper-rings" called "Growth ring"
    use "Circle" id "upper-rings-shape-0"
      set "center" to 0 0
      set "radius" to 0.7
    use "Circle" id "upper-rings-shape-1"
      combine subtract
      set "center" to 0 0
      set "radius" to 0.42
    use "Color" id "upper-rings-color"
    use "Transform" id "upper-rings-placement"
      set "offset" to -0.235 -0.055
      set "localScale" to 0.08 0.11
      set "rot" to 12
  row "fresh-leaf" called "Fresh Leaf"
    use "Circle" id "fresh-leaf-shape-0"
      set "center" to -0.23 0
      set "radius" to 0.7
    use "Circle" id "fresh-leaf-shape-1"
      combine intersect
      set "center" to 0.23 0
      set "radius" to 0.7
    use "Directional Gradient" id "fresh-leaf-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "fresh-leaf-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "fresh-leaf-outline"
      set "width" to 0.04
    use "Transform" id "fresh-leaf-placement"
      set "offset" to 0.2 -0.21
      set "localScale" to 0.24 0.12
      set "rot" to -35
  row "composite-1" called "Lower Cut over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "lower-bark" xyz
      set "foreground" from row "lower-cut" xyzw
  row "composite-2" called "Lower Rings over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "lower-rings" xyzw
  row "composite-3" called "Upper Bark over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "upper-bark" xyzw
  row "composite-4" called "Upper Cut over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "upper-cut" xyzw
  row "composite-5" called "Upper Rings over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "upper-rings" xyzw
  row "composite-6" called "Fresh Leaf over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "fresh-leaf" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
