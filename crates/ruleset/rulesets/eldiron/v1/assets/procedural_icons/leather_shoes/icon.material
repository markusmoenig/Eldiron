# 32px inventory icon. Stock MZ shape and material rows; all colors are palette indices.
# Authored leather: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Leather Shoes Icon"
  mode pbr
  tiling raw
  default roughness to 0.78
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "sole-color" called "Sole"
    use "Color" id "sole-color"
  row "stitch" called "Stitch"
    use "Color" id "stitch"
  row "panels-mask" called "Toe panel and shaft seams shape"
    use "Rounded Rectangle" id "front-panel-left"
      set "center" to -0.33 -0.02
      set "halfSize" to 0.01 0.32
      set "radius" to 0
    use "Rounded Rectangle" id "front-panel-right"
      combine union
      set "center" to -0.17 -0.02
      set "halfSize" to 0.01 0.32
      set "radius" to 0
    use "Rounded Rectangle" id "heel-seam"
      combine union
      set "center" to 0.25 0
      set "halfSize" to 0.0125 0.45
      set "radius" to 0
  row "panels" called "Toe panel and shaft seams"
    use "Mix" id "panels-mix"
      input from row "panels-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "sole-mask" called "Dark sole and top cuff shape"
    use "Rounded Rectangle" id "sole-band"
      set "center" to 0 0.44
      set "halfSize" to 0.5 0.06
      set "radius" to 0
    use "Rounded Rectangle" id "boot-cuff"
      combine union
      set "center" to 0 -0.465
      set "halfSize" to 0.5 0.035
      set "radius" to 0
  row "sole" called "Dark sole and top cuff"
    use "Mix" id "sole-mix"
      input from row "sole-mask" www
      set "color1" from row "panels" xyzw
      set "color2" from row "sole-color" xyzw
      set "factor" to 1 1 1
  row "laces-mask" called "Four leather laces shape"
    use "Rounded Rectangle" id "lace-0"
      set "center" to -0.25 -0.25
      set "halfSize" to 0.075 0.008
      set "radius" to 0
    use "Rounded Rectangle" id "lace-1"
      combine union
      set "center" to -0.25 -0.14
      set "halfSize" to 0.075 0.008
      set "radius" to 0
    use "Rounded Rectangle" id "lace-2"
      combine union
      set "center" to -0.25 -0.03
      set "halfSize" to 0.075 0.008
      set "radius" to 0
    use "Rounded Rectangle" id "lace-3"
      combine union
      set "center" to -0.25 0.08
      set "halfSize" to 0.075 0.008
      set "radius" to 0
  row "laces" called "Four leather laces"
    use "Mix" id "laces-mix"
      input from row "laces-mask" www
      set "color1" from row "sole" xyzw
      set "color2" from row "stitch" xyzw
      set "factor" to 1 1 1
  row "icon-shape" called "Garment silhouette"
    use "Rounded Rectangle" id "icon-shaft-0"
      set "center" to -0.18 -0.1
      set "halfSize" to 0.095 0.24
      set "radius" to 0.03
    use "Rounded Rectangle" id "icon-toe-0"
      combine union
      set "center" to -0.13999999999999999 0.21
      set "halfSize" to 0.135 0.1
      set "radius" to 0.06
    use "Rounded Rectangle" id "icon-shaft-1"
      combine union
      set "center" to 0.17 -0.1
      set "halfSize" to 0.095 0.24
      set "radius" to 0.03
    use "Rounded Rectangle" id "icon-toe-1"
      combine union
      set "center" to 0.21000000000000002 0.21
      set "halfSize" to 0.135 0.1
      set "radius" to 0.06
  row "icon-front" called "Front fabric mapping"
    use "Transform" id "icon-front-map"
      input from row "laces" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-soles-mask" called "Dark soles shape"
    use "Rounded Rectangle" id "sole-0"
      set "center" to -0.15 0.27
      set "halfSize" to 0.11 0.022
      set "radius" to 0
    use "Rounded Rectangle" id "sole-1"
      combine union
      set "center" to 0.2 0.27
      set "halfSize" to 0.11 0.022
      set "radius" to 0
  row "icon-soles-color" called "Dark soles palette color"
    use "Color" id "icon-soles-color"
  row "icon-soles" called "Dark soles"
    use "Mix" id "icon-soles-mix"
      input from row "icon-soles-mask" www
      set "color1" from row "icon-front" xyzw
      set "color2" from row "icon-soles-color" xyzw
      set "factor" to 1 1 1
  row "icon-laces-mask" called "Leather laces shape"
    use "Rounded Rectangle" id "lace-0-0"
      set "center" to -0.18 -0.23
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-0-1"
      combine union
      set "center" to -0.18 -0.12
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-0-2"
      combine union
      set "center" to -0.18 -0.01
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-0-3"
      combine union
      set "center" to -0.18 0.1
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-1-0"
      combine union
      set "center" to 0.17 -0.23
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-1-1"
      combine union
      set "center" to 0.17 -0.12
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-1-2"
      combine union
      set "center" to 0.17 -0.01
      set "halfSize" to 0.06 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "lace-1-3"
      combine union
      set "center" to 0.17 0.1
      set "halfSize" to 0.06 0.012
      set "radius" to 0
  row "icon-laces-color" called "Leather laces palette color"
    use "Color" id "icon-laces-color"
  row "icon-laces" called "Leather laces"
    use "Mix" id "icon-laces-mix"
      input from row "icon-laces-mask" www
      set "color1" from row "icon-soles" xyzw
      set "color2" from row "icon-laces-color" xyzw
      set "factor" to 1 1 1
  row "icon-edge-mask" called "One pixel inside outline"
    use "Compare/Select" id "icon-edge-mask"
      input from row "icon-shape" distance
      set "comparison" to 2
      set "reference" to -0.023 -0.023 -0.023
  row "icon-edge-color" called "Outline palette color"
    use "Color" id "icon-outline"
  row "icon-cutout" called "Outlined fabric"
    use "Mix" id "icon-fabric-outline"
      input from row "icon-edge-mask" xxx
      set "color1" from row "icon-laces" xyzw
      set "color2" from row "icon-edge-color" xyzw
      set "factor" to 1 1 1
  row "icon-alpha" called "Crisp pixel silhouette"
    use "Compare/Select" id "icon-alpha"
      input from row "icon-shape" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-cutout" xyz
  output opacity from row "icon-alpha" x
