project 1
result from material "icon"
material "icon" called "Hunting Cloak"
  mode pbr
  tiling raw
  default roughness to 0.9
  default opacity to 0
  row "wool" called "Gathered wool drape"
    use "Polygon" id "cloak-shape"
      set "center" to 0 0
      set "radius" to 0.39
      set "sides" to 3
      set "rotation" to -90
    use "Rounded Rectangle" id "cloak-collar"
      combine union
      set "center" to 0 -0.17
      set "halfSize" to 0.15 0.082
      set "radius" to 0.07
    use "Directional Gradient" id "cloak-light"
      set "angle" to 0
      set "scale" to 1.45
      set "offset" to 0.5
    use "Color Ramp" id "cloak-colors"
      set "position0" to 0
      set "color0" to 0.022 0.041 0.021 1
      set "position1" to 0.34
      set "color1" to 0.039 0.073 0.033 1
      set "position2" to 0.62
      set "color2" to 0.095 0.142 0.054 1
      set "position3" to 1
      set "color3" to 0.131 0.182 0.068 1
    use "Border" id "cloak-outline"
      set "width" to 0.028
      set "color" to 0.021 0.025 0.015 1
  row "pin" called "Bronze clasp"
    use "Circle" id "pin-shape"
      set "center" to 0 -0.132
      set "radius" to 0.054
    use "Color" id "pin-color"
      set "color" to 0.42 0.24 0.064 1
    use "Border" id "pin-outline"
      set "width" to 0.012
      set "color" to 0.075 0.051 0.022 1
  row "composite" called "Pinned cloak"
    use "Alpha Over" id "icon-composite"
      input from row "wool" xyz
      set "foreground" from row "pin" xyzw
  row "opacity" called "Crisp silhouette"
    use "Compare/Select" id "cloak-opacity"
      input from row "composite" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite" xyz
  output opacity from row "opacity" x
