# 32px inventory icon. Stock MZ shape and material rows; all colors are palette indices.
# Authored trousers: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Wool Trousers Icon"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "seams-mask" called "Inseam and outside leg seams shape"
    use "Rounded Rectangle" id "inseam"
      set "center" to -0.5 0
      set "halfSize" to 0.01 0.5
      set "radius" to 0
    use "Rounded Rectangle" id "outseam"
      combine union
      set "center" to 0 0
      set "halfSize" to 0.01 0.5
      set "radius" to 0
  row "seams" called "Inseam and outside leg seams"
    use "Mix" id "seams-mix"
      input from row "seams-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "icon-shape" called "Garment silhouette"
    use "Rounded Rectangle" id "icon-waist"
      set "center" to 0 -0.29
      set "halfSize" to 0.255 0.065
      set "radius" to 0.02
    use "Rounded Rectangle" id "icon-left-leg"
      combine union
      set "center" to -0.14 0.035
      set "halfSize" to 0.105 0.305
      set "radius" to 0.02
    use "Rounded Rectangle" id "icon-right-leg"
      combine union
      set "center" to 0.14 0.035
      set "halfSize" to 0.105 0.305
      set "radius" to 0.02
  row "icon-front" called "Front fabric mapping"
    use "Transform" id "icon-front-map"
      input from row "seams" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-leg-seams-mask" called "Leg seams shape"
    use "Rounded Rectangle" id "leg-seam-0"
      set "center" to -0.18 0.04
      set "halfSize" to 0.016 0.27
      set "radius" to 0
    use "Rounded Rectangle" id "leg-seam-1"
      combine union
      set "center" to 0.18 0.04
      set "halfSize" to 0.016 0.27
      set "radius" to 0
  row "icon-leg-seams-color" called "Leg seams palette color"
    use "Color" id "icon-leg-seams-color"
  row "icon-leg-seams" called "Leg seams"
    use "Mix" id "icon-leg-seams-mix"
      input from row "icon-leg-seams-mask" www
      set "color1" from row "icon-front" xyzw
      set "color2" from row "icon-leg-seams-color" xyzw
      set "factor" to 1 1 1
  row "icon-belt-mask" called "Leather belt shape"
    use "Rounded Rectangle" id "belt"
      set "center" to 0 -0.285
      set "halfSize" to 0.235 0.033
      set "radius" to 0
  row "icon-belt-color" called "Leather belt palette color"
    use "Color" id "icon-belt-color"
  row "icon-belt" called "Leather belt"
    use "Mix" id "icon-belt-mix"
      input from row "icon-belt-mask" www
      set "color1" from row "icon-leg-seams" xyzw
      set "color2" from row "icon-belt-color" xyzw
      set "factor" to 1 1 1
  row "icon-buckle-mask" called "Brass buckle shape"
    use "Rounded Rectangle" id "buckle"
      set "center" to 0 -0.285
      set "halfSize" to 0.035 0.035
      set "radius" to 0
  row "icon-buckle-color" called "Brass buckle palette color"
    use "Color" id "icon-buckle-color"
  row "icon-buckle" called "Brass buckle"
    use "Mix" id "icon-buckle-mix"
      input from row "icon-buckle-mask" www
      set "color1" from row "icon-belt" xyzw
      set "color2" from row "icon-buckle-color" xyzw
      set "factor" to 1 1 1
  row "icon-edge-mask" called "One pixel inside outline"
    use "Compare/Select" id "icon-edge-mask"
      input from row "icon-shape" distance
      set "comparison" to 2
      set "reference" to -0.023 -0.023 -0.023
  row "icon-edge-color" called "Outline palette color"
    use "Color" id "icon-outline"
  row "icon-cutout" called "Outlined fabric"
    use "Mix" id "icon-fabric-outline"
      input from row "icon-edge-mask" xxx
      set "color1" from row "icon-buckle" xyzw
      set "color2" from row "icon-edge-color" xyzw
      set "factor" to 1 1 1
  row "icon-alpha" called "Crisp pixel silhouette"
    use "Compare/Select" id "icon-alpha"
      input from row "icon-shape" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-cutout" xyz
  output opacity from row "icon-alpha" x
