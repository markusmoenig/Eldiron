project 1
result from material "icon"
material "icon" called "Talk - Speech Bubble"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "tail" called "Speech tail"
    use "Rounded Rectangle" id "tail-shape"
      set "center" to 0 0
      set "halfSize" to 0.10 0.11
      set "radius" to 0.025
    use "Color" id "tail-color"
    use "Border" id "tail-outline"
      set "width" to 0.024
    use "Transform" id "tail-placement"
      set "offset" to -0.17 0.18
      set "rot" to 38
  row "bubble" called "Ivory speech bubble"
    use "Rounded Rectangle" id "bubble-shape"
      set "center" to 0 -0.055
      set "halfSize" to 0.39 0.255
      set "radius" to 0.145
    use "Directional Gradient" id "bubble-gradient"
      set "angle" to 220
      set "scale" to 1.2
      set "offset" to 0.5
    use "Color Ramp" id "bubble-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "bubble-outline"
      set "width" to 0.024
  row "dots" called "Three speech marks"
    use "Circle" id "left-dot"
      set "center" to -0.18 -0.055
      set "radius" to 0.042
    use "Circle" id "middle-dot"
      combine union
      set "center" to 0 -0.055
      set "radius" to 0.042
    use "Circle" id "right-dot"
      combine union
      set "center" to 0.18 -0.055
      set "radius" to 0.042
    use "Color" id "dot-color"
  row "silhouette" called "Bubble over the tail"
    use "Alpha Over" id "silhouette"
      input from row "tail" xyz
      set "foreground" from row "bubble" xyzw
  row "finished" called "Speech marks over the bubble"
    use "Alpha Over" id "finished"
      input from row "silhouette" xyz
      set "foreground" from row "dots" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "finished" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "finished" xyz
  output opacity from row "pixel-alpha" x
