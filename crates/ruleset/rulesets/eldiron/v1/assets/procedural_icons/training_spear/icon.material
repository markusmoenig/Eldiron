# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Training Spear"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "haft" called "Long wooden shaft"
    use "Rounded Rectangle" id "haft-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0275 0.3325
      set "radius" to 0.0183333
    use "Directional Gradient" id "haft-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "haft-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "haft-outline"
      set "width" to 0.012
    use "Transform" id "haft-placement"
      set "offset" to 0 0.0725
      set "localScale" to 1 1
      set "rot" to 180
  row "head" called "Leaf steel point"
    use "Polygon" id "head-shape-0"
      set "center" to 0 -0.22
      set "radius" to 0.205
      set "sides" to 3
      set "rotation" to -90
    use "Rounded Rectangle" id "head-shape-1"
      combine intersect
      set "center" to 0 -0.26
      set "halfSize" to 0.09 0.19
      set "radius" to 0
    use "Directional Gradient" id "head-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "head-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "head-outline"
      set "width" to 0.018
  row "ridge" called "Point ridge"
    use "Rounded Rectangle" id "ridge-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.011 0.1225
      set "radius" to 0.00733333
    use "Color" id "ridge-color"
    use "Transform" id "ridge-placement"
      set "offset" to 0 -0.2725
      set "localScale" to 1 1
      set "rot" to 0
  row "socket" called "Bound point socket"
    use "Rounded Rectangle" id "socket-shape-0"
      set "center" to 0 -0.075
      set "halfSize" to 0.05 0.065
      set "radius" to 0.012
    use "Directional Gradient" id "socket-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "socket-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "socket-outline"
      set "width" to 0.018
  row "composite-1" called "Head over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "haft" xyz
      set "foreground" from row "head" xyzw
  row "composite-2" called "Ridge over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "ridge" xyzw
  row "composite-3" called "Socket over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "socket" xyzw
  row "icon-pose" called "Inventory pose"
    use "Transform" id "icon-pose"
      input from row "composite-3" xyz
      set "rot" to 35
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "icon-pose" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-pose" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "head" w mapped 0 to 0.85
  output roughness from row "head" w mapped 0.8 to 0.35
