# 32px inventory icon. Stock MZ shape and material rows; all colors are palette indices.
# Authored clothing construction. All colors use the companion project palette indices.
project 1
result from material "surface"
material "surface" called "Padded Armor Icon"
  mode pbr
  tiling raw
  default roughness to 0.95
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Dyed quilted cloth"
    use "Color" id "base"
  row "shade" called "Recessed quilt stitching"
    use "Color" id "shade"
  row "trim" called "Leather binding"
    use "Color" id "trim"
  row "button" called "Brass fastenings"
    use "Color" id "button"
  row "diagonal-a" called "Diagonal stitched channels"
    use "Directional Gradient" id "diagonal-a-direction"
      input from row "base" xyz
      set "angle" to 45
      set "scale" to 1.41421356
      set "offset" to 0
    use "Periodic Profile" id "diagonal-a-stitch"
      set "profile" to 3
      set "frequency" to 6
      set "width" to 0.1
      set "antialias" to 1
  row "diagonal-b" called "Diagonal stitched channels"
    use "Directional Gradient" id "diagonal-b-direction"
      input from row "base" xyz
      set "angle" to 135
      set "scale" to 1.41421356
      set "offset" to 0
    use "Periodic Profile" id "diagonal-b-stitch"
      set "profile" to 3
      set "frequency" to 6
      set "width" to 0.1
      set "antialias" to 1
  row "quilt-mask" called "Crossed diamond stitching"
    use "Max" id "quilt-max"
      input from row "diagonal-a" xxx
      set "globalValue" to 1
      set "localValue" from row "diagonal-b" xxx
  row "quilt" called "Quilted diamond panels"
    use "Mix" id "quilt-mix"
      input from row "quilt-mask" xxx
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "edging-mask" called "Bound neckline and hems"
    use "Circle" id "edging-mask-0"
      set "center" to -0.25 -0.5
      set "radius" to 0.11
    use "Circle" id "edging-mask-1"
      combine subtract
      set "center" to -0.25 -0.5
      set "radius" to 0.078
    use "Circle" id "edging-mask-2"
      combine union
      set "center" to 0.25 -0.5
      set "radius" to 0.085
    use "Circle" id "edging-mask-3"
      combine subtract
      set "center" to 0.25 -0.5
      set "radius" to 0.06
    use "Rounded Rectangle" id "edging-mask-4"
      combine union
      set "center" to 0 0.45
      set "halfSize" to 0.5 0.022
      set "radius" to 0
  row "edging" called "Bound neckline and hems"
    use "Mix" id "edging-mix"
      input from row "edging-mask" www
      set "color1" from row "quilt" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "closure-mask" called "Front closure binding"
    use "Rounded Rectangle" id "closure-mask-0"
      set "center" to -0.25 -0.04
      set "halfSize" to 0.017 0.35
      set "radius" to 0.004
  row "closure" called "Front closure binding"
    use "Mix" id "closure-mix"
      input from row "closure-mask" www
      set "color1" from row "edging" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "stud-mask" called "Brass toggles"
    use "Rounded Rectangle" id "stud-mask-0"
      set "center" to -0.25 -0.25
      set "halfSize" to 0.035 0.012
      set "radius" to 0.008
    use "Rounded Rectangle" id "stud-mask-1"
      combine union
      set "center" to -0.25 -0.08
      set "halfSize" to 0.035 0.012
      set "radius" to 0.008
    use "Rounded Rectangle" id "stud-mask-2"
      combine union
      set "center" to -0.25 0.09
      set "halfSize" to 0.035 0.012
      set "radius" to 0.008
    use "Rounded Rectangle" id "stud-mask-3"
      combine union
      set "center" to -0.25 0.26
      set "halfSize" to 0.035 0.012
      set "radius" to 0.008
  row "studs" called "Brass toggles"
    use "Mix" id "studs-mix"
      input from row "stud-mask" www
      set "color1" from row "closure" xyzw
      set "color2" from row "button" xyzw
      set "factor" to 1 1 1
  row "icon-shape" called "Garment silhouette"
    use "Rounded Rectangle" id "icon-body"
      set "center" to 0 0.035
      set "halfSize" to 0.218 0.305
      set "radius" to 0.02
    use "Rounded Rectangle" id "icon-shoulders"
      combine union
      set "center" to 0 -0.21
      set "halfSize" to 0.37 0.105
      set "radius" to 0.025
    use "Circle" id "icon-neck"
      combine subtract
      set "center" to 0 -0.335
      set "radius" to 0.084
  row "icon-front" called "Front fabric mapping"
    use "Transform" id "icon-front-map"
      input from row "studs" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-edge-mask" called "One pixel inside outline"
    use "Compare/Select" id "icon-edge-mask"
      input from row "icon-shape" distance
      set "comparison" to 2
      set "reference" to -0.023 -0.023 -0.023
  row "icon-edge-color" called "Outline palette color"
    use "Color" id "icon-outline"
  row "icon-cutout" called "Outlined fabric"
    use "Mix" id "icon-fabric-outline"
      input from row "icon-edge-mask" xxx
      set "color1" from row "icon-front" xyzw
      set "color2" from row "icon-edge-color" xyzw
      set "factor" to 1 1 1
  row "icon-alpha" called "Crisp pixel silhouette"
    use "Compare/Select" id "icon-alpha"
      input from row "icon-shape" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-cutout" xyz
  output opacity from row "icon-alpha" x
