# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Novice Mace"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "haft" called "Ash haft"
    use "Rounded Rectangle" id "haft-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.03125 0.27
      set "radius" to 0.0208333
    use "Directional Gradient" id "haft-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "haft-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "haft-outline"
      set "width" to 0.012
    use "Transform" id "haft-placement"
      set "offset" to 0 0.08
      set "localScale" to 1 1
      set "rot" to 180
  row "grip" called "Leather grip"
    use "Rounded Rectangle" id "grip-shape-0"
      set "center" to 0 0.22
      set "halfSize" to 0.043 0.11
      set "radius" to 0.016
    use "Directional Gradient" id "grip-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "grip-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "grip-outline"
      set "width" to 0.018
  row "flanges" called "Flanged iron head"
    use "Rounded Rectangle" id "flanges-shape-0"
      set "center" to 0 -0.2
      set "halfSize" to 0.12 0.14
      set "radius" to 0.025
    use "Polygon" id "flanges-shape-1"
      combine union
      set "center" to 0 -0.22
      set "radius" to 0.175
      set "sides" to 4
      set "rotation" to 0
    use "Directional Gradient" id "flanges-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "flanges-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "flanges-outline"
      set "width" to 0.018
  row "ridge" called "Central steel rib"
    use "Rounded Rectangle" id "ridge-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.02 0.125
      set "radius" to 0.0133333
    use "Color" id "ridge-color"
    use "Transform" id "ridge-placement"
      set "offset" to 0 -0.205
      set "localScale" to 1 1
      set "rot" to 0
  row "pommel" called "Iron pommel"
    use "Circle" id "pommel-shape-0"
      set "center" to 0 0.35
      set "radius" to 0.048
    use "Directional Gradient" id "pommel-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "pommel-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "pommel-outline"
      set "width" to 0.018
  row "composite-1" called "Grip over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "haft" xyz
      set "foreground" from row "grip" xyzw
  row "composite-2" called "Flanges over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "flanges" xyzw
  row "composite-3" called "Ridge over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "ridge" xyzw
  row "composite-4" called "Pommel over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "pommel" xyzw
  row "icon-pose" called "Inventory pose"
    use "Transform" id "icon-pose"
      input from row "composite-4" xyz
      set "rot" to 32
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "icon-pose" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-pose" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "flanges" w mapped 0 to 0.85
  output roughness from row "flanges" w mapped 0.8 to 0.35
