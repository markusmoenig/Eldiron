# 32px inventory icon. Stock MZ shape and material rows; all colors are palette indices.
# Authored tunic: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Linen Shirt Icon"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "trim" called "Woven edging"
    use "Color" id "trim"
  row "button" called "Fastenings"
    use "Color" id "button"
  row "seams-mask" called "Side seams shape"
    use "Rounded Rectangle" id "right-seam"
      set "center" to -0.5 0
      set "halfSize" to 0.009 0.5
      set "radius" to 0
    use "Rounded Rectangle" id "left-seam"
      combine union
      set "center" to 0 0
      set "halfSize" to 0.009 0.5
      set "radius" to 0
  row "seams" called "Side seams"
    use "Mix" id "seams-mix"
      input from row "seams-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "edging-mask" called "Neckline, placket and bottom hem shape"
    use "Circle" id "front-collar"
      set "center" to -0.25 -0.5
      set "radius" to 0.11
    use "Circle" id "front-neck-opening"
      combine subtract
      set "center" to -0.25 -0.5
      set "radius" to 0.078
    use "Circle" id "back-collar"
      combine union
      set "center" to 0.25 -0.5
      set "radius" to 0.085
    use "Circle" id "back-neck-opening"
      combine subtract
      set "center" to 0.25 -0.5
      set "radius" to 0.06
    use "Rounded Rectangle" id "front-placket"
      combine union
      set "center" to -0.25 -0.305
      set "halfSize" to 0.0125 0.11
      set "radius" to 0.005
    use "Rounded Rectangle" id "bottom-hem"
      combine union
      set "center" to 0 0.45
      set "halfSize" to 0.5 0.0175
      set "radius" to 0
  row "edging" called "Neckline, placket and bottom hem"
    use "Mix" id "edging-mix"
      input from row "edging-mask" www
      set "color1" from row "seams" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "buttons-mask" called "Three brass buttons shape"
    use "Circle" id "button-0"
      set "center" to -0.25 -0.35
      set "radius" to 0.012
    use "Circle" id "button-1"
      combine union
      set "center" to -0.25 -0.28
      set "radius" to 0.012
    use "Circle" id "button-2"
      combine union
      set "center" to -0.25 -0.21
      set "radius" to 0.012
  row "buttons" called "Three brass buttons"
    use "Mix" id "buttons-mix"
      input from row "buttons-mask" www
      set "color1" from row "edging" xyzw
      set "color2" from row "button" xyzw
      set "factor" to 1 1 1
  row "icon-shape" called "Garment silhouette"
    use "Rounded Rectangle" id "icon-body"
      set "center" to 0 0.035
      set "halfSize" to 0.218 0.305
      set "radius" to 0.02
    use "Rounded Rectangle" id "icon-shoulders"
      combine union
      set "center" to 0 -0.21
      set "halfSize" to 0.37 0.105
      set "radius" to 0.025
    use "Circle" id "icon-neck"
      combine subtract
      set "center" to 0 -0.335
      set "radius" to 0.084
  row "icon-front" called "Front fabric mapping"
    use "Transform" id "icon-front-map"
      input from row "buttons" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-placket-mask" called "Stitched placket shape"
    use "Rounded Rectangle" id "placket"
      set "center" to 0 -0.14
      set "halfSize" to 0.018 0.115
      set "radius" to 0
  row "icon-placket-color" called "Stitched placket palette color"
    use "Color" id "icon-placket-color"
  row "icon-placket" called "Stitched placket"
    use "Mix" id "icon-placket-mix"
      input from row "icon-placket-mask" www
      set "color1" from row "icon-front" xyzw
      set "color2" from row "icon-placket-color" xyzw
      set "factor" to 1 1 1
  row "icon-buttons-mask" called "Three wooden buttons shape"
    use "Rounded Rectangle" id "icon-fastener-0"
      set "center" to 0 -0.22
      set "halfSize" to 0.018 0.018
      set "radius" to 0
    use "Rounded Rectangle" id "icon-fastener-1"
      combine union
      set "center" to 0 -0.13
      set "halfSize" to 0.018 0.018
      set "radius" to 0
    use "Rounded Rectangle" id "icon-fastener-2"
      combine union
      set "center" to 0 -0.04
      set "halfSize" to 0.018 0.018
      set "radius" to 0
  row "icon-buttons-color" called "Three wooden buttons palette color"
    use "Color" id "icon-buttons-color"
  row "icon-buttons" called "Three wooden buttons"
    use "Mix" id "icon-buttons-mix"
      input from row "icon-buttons-mask" www
      set "color1" from row "icon-placket" xyzw
      set "color2" from row "icon-buttons-color" xyzw
      set "factor" to 1 1 1
  row "icon-hem-mask" called "Folded hem shape"
    use "Rounded Rectangle" id "hem"
      set "center" to 0 0.3
      set "halfSize" to 0.2 0.018
      set "radius" to 0
  row "icon-hem-color" called "Folded hem palette color"
    use "Color" id "icon-hem-color"
  row "icon-hem" called "Folded hem"
    use "Mix" id "icon-hem-mix"
      input from row "icon-hem-mask" www
      set "color1" from row "icon-buttons" xyzw
      set "color2" from row "icon-hem-color" xyzw
      set "factor" to 1 1 1
  row "icon-edge-mask" called "One pixel inside outline"
    use "Compare/Select" id "icon-edge-mask"
      input from row "icon-shape" distance
      set "comparison" to 2
      set "reference" to -0.023 -0.023 -0.023
  row "icon-edge-color" called "Outline palette color"
    use "Color" id "icon-outline"
  row "icon-cutout" called "Outlined fabric"
    use "Mix" id "icon-fabric-outline"
      input from row "icon-edge-mask" xxx
      set "color1" from row "icon-hem" xyzw
      set "color2" from row "icon-edge-color" xyzw
      set "factor" to 1 1 1
  row "icon-alpha" called "Crisp pixel silhouette"
    use "Compare/Select" id "icon-alpha"
      input from row "icon-shape" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-cutout" xyz
  output opacity from row "icon-alpha" x
