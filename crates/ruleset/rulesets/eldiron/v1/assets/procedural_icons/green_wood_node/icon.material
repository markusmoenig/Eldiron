# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Green Wood Node"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "roots" called "Roots and soil"
    use "Circle" id "roots-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "roots-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "roots-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "roots-outline"
      set "width" to 0.06
    use "Transform" id "roots-placement"
      set "offset" to 0 0.32
      set "localScale" to 0.3 0.075
      set "rot" to 0
  row "trunk" called "Young trunk"
    use "Rounded Rectangle" id "trunk-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.05 0.25045
      set "radius" to 0.0333333
    use "Directional Gradient" id "trunk-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "trunk-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "trunk-outline"
      set "width" to 0.012
    use "Transform" id "trunk-placement"
      set "offset" to -0.015 0.05
      set "localScale" to 1 1
      set "rot" to 176.566
  row "branch" called "Side branch"
    use "Rounded Rectangle" id "branch-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.024 0.127475
      set "radius" to 0.016
    use "Color" id "branch-color"
    use "Border" id "branch-outline"
      set "width" to 0.012
    use "Transform" id "branch-placement"
      set "offset" to 0.085 -0.035
      set "localScale" to 1 1
      set "rot" to -131.82
  row "crown-left" called "Left foliage"
    use "Circle" id "crown-left-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "crown-left-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "crown-left-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "crown-left-outline"
      set "width" to 0.09
    use "Transform" id "crown-left-placement"
      set "offset" to -0.14 -0.14
      set "localScale" to 0.2 0.2
      set "rot" to 0
  row "crown-right" called "Right foliage"
    use "Circle" id "crown-right-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "crown-right-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "crown-right-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "crown-right-outline"
      set "width" to 0.09
    use "Transform" id "crown-right-placement"
      set "offset" to 0.14 -0.18
      set "localScale" to 0.2 0.18
      set "rot" to 0
  row "crown-top" called "Top foliage"
    use "Circle" id "crown-top-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "crown-top-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "crown-top-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "crown-top-outline"
      set "width" to 0.0818182
    use "Transform" id "crown-top-placement"
      set "offset" to -0.035 -0.29
      set "localScale" to 0.22 0.15
      set "rot" to 0
  row "composite-1" called "Trunk over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "roots" xyz
      set "foreground" from row "trunk" xyzw
  row "composite-2" called "Branch over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "branch" xyzw
  row "composite-3" called "Crown Left over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "crown-left" xyzw
  row "composite-4" called "Crown Right over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "crown-right" xyzw
  row "composite-5" called "Crown Top over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "crown-top" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-5" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-5" xyz
  output opacity from row "pixel-alpha" x
