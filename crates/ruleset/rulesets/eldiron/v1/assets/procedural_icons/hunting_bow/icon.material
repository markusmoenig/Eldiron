# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Hunting Bow"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "limbs" called "Curved yew limbs"
    use "Circle" id "limbs-shape-0"
      set "center" to 0 0
      set "radius" to 0.37
    use "Circle" id "limbs-shape-1"
      combine subtract
      set "center" to 0.095 -0.01
      set "radius" to 0.335
    use "Directional Gradient" id "limbs-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "limbs-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "limbs-outline"
      set "width" to 0.018
    use "Transform" id "limbs-placement"
      set "offset" to -0.02 0
      set "localScale" to 0.9 1.1
      set "rot" to 0
  row "string" called "Linen bowstring"
    use "Rounded Rectangle" id "string-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.011 0.395
      set "radius" to 0.00733333
    use "Color" id "string-color"
    use "Transform" id "string-placement"
      set "offset" to -0.005 0
      set "localScale" to 1 1
      set "rot" to -0
  row "grip" called "Wrapped leather grip"
    use "Rounded Rectangle" id "grip-shape-0"
      set "center" to -0.295 0.01
      set "halfSize" to 0.045 0.083
      set "radius" to 0.025
    use "Directional Gradient" id "grip-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "grip-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "grip-outline"
      set "width" to 0.018
  row "arrow" called "Nocked arrow"
    use "Rounded Rectangle" id "arrow-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.014 0.3275
      set "radius" to 0.00933333
    use "Color" id "arrow-color"
    use "Transform" id "arrow-placement"
      set "offset" to 0.0275 0.015
      set "localScale" to 1 1
      set "rot" to -90
  row "point" called "Arrowhead"
    use "Polygon" id "point-shape-0"
      set "center" to 0.355 0.015
      set "radius" to 0.065
      set "sides" to 3
      set "rotation" to 0
    use "Directional Gradient" id "point-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "point-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "point-outline"
      set "width" to 0.018
  row "fletching" called "Feather flights"
    use "Rounded Rectangle" id "fletching-shape-0"
      set "center" to -0.21 -0.018
      set "halfSize" to 0.06 0.014
      set "radius" to 0.01
    use "Rounded Rectangle" id "fletching-shape-1"
      combine union
      set "center" to -0.21 0.048
      set "halfSize" to 0.06 0.014
      set "radius" to 0.01
    use "Color" id "fletching-color"
  row "composite-1" called "String over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "limbs" xyz
      set "foreground" from row "string" xyzw
  row "composite-2" called "Grip over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "grip" xyzw
  row "composite-3" called "Arrow over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "arrow" xyzw
  row "composite-4" called "Point over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "point" xyzw
  row "composite-5" called "Fletching over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "fletching" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-5" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-5" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "point" w mapped 0 to 0.85
  output roughness from row "point" w mapped 0.8 to 0.35
