# Native editable leatherworking icon; colors are project palette slots.
project 1
result from material "icon"
material "icon" called "Leather Workbench"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "part-0" called "leather workbench 1"
    use "Rounded Rectangle" id "part-0-shape"
      set "center" to 0 0
      set "halfSize" to 0.04 0.2
      set "radius" to 0.025
    use "Color" id "part-0-color"
    use "Transform" id "part-0-position"
      set "offset" to -0.23 0.15
      set "localScale" to 1 1
      set "rot" to 0
  row "part-1" called "leather workbench 2"
    use "Rounded Rectangle" id "part-1-shape"
      set "center" to 0 0
      set "halfSize" to 0.04 0.2
      set "radius" to 0.025
    use "Color" id "part-1-color"
    use "Transform" id "part-1-position"
      set "offset" to 0.23 0.15
      set "localScale" to 1 1
      set "rot" to 0
  row "part-2" called "leather workbench 3"
    use "Rounded Rectangle" id "part-2-shape"
      set "center" to 0 0
      set "halfSize" to 0.34 0.08
      set "radius" to 0.025
    use "Color" id "part-2-color"
    use "Transform" id "part-2-position"
      set "offset" to 0 -0.04
      set "localScale" to 1 1
      set "rot" to 0
  row "part-3" called "leather workbench 4"
    use "Rounded Rectangle" id "part-3-shape"
      set "center" to 0 0
      set "halfSize" to 0.17 0.055
      set "radius" to 0.025
    use "Color" id "part-3-color"
    use "Transform" id "part-3-position"
      set "offset" to 0.04 -0.15
      set "localScale" to 1 1
      set "rot" to 0
  row "part-4" called "leather workbench 5"
    use "Rounded Rectangle" id "part-4-shape"
      set "center" to 0 0
      set "halfSize" to 0.013 0.06
      set "radius" to 0.025
    use "Color" id "part-4-color"
    use "Transform" id "part-4-position"
      set "offset" to -0.19 -0.16
      set "localScale" to 1 1
      set "rot" to 30
  row "layer-1" called "Composite layer 1"
    use "Alpha Over" id "layer-1"
      input from row "part-0" xyz
      set "foreground" from row "part-1" xyzw
  row "layer-2" called "Composite layer 2"
    use "Alpha Over" id "layer-2"
      input from row "layer-1" xyz
      set "foreground" from row "part-2" xyzw
  row "layer-3" called "Composite layer 3"
    use "Alpha Over" id "layer-3"
      input from row "layer-2" xyz
      set "foreground" from row "part-3" xyzw
  row "layer-4" called "Composite layer 4"
    use "Alpha Over" id "layer-4"
      input from row "layer-3" xyz
      set "foreground" from row "part-4" xyzw
  row "pixel-alpha" called "Crisp silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "layer-4" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "layer-4" xyz
  output opacity from row "pixel-alpha" x
