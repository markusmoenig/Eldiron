# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Gold Coin"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "rim" called "Raised coin rim"
    use "Circle" id "rim-shape-0"
      set "center" to 0 0
      set "radius" to 0.34
    use "Directional Gradient" id "rim-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "rim-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "rim-outline"
      set "width" to 0.018
  row "face" called "Recessed coin face"
    use "Circle" id "face-shape-0"
      set "center" to 0 0
      set "radius" to 0.265
    use "Directional Gradient" id "face-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "face-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "face-outline"
      set "width" to 0.012
  row "stamp" called "Stamped denomination"
    use "Rounded Rectangle" id "stamp-shape-0"
      set "center" to 0 0.08
      set "halfSize" to 0.14 0.045
      set "radius" to 0.01
    use "Polygon" id "stamp-shape-1"
      combine union
      set "center" to -0.09 -0.01
      set "radius" to 0.075
      set "sides" to 3
      set "rotation" to -90
    use "Polygon" id "stamp-shape-2"
      combine union
      set "center" to 0 -0.035
      set "radius" to 0.09
      set "sides" to 3
      set "rotation" to -90
    use "Polygon" id "stamp-shape-3"
      combine union
      set "center" to 0.09 -0.01
      set "radius" to 0.075
      set "sides" to 3
      set "rotation" to -90
    use "Color" id "stamp-color"
    use "Border" id "stamp-outline"
      set "width" to 0.012
  row "composite-1" called "Face over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "rim" xyz
      set "foreground" from row "face" xyzw
  row "composite-2" called "Stamp over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "stamp" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-2" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-2" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "rim" w mapped 0 to 0.85
  output roughness from row "rim" w mapped 0.8 to 0.35
