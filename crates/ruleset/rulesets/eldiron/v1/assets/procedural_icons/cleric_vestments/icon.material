# 32px inventory icon. Stock MZ shape and material rows; all colors are palette indices.
# Authored clothing construction. All colors use the companion project palette indices.
project 1
result from material "surface"
material "surface" called "Cleric Vestments Icon"
  mode pbr
  tiling raw
  default roughness to 0.9
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Ivory vestment cloth"
    use "Color" id "base"
  row "shade" called "Panel seams"
    use "Color" id "shade"
  row "trim" called "Woven gold trim"
    use "Color" id "trim"
  row "stole" called "Blue woven stole"
    use "Color" id "stole"
  row "seam-mask" called "Garment seams"
    use "Rounded Rectangle" id "seam-mask-0"
      set "center" to 0 0
      set "halfSize" to 0.01 0.5
      set "radius" to 0
    use "Rounded Rectangle" id "seam-mask-1"
      combine union
      set "center" to -0.5 0
      set "halfSize" to 0.01 0.5
      set "radius" to 0
  row "seams" called "Garment seams"
    use "Mix" id "seams-mix"
      input from row "seam-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "edging-mask" called "Bound neckline and hems"
    use "Circle" id "edging-mask-0"
      set "center" to -0.25 -0.5
      set "radius" to 0.11
    use "Circle" id "edging-mask-1"
      combine subtract
      set "center" to -0.25 -0.5
      set "radius" to 0.078
    use "Circle" id "edging-mask-2"
      combine union
      set "center" to 0.25 -0.5
      set "radius" to 0.085
    use "Circle" id "edging-mask-3"
      combine subtract
      set "center" to 0.25 -0.5
      set "radius" to 0.06
    use "Rounded Rectangle" id "edging-mask-4"
      combine union
      set "center" to 0 0.45
      set "halfSize" to 0.5 0.022
      set "radius" to 0
  row "edging" called "Bound neckline and hems"
    use "Mix" id "edging-mix"
      input from row "edging-mask" www
      set "color1" from row "seams" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "stole-mask" called "Front and back stole panels"
    use "Rounded Rectangle" id "stole-mask-0"
      set "center" to -0.34 -0.04
      set "halfSize" to 0.04 0.43
      set "radius" to 0
    use "Rounded Rectangle" id "stole-mask-1"
      combine union
      set "center" to -0.16 -0.04
      set "halfSize" to 0.04 0.43
      set "radius" to 0
    use "Rounded Rectangle" id "stole-mask-2"
      combine union
      set "center" to 0.16 -0.04
      set "halfSize" to 0.04 0.43
      set "radius" to 0
    use "Rounded Rectangle" id "stole-mask-3"
      combine union
      set "center" to 0.34 -0.04
      set "halfSize" to 0.04 0.43
      set "radius" to 0
  row "stole-panels" called "Blue stole panels"
    use "Mix" id "stole-panels-mix"
      input from row "stole-mask" www
      set "color1" from row "edging" xyzw
      set "color2" from row "stole" xyzw
      set "factor" to 1 1 1
  row "cross-mask" called "Temple cross"
    use "Rounded Rectangle" id "cross-mask-0"
      set "center" to -0.25 -0.06
      set "halfSize" to 0.014 0.1
      set "radius" to 0.004
    use "Rounded Rectangle" id "cross-mask-1"
      combine union
      set "center" to -0.25 -0.08
      set "halfSize" to 0.06 0.014
      set "radius" to 0.004
  row "temple-cross" called "Woven temple cross"
    use "Mix" id "temple-cross-mix"
      input from row "cross-mask" www
      set "color1" from row "stole-panels" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "icon-shape" called "Garment silhouette"
    use "Rounded Rectangle" id "icon-body"
      set "center" to 0 0.07
      set "halfSize" to 0.218 0.35
      set "radius" to 0.02
    use "Rounded Rectangle" id "icon-shoulders"
      combine union
      set "center" to 0 -0.21
      set "halfSize" to 0.37 0.105
      set "radius" to 0.025
    use "Circle" id "icon-neck"
      combine subtract
      set "center" to 0 -0.335
      set "radius" to 0.084
  row "icon-front" called "Front fabric mapping"
    use "Transform" id "icon-front-map"
      input from row "temple-cross" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-edge-mask" called "One pixel inside outline"
    use "Compare/Select" id "icon-edge-mask"
      input from row "icon-shape" distance
      set "comparison" to 2
      set "reference" to -0.023 -0.023 -0.023
  row "icon-edge-color" called "Outline palette color"
    use "Color" id "icon-outline"
  row "icon-cutout" called "Outlined fabric"
    use "Mix" id "icon-fabric-outline"
      input from row "icon-edge-mask" xxx
      set "color1" from row "icon-front" xyzw
      set "color2" from row "icon-edge-color" xyzw
      set "factor" to 1 1 1
  row "icon-alpha" called "Crisp pixel silhouette"
    use "Compare/Select" id "icon-alpha"
      input from row "icon-shape" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "icon-cutout" xyz
  output opacity from row "icon-alpha" x
