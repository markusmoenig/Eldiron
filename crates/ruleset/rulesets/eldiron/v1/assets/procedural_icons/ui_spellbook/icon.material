# 32px navigation artwork. Editable stock MZ rows; colors bind to the project palette.
project 1
result from material "icon"
material "icon" called "Spellbook - Open Illuminated Book"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "binding" called "Leather book binding"
    use "Rounded Rectangle" id "binding-shape-0"
      set "center" to -0.18 0.02
      set "halfSize" to 0.2 0.3
      set "radius" to 0.035
    use "Rounded Rectangle" id "binding-shape-1"
      combine union
      set "center" to 0.18 0.02
      set "halfSize" to 0.2 0.3
      set "radius" to 0.035
    use "Directional Gradient" id "binding-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "binding-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "binding-outline"
      set "width" to 0.018
  row "left-page" called "Left parchment page"
    use "Rounded Rectangle" id "left-page-shape-0"
      set "center" to -0.175 -0.005
      set "halfSize" to 0.15 0.245
      set "radius" to 0.012
    use "Directional Gradient" id "left-page-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "left-page-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "left-page-outline"
      set "width" to 0.018
  row "right-page" called "Right parchment page"
    use "Rounded Rectangle" id "right-page-shape-0"
      set "center" to 0.175 -0.005
      set "halfSize" to 0.15 0.245
      set "radius" to 0.012
    use "Directional Gradient" id "right-page-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "right-page-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "right-page-outline"
      set "width" to 0.018
  row "spine" called "Central leather spine"
    use "Rounded Rectangle" id "spine-shape-0"
      set "center" to 0 0.01
      set "halfSize" to 0.026 0.29
      set "radius" to 0.012
    use "Directional Gradient" id "spine-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "spine-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "spine-outline"
      set "width" to 0.018
  row "writing" called "Lines of ink"
    use "Rounded Rectangle" id "writing-shape-0"
      set "center" to -0.175 -0.16
      set "halfSize" to 0.085 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "writing-shape-1"
      combine union
      set "center" to -0.175 -0.08
      set "halfSize" to 0.085 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "writing-shape-2"
      combine union
      set "center" to 0.175 -0.16
      set "halfSize" to 0.085 0.012
      set "radius" to 0
    use "Rounded Rectangle" id "writing-shape-3"
      combine union
      set "center" to 0.175 -0.08
      set "halfSize" to 0.085 0.012
      set "radius" to 0
    use "Color" id "writing-color"
  row "rune" called "Blue illuminated rune"
    use "Polygon" id "rune-shape-0"
      set "sides" to 4
      set "radius" to 0.10
      set "rotation" to 0
      set "center" to 0.175 0.09
    use "Directional Gradient" id "rune-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "rune-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
  row "bookmark" called "Red ribbon bookmark"
    use "Rounded Rectangle" id "bookmark-shape-0"
      set "center" to -0.18 0.29
      set "halfSize" to 0.035 0.075
      set "radius" to 0
    use "Directional Gradient" id "bookmark-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "bookmark-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "bookmark-outline"
      set "width" to 0.018
  row "composite-1" called "Left Page over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "binding" xyz
      set "foreground" from row "left-page" xyzw
  row "composite-2" called "Right Page over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "right-page" xyzw
  row "composite-3" called "Spine over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "spine" xyzw
  row "composite-4" called "Writing over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "writing" xyzw
  row "composite-5" called "Rune over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "rune" xyzw
  row "composite-6" called "Bookmark over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "bookmark" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
