# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Inventory - Leather Backpack"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "handle" called "Loop handle"
    use "Circle" id "handle-shape-0"
      set "center" to 0 -0.235
      set "radius" to 0.15
    use "Circle" id "handle-shape-1"
      combine subtract
      set "center" to 0 -0.235
      set "radius" to 0.09
    use "Directional Gradient" id "handle-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "handle-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "handle-outline"
      set "width" to 0.018
  row "body" called "Leather pouch body"
    use "Rounded Rectangle" id "body-shape-0"
      set "center" to 0 0.09
      set "halfSize" to 0.275 0.27
      set "radius" to 0.1
    use "Directional Gradient" id "body-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "body-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "body-outline"
      set "width" to 0.018
  row "panel" called "Inset front panel"
    use "Rounded Rectangle" id "panel-shape-0"
      set "center" to 0 0.13
      set "halfSize" to 0.21 0.18
      set "radius" to 0.06
    use "Directional Gradient" id "panel-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "panel-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "panel-outline"
      set "width" to 0.018
  row "flap" called "Folded pouch flap"
    use "Rounded Rectangle" id "flap-shape-0"
      set "center" to 0 -0.1
      set "halfSize" to 0.28 0.115
      set "radius" to 0.065
    use "Directional Gradient" id "flap-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "flap-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "flap-outline"
      set "width" to 0.018
  row "strap" called "Closing strap"
    use "Rounded Rectangle" id "strap-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0375 0.14
      set "radius" to 0.025
    use "Color" id "strap-color"
    use "Border" id "strap-outline"
      set "width" to 0.012
    use "Transform" id "strap-placement"
      set "offset" to 0 0.01
      set "localScale" to 1 1
      set "rot" to 0
  row "clasp" called "Brass clasp"
    use "Rounded Rectangle" id "clasp-shape-0"
      set "center" to 0 0.045
      set "halfSize" to 0.055 0.05
      set "radius" to 0.01
    use "Directional Gradient" id "clasp-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "clasp-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "clasp-outline"
      set "width" to 0.018
  row "stitches" called "Saddle stitching"
    use "Rounded Rectangle" id "stitches-shape-0"
      set "center" to -0.19 0.14
      set "halfSize" to 0.009 0.13
      set "radius" to 0
    use "Rounded Rectangle" id "stitches-shape-1"
      combine union
      set "center" to 0.19 0.14
      set "halfSize" to 0.009 0.13
      set "radius" to 0
    use "Color" id "stitches-color"
  row "composite-1" called "Body over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "handle" xyz
      set "foreground" from row "body" xyzw
  row "composite-2" called "Panel over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "panel" xyzw
  row "composite-3" called "Flap over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "flap" xyzw
  row "composite-4" called "Strap over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "strap" xyzw
  row "composite-5" called "Clasp over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "clasp" xyzw
  row "composite-6" called "Stitches over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "stitches" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "clasp" w mapped 0 to 0.85
  output roughness from row "clasp" w mapped 0.8 to 0.35
