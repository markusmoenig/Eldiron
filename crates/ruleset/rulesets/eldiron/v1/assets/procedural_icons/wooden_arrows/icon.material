# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Wooden Arrows"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "shaft-0" called "Arrow 1 shaft"
    use "Rounded Rectangle" id "shaft-0-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0175 0.316741
      set "radius" to 0.0116667
    use "Color" id "shaft-0-color"
    use "Border" id "shaft-0-outline"
      set "width" to 0.008
    use "Transform" id "shaft-0-placement"
      set "offset" to -0.165 0.05
      set "localScale" to 1 1
      set "rot" to -168.158
  row "point-0" called "Arrow 1 point"
    use "Polygon" id "point-0-shape-0"
      set "center" to 0 0
      set "radius" to 0.092
      set "sides" to 3
      set "rotation" to -90
    use "Directional Gradient" id "point-0-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "point-0-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "point-0-outline"
      set "width" to 0.018
    use "Transform" id "point-0-placement"
      set "offset" to -0.1 -0.29
      set "localScale" to 0.75 1.2
      set "rot" to 12
