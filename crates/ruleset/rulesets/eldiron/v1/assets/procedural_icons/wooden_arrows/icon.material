  row "composite-1" called "Point 0 over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "shaft-0" xyz
      set "foreground" from row "point-0" xyzw
  row "composite-2" called "Feather A 0 over previous layers"
    use "Alpha Over" id "composite-2"
