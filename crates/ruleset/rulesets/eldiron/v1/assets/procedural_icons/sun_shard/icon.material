# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Sun Shard"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "sun-crystal" called "Crystal facets"
    use "Polygon" id "sun-crystal-shape-0"
      set "center" to 0 0
      set "radius" to 0.25
      set "sides" to 5
      set "rotation" to -90
    use "Directional Gradient" id "sun-crystal-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "sun-crystal-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "sun-crystal-outline"
      set "width" to 0.018
    use "Transform" id "sun-crystal-placement"
      set "offset" to 0 0
      set "localScale" to 0.7705 1.61
      set "rot" to 0
  row "sun-crystal-facet" called "Crystal light facet"
    use "Rounded Rectangle" id "sun-crystal-facet-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.01495 0.260041
      set "radius" to 0.00996667
    use "Color" id "sun-crystal-facet-color"
    use "Transform" id "sun-crystal-facet-placement"
      set "offset" to 0.025875 -0.06325
      set "localScale" to 1 1
      set "rot" to -5.71059
  row "spark" called "Sun glint"
    use "Rounded Rectangle" id "spark-shape-0"
      set "center" to 0.18 -0.23
      set "halfSize" to 0.045 0.014
      set "radius" to 0
    use "Rounded Rectangle" id "spark-shape-1"
      combine union
      set "center" to 0.18 -0.23
      set "halfSize" to 0.014 0.045
      set "radius" to 0
    use "Color" id "spark-color"
  row "composite-1" called "Sun Crystal Facet over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "sun-crystal" xyz
      set "foreground" from row "sun-crystal-facet" xyzw
  row "composite-2" called "Spark over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "spark" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-2" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-2" xyz
  output opacity from row "pixel-alpha" x
