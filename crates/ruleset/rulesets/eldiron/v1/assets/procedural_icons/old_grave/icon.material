# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Old Grave"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "mound" called "Earth mound"
    use "Circle" id "mound-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "mound-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "mound-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "mound-outline"
      set "width" to 0.05
    use "Transform" id "mound-placement"
      set "offset" to 0 0.3
      set "localScale" to 0.36 0.085
      set "rot" to 0
  row "weed" called "Grass at grave"
    use "Rounded Rectangle" id "weed-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.0125 0.0948683
      set "radius" to 0.00833333
    use "Color" id "weed-color"
    use "Transform" id "weed-placement"
      set "offset" to 0.27 0.22
      set "localScale" to 1 1
      set "rot" to -161.565
  row "stone" called "Rounded headstone"
    use "Rounded Rectangle" id "stone-shape-0"
      set "center" to 0 0.03
      set "halfSize" to 0.22 0.285
      set "radius" to 0.035
    use "Circle" id "stone-shape-1"
      combine union
      set "center" to 0 -0.23
      set "radius" to 0.22
    use "Directional Gradient" id "stone-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "stone-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "stone-outline"
      set "width" to 0.018
  row "face" called "Inset stone face"
    use "Rounded Rectangle" id "face-shape-0"
      set "center" to 0 0.01
      set "halfSize" to 0.17 0.25
      set "radius" to 0.025
    use "Circle" id "face-shape-1"
      combine union
      set "center" to 0 -0.23
      set "radius" to 0.17
    use "Directional Gradient" id "face-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "face-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
  row "cross" called "Carved cross"
    use "Rounded Rectangle" id "cross-shape-0"
      set "center" to 0 -0.12
      set "halfSize" to 0.025 0.115
      set "radius" to 0
    use "Rounded Rectangle" id "cross-shape-1"
      combine union
      set "center" to 0 -0.16
      set "halfSize" to 0.1 0.025
      set "radius" to 0
    use "Color" id "cross-color"
  row "inscription" called "Worn inscription"
    use "Rounded Rectangle" id "inscription-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.012 0.1
      set "radius" to 0.008
    use "Color" id "inscription-color"
    use "Transform" id "inscription-placement"
      set "offset" to 0 0.11
      set "localScale" to 1 1
      set "rot" to -90
  row "date" called "Second inscription"
    use "Rounded Rectangle" id "date-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.009 0.07
      set "radius" to 0.006
    use "Color" id "date-color"
    use "Transform" id "date-placement"
      set "offset" to 0 0.18
      set "localScale" to 1 1
      set "rot" to -90
  row "composite-1" called "Weed over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "mound" xyz
      set "foreground" from row "weed" xyzw
  row "composite-2" called "Stone over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "stone" xyzw
  row "composite-3" called "Face over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "face" xyzw
  row "composite-4" called "Cross over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "cross" xyzw
  row "composite-5" called "Inscription over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "inscription" xyzw
  row "composite-6" called "Date over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "date" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
