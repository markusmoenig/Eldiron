# 32px navigation artwork. Editable stock MZ rows; colors bind to the project palette.
project 1
result from material "icon"
material "icon" called "Actions - Command Scroll"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "sheet" called "Parchment command scroll"
    use "Rounded Rectangle" id "sheet-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.245 0.31
      set "radius" to 0.025
    use "Directional Gradient" id "sheet-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "sheet-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "sheet-outline"
      set "width" to 0.018
  row "rolls" called "Rolled parchment edges"
    use "Rounded Rectangle" id "rolls-shape-0"
      set "center" to 0 -0.31
      set "halfSize" to 0.29 0.045
      set "radius" to 0.04
    use "Rounded Rectangle" id "rolls-shape-1"
      combine union
      set "center" to 0 0.31
      set "halfSize" to 0.29 0.045
      set "radius" to 0.04
    use "Directional Gradient" id "rolls-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "rolls-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "rolls-outline"
      set "width" to 0.018
  row "entries" called "Three command entries"
    use "Rounded Rectangle" id "entries-shape-0"
      set "center" to 0.055 -0.16
      set "halfSize" to 0.115 0.014
      set "radius" to 0
    use "Rounded Rectangle" id "entries-shape-1"
      combine union
      set "center" to 0.055 0
      set "halfSize" to 0.115 0.014
      set "radius" to 0
    use "Rounded Rectangle" id "entries-shape-2"
      combine union
      set "center" to 0.055 0.16
      set "halfSize" to 0.115 0.014
      set "radius" to 0
    use "Color" id "entries-color"
  row "markers" called "Three brass command markers"
    use "Circle" id "markers-shape-0"
      set "center" to -0.15 -0.16
      set "radius" to 0.035
    use "Circle" id "markers-shape-1"
      combine union
      set "center" to -0.15 0
      set "radius" to 0.035
    use "Circle" id "markers-shape-2"
      combine union
      set "center" to -0.15 0.16
      set "radius" to 0.035
    use "Color" id "markers-color"
  row "composite-1" called "Rolls over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "sheet" xyz
      set "foreground" from row "rolls" xyzw
  row "composite-2" called "Entries over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "entries" xyzw
  row "composite-3" called "Markers over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "markers" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-3" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-3" xyz
  output opacity from row "pixel-alpha" x
