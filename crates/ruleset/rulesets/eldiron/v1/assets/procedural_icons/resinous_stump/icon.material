# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Resinous Stump"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "roots" called "Gnarled roots"
    use "Polygon" id "roots-shape-0"
      set "center" to 0 0.22
      set "radius" to 0.34
      set "sides" to 7
      set "rotation" to 10
    use "Directional Gradient" id "roots-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "roots-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "roots-outline"
      set "width" to 0.018
  row "stump" called "Stump bark"
    use "Rounded Rectangle" id "stump-shape-0"
      set "center" to 0 0.08
      set "halfSize" to 0.235 0.22
      set "radius" to 0.04
    use "Directional Gradient" id "stump-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "stump-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "stump-outline"
      set "width" to 0.018
  row "cut" called "Cut end grain"
    use "Circle" id "cut-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "cut-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "cut-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "cut-outline"
      set "width" to 0.072
    use "Transform" id "cut-placement"
      set "offset" to 0 -0.13
      set "localScale" to 0.25 0.12
      set "rot" to 0
  row "ring" called "Outer growth ring"
    use "Circle" id "ring-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Color" id "ring-color"
    use "Transform" id "ring-placement"
      set "offset" to 0 -0.13
      set "localScale" to 0.17 0.075
      set "rot" to 0
  row "core" called "Inner growth ring"
    use "Circle" id "core-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Color" id "core-color"
    use "Transform" id "core-placement"
      set "offset" to 0 -0.13
      set "localScale" to 0.12 0.045
      set "rot" to 0
  row "sap" called "Amber sap tear"
    use "Circle" id "sap-shape-0"
      set "center" to 0.16 0.13
      set "radius" to 0.055
    use "Polygon" id "sap-shape-1"
      combine union
      set "center" to 0.16 0.08
      set "radius" to 0.07
      set "sides" to 3
      set "rotation" to -90
    use "Directional Gradient" id "sap-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "sap-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "sap-outline"
      set "width" to 0.018
  row "bark-score" called "Bark scoring"
    use "Rounded Rectangle" id "bark-score-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.01 0.13
      set "radius" to 0.00666667
    use "Color" id "bark-score-color"
    use "Transform" id "bark-score-placement"
      set "offset" to -0.14 0.11
      set "localScale" to 1 1
      set "rot" to -0
  row "composite-1" called "Stump over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "roots" xyz
      set "foreground" from row "stump" xyzw
  row "composite-2" called "Cut over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "cut" xyzw
  row "composite-3" called "Ring over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "ring" xyzw
  row "composite-4" called "Core over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "core" xyzw
  row "composite-5" called "Sap over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "sap" xyzw
  row "composite-6" called "Bark Score over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "bark-score" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-6" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-6" xyz
  output opacity from row "pixel-alpha" x
