# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Sunward Charm"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "chain" called "Fine chain loop"
    use "Circle" id "chain-shape-0"
      set "center" to 0 -0.2
      set "radius" to 0.19
    use "Circle" id "chain-shape-1"
      combine subtract
      set "center" to 0 -0.2
      set "radius" to 0.15
    use "Directional Gradient" id "chain-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "chain-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "chain-outline"
      set "width" to 0.008
  row "sun" called "Sun medallion"
    use "Polygon" id "sun-shape-0"
      set "center" to 0 0.12
      set "radius" to 0.27
      set "sides" to 8
      set "rotation" to -22.5
    use "Directional Gradient" id "sun-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "sun-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "sun-outline"
      set "width" to 0.018
  row "inset" called "Blue enamel"
    use "Circle" id "inset-shape-0"
      set "center" to 0 0.12
      set "radius" to 0.16
    use "Directional Gradient" id "inset-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "inset-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "inset-outline"
      set "width" to 0.018
  row "cross" called "Sunward cross"
    use "Rounded Rectangle" id "cross-shape-0"
      set "center" to 0 0.12
      set "halfSize" to 0.022 0.105
      set "radius" to 0
    use "Rounded Rectangle" id "cross-shape-1"
      combine union
      set "center" to 0 0.1
      set "halfSize" to 0.075 0.022
      set "radius" to 0
    use "Color" id "cross-color"
    use "Border" id "cross-outline"
      set "width" to 0.012
  row "composite-1" called "Sun over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "chain" xyz
      set "foreground" from row "sun" xyzw
  row "composite-2" called "Inset over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "inset" xyzw
  row "composite-3" called "Cross over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "cross" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-3" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-3" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "sun" w mapped 0 to 0.85
  output roughness from row "sun" w mapped 0.8 to 0.35
