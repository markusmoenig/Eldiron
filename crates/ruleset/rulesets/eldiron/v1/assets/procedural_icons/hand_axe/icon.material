# 32px hand axe. Stock MZ shapes; every authored color uses palette-index bindings.
project 1
result from material "axe"
material "axe" called "Hand Axe Icon"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "haft" called "Wooden haft"
    use "Rounded Rectangle" id "haft-shape"
      set "halfSize" to 0.03125 0.359375
      set "center" to 0.046875 0.03125
      set "radius" to 0.02
    use "Directional Gradient" id "wood-gradient"
      set "angle" to 0
      set "scale" to 10
      set "offset" to 0.5
    use "Color Ramp" id "wood-colors"
      set "position0" to 0
      set "position1" to 0.25
      set "position2" to 0.6
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "wood-outline"
      set "width" to 0.018
  row "grip-mask" called "Leather wrap silhouette"
    use "Rounded Rectangle" id "grip-shape"
      set "halfSize" to 0.04 0.109375
      set "center" to 0.046875 0.234375
      set "radius" to 0.015625
  row "grip" called "Leather hand wrap"
    use "Coordinates" id "wrap-coordinates"
      input from row "grip-mask" xyz
    use "Vector Math" id "wrap-direction"
      set "operation" to 2
      set "other" to 0.45 1 0
    use "Multiply" id "wrap-frequency"
      set "localValue" to 24 24 24
    use "Fract" id "wrap-repeat"
    use "Color Ramp" id "grip-colors"
      set "position0" to 0
      set "position1" to 0.25
      set "position2" to 0.65
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "grip-outline"
      set "width" to 0.015625
  row "head" called "Curved iron blade"
    use "Rounded Rectangle" id "head-boundary"
      set "halfSize" to 0.1875 0.140625
      set "center" to -0.09375 -0.234375
      set "radius" to 0.03125
    use "Circle" id "head-edge"
      combine intersect
      set "center" to 0.0625 -0.234375
      set "radius" to 0.3125
    use "Circle" id "head-beard"
      combine subtract
      set "center" to 0.015625 -0.046875
      set "radius" to 0.140625
    use "Directional Gradient" id "steel-gradient"
      set "angle" to 210
      set "scale" to 2.2
      set "offset" to 0.25
    use "Color Ramp" id "steel-colors"
      set "position0" to 0.1
      set "position1" to 0.35
      set "position2" to 0.6
      set "position3" to 0.82
      set "interpolation" to 0
    use "Border" id "head-outline"
      set "width" to 0.025
  row "socket" called "Iron haft socket"
    use "Rounded Rectangle" id "socket-shape"
      set "halfSize" to 0.0546875 0.109375
      set "center" to 0.046875 -0.25
      set "radius" to 0.015625
    use "Directional Gradient" id "socket-gradient"
      set "angle" to 0
      set "scale" to 5
      set "offset" to 0.5
    use "Color Ramp" id "socket-colors"
      set "position0" to 0.1
      set "position1" to 0.35
      set "position2" to 0.6
      set "position3" to 0.82
      set "interpolation" to 0
    use "Border" id "socket-outline"
      set "width" to 0.018
  row "rivet" called "Socket rivet"
    use "Circle" id "rivet-shape"
      set "radius" to 0.015625
      set "center" to 0.046875 -0.25
    use "Color" id "rivet-color"
  row "haft-wrapped" called "Wrap over haft"
    use "Alpha Over" id "haft-wrap-over"
      input from row "haft" xyz
      set "foreground" from row "grip" xyzw
  row "head-on-haft" called "Head over haft"
    use "Alpha Over" id "head-over"
      input from row "haft-wrapped" xyz
      set "foreground" from row "head" xyzw
  row "socket-on-head" called "Socket over head"
    use "Alpha Over" id "socket-over"
      input from row "head-on-haft" xyz
      set "foreground" from row "socket" xyzw
  row "finished" called "Rivet over socket"
    use "Alpha Over" id "rivet-over"
      input from row "socket-on-head" xyz
      set "foreground" from row "rivet" xyzw
  row "oriented" called "Icon pose"
    use "Transform" id "icon-pose"
      input from row "finished" xyz
      set "globalScale" to 1.1
      set "rot" to 35
  row "pixel-alpha" called "Pixel silhouette"
    use "Compare/Select" id "silhouette"
      input from row "oriented" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  row "metal-mask" called "Iron blade and socket"
    use "Max" id "head-socket-mask"
      input from row "head" www
      set "globalValue" to 1
      set "localValue" from row "socket" www
    use "Transform" id "metal-pose"
      set "globalScale" to 1.1
      set "rot" to 35
  output base color from row "oriented" xyz
  output opacity from row "pixel-alpha" x
  output metallic from row "metal-mask" x
  output roughness from row "metal-mask" x mapped 0.8 to 0.3
