# 32px inventory icon. Stock MZ shape and material rows; all colors are palette indices.
# Authored clothing construction. All colors use the companion project palette indices.
project 1
result from material "surface"
material "surface" called "Chain Shirt Icon"
  mode pbr
  tiling raw
  default roughness to 0.55
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Dark padding under the rings"
    use "Color" id "base"
  row "trim" called "Bound leather collar and hem"
    use "Color" id "trim"
  row "ring" called "One open iron link"
    use "Circle" id "ring-0"
      set "center" to 0 0
      set "radius" to 0.43
    use "Circle" id "ring-1"
      combine subtract
      set "center" to 0 0
      set "radius" to 0.25
    use "Directional Gradient" id "ring-light"
      set "angle" to 225
      set "scale" to 1.4
      set "offset" to 0.5
    use "Color Ramp" id "ring-steel"
      set "position0" to 0.12
      set "position1" to 0.4
      set "position2" to 0.6
      set "position3" to 0.86
      set "interpolation" to 0
  row "mail" called "Staggered interlinked rings"
    use "Grid" id "mail-grid"
      set "cells" to 12 16
      set "rowOffset" to 0.5
      set "gap" to 0 0
      set "scale" to 1 1
      input from row "ring" xyz
  row "rings" called "Iron rings over dark padding"
    use "Mix" id "rings-mix"
      input from row "mail" www
      set "color1" from row "base" xyzw
      set "color2" from row "mail" xyzw
      set "factor" to 1 1 1
  row "edging-mask" called "Bound neckline and hems"
    use "Circle" id "edging-mask-0"
      set "center" to -0.25 -0.5
      set "radius" to 0.11
    use "Circle" id "edging-mask-1"
      combine subtract
      set "center" to -0.25 -0.5
      set "radius" to 0.078
    use "Circle" id "edging-mask-2"
      combine union
      set "center" to 0.25 -0.5
      set "radius" to 0.085
    use "Circle" id "edging-mask-3"
      combine subtract
      set "center" to 0.25 -0.5
      set "radius" to 0.06
    use "Rounded Rectangle" id "edging-mask-4"
      combine union
      set "center" to 0 0.45
      set "halfSize" to 0.5 0.022
      set "radius" to 0
  row "edging" called "Bound neckline and hems"
    use "Mix" id "edging-mix"
      input from row "edging-mask" www
      set "color1" from row "rings" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "iron-mask" called "Iron links without leather binding"
    use "Multiply" id "iron-only"
      input from row "mail" www
      set "globalValue" to 1
      set "localValue" from row "edging-mask" www mapped 1 to 0
  row "icon-shape" called "Garment silhouette"
    use "Rounded Rectangle" id "icon-body"
      set "center" to 0 0.035
      set "halfSize" to 0.218 0.305
      set "radius" to 0.02
    use "Rounded Rectangle" id "icon-shoulders"
      combine union
      set "center" to 0 -0.21
      set "halfSize" to 0.37 0.105
      set "radius" to 0.025
    use "Circle" id "icon-neck"
      combine subtract
      set "center" to 0 -0.335
      set "radius" to 0.084
  row "icon-front" called "Front fabric mapping"
    use "Transform" id "icon-front-map"
      input from row "edging" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-edge-mask" called "One pixel inside outline"
    use "Compare/Select" id "icon-edge-mask"
      input from row "icon-shape" distance
      set "comparison" to 2
      set "reference" to -0.023 -0.023 -0.023
  row "icon-edge-color" called "Outline palette color"
    use "Color" id "icon-outline"
  row "icon-cutout" called "Outlined fabric"
    use "Mix" id "icon-fabric-outline"
      input from row "icon-edge-mask" xxx
      set "color1" from row "icon-front" xyzw
      set "color2" from row "icon-edge-color" xyzw
      set "factor" to 1 1 1
  row "icon-alpha" called "Crisp pixel silhouette"
    use "Compare/Select" id "icon-alpha"
      input from row "icon-shape" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  row "icon-channel-0" called "Metallic front mapping"
    use "Transform" id "icon-channel-0"
      input from row "iron-mask" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  row "icon-channel-1" called "Roughness front mapping"
    use "Transform" id "icon-channel-1"
      input from row "iron-mask" xyz
      set "localScale" to 2 0.72
      set "offset" to 0.5 0.015
  output base color from row "icon-cutout" xyz
  output opacity from row "icon-alpha" x
  output metallic from row "icon-channel-0" x
  output roughness from row "icon-channel-1" x mapped 0.85 to 0.35
