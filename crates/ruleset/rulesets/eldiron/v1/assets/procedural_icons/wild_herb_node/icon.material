# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Wild Herb Node"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "soil" called "Earth at roots"
    use "Circle" id "soil-shape-0"
      set "center" to 0 0
      set "radius" to 1
    use "Directional Gradient" id "soil-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "soil-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "soil-outline"
      set "width" to 0.0967742
    use "Transform" id "soil-placement"
      set "offset" to 0 0.31
      set "localScale" to 0.31 0.065
      set "rot" to 0
  row "stem-0" called "Leafy stem"
    use "Rounded Rectangle" id "stem-0-shape-0"
