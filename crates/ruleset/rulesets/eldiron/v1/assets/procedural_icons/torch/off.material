# 32px ruleset inventory artwork. Stock MZ rows; authored colors are project palette indices.
project 1
result from material "icon"
material "icon" called "Torch - Unlit"
  mode pbr
  tiling raw
  default roughness to 0.8
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "haft" called "Wooden handle"
    use "Rounded Rectangle" id "haft-shape-0"
      set "center" to 0 0
      set "halfSize" to 0.022 0.28
      set "radius" to 0.012
    use "Directional Gradient" id "haft-gradient"
      set "angle" to 0
      set "scale" to 16
      set "offset" to 0.5
    use "Color Ramp" id "haft-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "haft-outline"
      set "width" to 0.005
    use "Transform" id "haft-placement"
      set "offset" to 0 0.14
      set "localScale" to 1 1
      set "rot" to 180
  row "wrap" called "Cloth wrapped head"
    use "Rounded Rectangle" id "wrap-shape-0"
      set "center" to 0 -0.13
      set "halfSize" to 0.06 0.08
      set "radius" to 0.018
    use "Directional Gradient" id "wrap-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "wrap-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "wrap-outline"
      set "width" to 0.007
  row "bands" called "Iron retaining bands"
    use "Rounded Rectangle" id "bands-shape-0"
      set "center" to 0 -0.18
      set "halfSize" to 0.065 0.014
      set "radius" to 0.01
    use "Rounded Rectangle" id "bands-shape-1"
      combine union
      set "center" to 0 -0.07
      set "halfSize" to 0.065 0.014
      set "radius" to 0.01
    use "Directional Gradient" id "bands-gradient"
      set "angle" to 0
      set "scale" to 2.5
      set "offset" to 0.5
    use "Color Ramp" id "bands-colors"
      set "position0" to 0
      set "position1" to 0.3
      set "position2" to 0.58
      set "position3" to 0.85
      set "interpolation" to 0
    use "Border" id "bands-outline"
      set "width" to 0.007
  row "composite-1" called "Wrap over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "haft" xyz
      set "foreground" from row "wrap" xyzw
  row "composite-2" called "Bands over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "bands" xyzw
  row "torch" called "Diagonal torch"
    use "Transform" id "torch-angle"
      input from row "composite-2" xyz
      set "rot" to 45
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "torch" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "torch" xyz
  output opacity from row "pixel-alpha" x
