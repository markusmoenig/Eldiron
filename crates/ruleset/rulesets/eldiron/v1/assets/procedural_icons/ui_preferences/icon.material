# 32px navigation artwork. Editable stock MZ rows; colors bind to the project palette.
project 1
result from material "icon"
material "icon" called "Preferences - Brass Cog"
  mode pbr
  tiling raw
  default roughness to 0.65
  default metallic to 0
  default opacity to 0
  default emission strength to 0
  row "gear" called "Brass cog wheel"
    use "Circle" id "gear-shape-0"
      set "center" to 0 0
      set "radius" to 0.3
    use "Directional Gradient" id "gear-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "gear-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "gear-outline"
      set "width" to 0.018
  row "tooth-0" called "Cog tooth 1"
    use "Rounded Rectangle" id "tooth-0-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-0-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-0-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-0-outline"
      set "width" to 0.018
    use "Transform" id "tooth-0-placement"
      set "rot" to 0
  row "tooth-1" called "Cog tooth 2"
    use "Rounded Rectangle" id "tooth-1-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-1-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-1-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-1-outline"
      set "width" to 0.018
    use "Transform" id "tooth-1-placement"
      set "rot" to 45
  row "tooth-2" called "Cog tooth 3"
    use "Rounded Rectangle" id "tooth-2-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-2-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-2-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-2-outline"
      set "width" to 0.018
    use "Transform" id "tooth-2-placement"
      set "rot" to 90
  row "tooth-3" called "Cog tooth 4"
    use "Rounded Rectangle" id "tooth-3-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-3-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-3-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-3-outline"
      set "width" to 0.018
    use "Transform" id "tooth-3-placement"
      set "rot" to 135
  row "tooth-4" called "Cog tooth 5"
    use "Rounded Rectangle" id "tooth-4-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-4-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-4-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-4-outline"
      set "width" to 0.018
    use "Transform" id "tooth-4-placement"
      set "rot" to 180
  row "tooth-5" called "Cog tooth 6"
    use "Rounded Rectangle" id "tooth-5-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-5-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-5-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-5-outline"
      set "width" to 0.018
    use "Transform" id "tooth-5-placement"
      set "rot" to 225
  row "tooth-6" called "Cog tooth 7"
    use "Rounded Rectangle" id "tooth-6-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-6-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-6-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-6-outline"
      set "width" to 0.018
    use "Transform" id "tooth-6-placement"
      set "rot" to 270
  row "tooth-7" called "Cog tooth 8"
    use "Rounded Rectangle" id "tooth-7-shape-0"
      set "center" to 0 -0.325
      set "halfSize" to 0.055 0.09
      set "radius" to 0.014
    use "Directional Gradient" id "tooth-7-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "tooth-7-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
    use "Border" id "tooth-7-outline"
      set "width" to 0.018
    use "Transform" id "tooth-7-placement"
      set "rot" to 315
  row "inset" called "Dark recessed centre"
    use "Circle" id "inset-shape-0"
      set "center" to 0 0
      set "radius" to 0.17
    use "Color" id "inset-color"
    use "Border" id "inset-outline"
      set "width" to 0.018
  row "hub" called "Brass hub"
    use "Circle" id "hub-shape-0"
      set "center" to 0 0
      set "radius" to 0.105
    use "Circle" id "hub-shape-1"
      combine subtract
      set "center" to 0 0
      set "radius" to 0.045
    use "Directional Gradient" id "hub-gradient"
      set "angle" to 225
      set "scale" to 1.35
      set "offset" to 0.5
    use "Color Ramp" id "hub-colors"
      set "position0" to 0.12
      set "position1" to 0.38
      set "position2" to 0.62
      set "position3" to 0.88
      set "interpolation" to 0
  row "composite-1" called "Tooth 0 over previous layers"
    use "Alpha Over" id "composite-1"
      input from row "gear" xyz
      set "foreground" from row "tooth-0" xyzw
  row "composite-2" called "Tooth 1 over previous layers"
    use "Alpha Over" id "composite-2"
      input from row "composite-1" xyz
      set "foreground" from row "tooth-1" xyzw
  row "composite-3" called "Tooth 2 over previous layers"
    use "Alpha Over" id "composite-3"
      input from row "composite-2" xyz
      set "foreground" from row "tooth-2" xyzw
  row "composite-4" called "Tooth 3 over previous layers"
    use "Alpha Over" id "composite-4"
      input from row "composite-3" xyz
      set "foreground" from row "tooth-3" xyzw
  row "composite-5" called "Tooth 4 over previous layers"
    use "Alpha Over" id "composite-5"
      input from row "composite-4" xyz
      set "foreground" from row "tooth-4" xyzw
  row "composite-6" called "Tooth 5 over previous layers"
    use "Alpha Over" id "composite-6"
      input from row "composite-5" xyz
      set "foreground" from row "tooth-5" xyzw
  row "composite-7" called "Tooth 6 over previous layers"
    use "Alpha Over" id "composite-7"
      input from row "composite-6" xyz
      set "foreground" from row "tooth-6" xyzw
  row "composite-8" called "Tooth 7 over previous layers"
    use "Alpha Over" id "composite-8"
      input from row "composite-7" xyz
      set "foreground" from row "tooth-7" xyzw
  row "composite-9" called "Inset over previous layers"
    use "Alpha Over" id "composite-9"
      input from row "composite-8" xyz
      set "foreground" from row "inset" xyzw
  row "composite-10" called "Hub over previous layers"
    use "Alpha Over" id "composite-10"
      input from row "composite-9" xyz
      set "foreground" from row "hub" xyzw
  row "pixel-alpha" called "Crisp 32px silhouette"
    use "Compare/Select" id "pixel-alpha"
      input from row "composite-10" www
      set "comparison" to 2
      set "reference" to 0.5 0.5 0.5
  output base color from row "composite-10" xyz
  output opacity from row "pixel-alpha" x
