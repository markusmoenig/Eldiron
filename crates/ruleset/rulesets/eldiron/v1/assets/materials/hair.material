# Authored hair: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Hair"
  mode pbr
  tiling raw
  default roughness to 0.86
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "strands-mask" called "Combed hair strands shape"
    use "Rounded Rectangle" id "strand-0"
      set "center" to -0.475 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-1"
      combine union
      set "center" to -0.391667 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-2"
      combine union
      set "center" to -0.308333 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-3"
      combine union
      set "center" to -0.225 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-4"
      combine union
      set "center" to -0.141667 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-5"
      combine union
      set "center" to -0.0583333 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-6"
      combine union
      set "center" to 0.025 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-7"
      combine union
      set "center" to 0.108333 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-8"
      combine union
      set "center" to 0.191667 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-9"
      combine union
      set "center" to 0.275 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-10"
      combine union
      set "center" to 0.358333 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
    use "Rounded Rectangle" id "strand-11"
      combine union
      set "center" to 0.441667 0.05
      set "halfSize" to 0.009 0.45
      set "radius" to 0.008
  row "strands" called "Combed hair strands"
    use "Mix" id "strands-mix"
      input from row "strands-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  output base color from row "strands" xyz
