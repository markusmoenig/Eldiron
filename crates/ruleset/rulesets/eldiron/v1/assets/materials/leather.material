# Authored leather: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Leather"
  mode pbr
  tiling raw
  default roughness to 0.78
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "sole-color" called "Sole"
    use "Color" id "sole-color"
  row "stitch" called "Stitch"
    use "Color" id "stitch"
  row "panels-mask" called "Toe panel and shaft seams shape"
    use "Rounded Rectangle" id "front-panel-left"
      set "center" to -0.33 -0.02
      set "halfSize" to 0.01 0.32
      set "radius" to 0
    use "Rounded Rectangle" id "front-panel-right"
      combine union
      set "center" to -0.17 -0.02
      set "halfSize" to 0.01 0.32
      set "radius" to 0
    use "Rounded Rectangle" id "heel-seam"
      combine union
      set "center" to 0.25 0
      set "halfSize" to 0.0125 0.45
      set "radius" to 0
  row "panels" called "Toe panel and shaft seams"
    use "Mix" id "panels-mix"
      input from row "panels-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "sole-mask" called "Dark sole and top cuff shape"
    use "Rounded Rectangle" id "sole-band"
      set "center" to 0 0.44
      set "halfSize" to 0.5 0.06
      set "radius" to 0
    use "Rounded Rectangle" id "boot-cuff"
      combine union
      set "center" to 0 -0.465
      set "halfSize" to 0.5 0.035
      set "radius" to 0
  row "sole" called "Dark sole and top cuff"
    use "Mix" id "sole-mix"
      input from row "sole-mask" www
      set "color1" from row "panels" xyzw
      set "color2" from row "sole-color" xyzw
      set "factor" to 1 1 1
  row "laces-mask" called "Four leather laces shape"
    use "Rounded Rectangle" id "lace-0"
      set "center" to -0.25 -0.25
      set "halfSize" to 0.075 0.008
      set "radius" to 0
    use "Rounded Rectangle" id "lace-1"
      combine union
      set "center" to -0.25 -0.14
      set "halfSize" to 0.075 0.008
      set "radius" to 0
    use "Rounded Rectangle" id "lace-2"
      combine union
      set "center" to -0.25 -0.03
      set "halfSize" to 0.075 0.008
      set "radius" to 0
    use "Rounded Rectangle" id "lace-3"
      combine union
      set "center" to -0.25 0.08
      set "halfSize" to 0.075 0.008
      set "radius" to 0
  row "laces" called "Four leather laces"
    use "Mix" id "laces-mix"
      input from row "laces-mask" www
      set "color1" from row "sole" xyzw
      set "color2" from row "stitch" xyzw
      set "factor" to 1 1 1
  output base color from row "laces" xyz
