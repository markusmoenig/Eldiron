# Authored trouser-waist: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Trouser Waist"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "leather" called "Leather"
    use "Color" id "leather"
  row "button" called "Fastenings"
    use "Color" id "button"
  row "seams-mask" called "Fly and pocket stitching shape"
    use "Rounded Rectangle" id "fly"
      set "center" to -0.25 0.08
      set "halfSize" to 0.009 0.24
      set "radius" to 0
    use "Rounded Rectangle" id "pocket-left"
      combine union
      set "center" to -0.38 -0.1
      set "halfSize" to 0.009 0.12
      set "radius" to 0
    use "Rounded Rectangle" id "pocket-right"
      combine union
      set "center" to -0.12 -0.1
      set "halfSize" to 0.009 0.12
      set "radius" to 0
  row "seams" called "Fly and pocket stitching"
    use "Mix" id "seams-mix"
      input from row "seams-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "belt-mask" called "Leather waistband shape"
    use "Rounded Rectangle" id "belt-band"
      set "center" to 0 -0.23
      set "halfSize" to 0.5 0.085
      set "radius" to 0
  row "belt" called "Leather waistband"
    use "Mix" id "belt-mix"
      input from row "belt-mask" www
      set "color1" from row "seams" xyzw
      set "color2" from row "leather" xyzw
      set "factor" to 1 1 1
  row "buckle-mask" called "Belt buckle shape"
    use "Rounded Rectangle" id "buckle-frame"
      set "center" to -0.25 -0.23
      set "halfSize" to 0.045 0.0625
      set "radius" to 0.008
    use "Rounded Rectangle" id "buckle-opening"
      combine subtract
      set "center" to -0.25 -0.23
      set "halfSize" to 0.026 0.039
      set "radius" to 0.004
  row "buckle" called "Belt buckle"
    use "Mix" id "buckle-mix"
      input from row "buckle-mask" www
      set "color1" from row "belt" xyzw
      set "color2" from row "button" xyzw
      set "factor" to 1 1 1
  output base color from row "buckle" xyz
