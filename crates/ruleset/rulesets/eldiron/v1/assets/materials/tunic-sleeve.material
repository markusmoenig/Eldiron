# Authored tunic-sleeve: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Tunic Sleeve"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "trim" called "Woven edging"
    use "Color" id "trim"
  row "seams-mask" called "Sleeve seam shape"
    use "Rounded Rectangle" id "sleeve-seam"
      set "center" to 0 0
      set "halfSize" to 0.009 0.5
      set "radius" to 0
  row "seams" called "Sleeve seam"
    use "Mix" id "seams-mix"
      input from row "seams-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "cuff-mask" called "Woven cuff edging shape"
    use "Rounded Rectangle" id "cuff-band"
      set "center" to 0 0.41
      set "halfSize" to 0.5 0.0375
      set "radius" to 0
    use "Rounded Rectangle" id "cuff-seam"
      combine union
      set "center" to 0 0.34
      set "halfSize" to 0.5 0.008
      set "radius" to 0
  row "cuff" called "Woven cuff edging"
    use "Mix" id "cuff-mix"
      input from row "cuff-mask" www
      set "color1" from row "seams" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  output base color from row "cuff" xyz
