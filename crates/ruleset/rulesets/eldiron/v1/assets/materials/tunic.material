# Authored tunic: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Tunic"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "trim" called "Woven edging"
    use "Color" id "trim"
  row "button" called "Fastenings"
    use "Color" id "button"
  row "seams-mask" called "Side seams shape"
    use "Rounded Rectangle" id "right-seam"
      set "center" to -0.5 0
      set "halfSize" to 0.009 0.5
      set "radius" to 0
    use "Rounded Rectangle" id "left-seam"
      combine union
      set "center" to 0 0
      set "halfSize" to 0.009 0.5
      set "radius" to 0
  row "seams" called "Side seams"
    use "Mix" id "seams-mix"
      input from row "seams-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "edging-mask" called "Neckline, placket and bottom hem shape"
    use "Circle" id "front-collar"
      set "center" to -0.25 -0.5
      set "radius" to 0.11
    use "Circle" id "front-neck-opening"
      combine subtract
      set "center" to -0.25 -0.5
      set "radius" to 0.078
    use "Circle" id "back-collar"
      combine union
      set "center" to 0.25 -0.5
      set "radius" to 0.085
    use "Circle" id "back-neck-opening"
      combine subtract
      set "center" to 0.25 -0.5
      set "radius" to 0.06
    use "Rounded Rectangle" id "front-placket"
      combine union
      set "center" to -0.25 -0.305
      set "halfSize" to 0.0125 0.11
      set "radius" to 0.005
    use "Rounded Rectangle" id "bottom-hem"
      combine union
      set "center" to 0 0.45
      set "halfSize" to 0.5 0.0175
      set "radius" to 0
  row "edging" called "Neckline, placket and bottom hem"
    use "Mix" id "edging-mix"
      input from row "edging-mask" www
      set "color1" from row "seams" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  row "buttons-mask" called "Three brass buttons shape"
    use "Circle" id "button-0"
      set "center" to -0.25 -0.35
      set "radius" to 0.012
    use "Circle" id "button-1"
      combine union
      set "center" to -0.25 -0.28
      set "radius" to 0.012
    use "Circle" id "button-2"
      combine union
      set "center" to -0.25 -0.21
      set "radius" to 0.012
  row "buttons" called "Three brass buttons"
    use "Mix" id "buttons-mix"
      input from row "buttons-mask" www
      set "color1" from row "edging" xyzw
      set "color2" from row "button" xyzw
      set "factor" to 1 1 1
  output base color from row "buttons" xyz
