# Authored trousers: garment construction, not all-over noise. Colors use the companion palette indices.
project 1
result from material "surface"
material "surface" called "Trousers"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Main fabric"
    use "Color" id "base"
  row "shade" called "Seam / shadow"
    use "Color" id "shade"
  row "seams-mask" called "Inseam and outside leg seams shape"
    use "Rounded Rectangle" id "inseam"
      set "center" to -0.5 0
      set "halfSize" to 0.01 0.5
      set "radius" to 0
    use "Rounded Rectangle" id "outseam"
      combine union
      set "center" to 0 0
      set "halfSize" to 0.01 0.5
      set "radius" to 0
  row "seams" called "Inseam and outside leg seams"
    use "Mix" id "seams-mix"
      input from row "seams-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  output base color from row "seams" xyz
