# Long split vestment panels; project palette indices own every authored color.
project 1
result from material "surface"
material "surface" called "Cleric Tabard"
  mode pbr
  tiling raw
  default roughness to 0.92
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Ivory cloth"
    use "Color" id "base"
  row "blue" called "Blue woven edging"
    use "Color" id "blue"
  row "gold" called "Gold thread"
    use "Color" id "gold"
  row "edge-mask" called "Side binding"
    use "Rounded Rectangle" id "edge-seam"
      set "halfSize" to 0.035 0.5
      set "center" to 0 0
      set "radius" to 0
    use "Rounded Rectangle" id "edge-wrap"
      combine union
      set "halfSize" to 0.035 0.5
      set "center" to -0.5 0
      set "radius" to 0
  row "bound" called "Bound panel sides"
    use "Mix" id "bound-mix"
      input from row "edge-mask" www
      set "color1" from row "base" xyzw
      set "color2" from row "blue" xyzw
      set "factor" to 1 1 1
  row "hem-mask" called "Woven gold hem"
    use "Rounded Rectangle" id "bottom-hem"
      set "halfSize" to 0.5 0.035
      set "center" to 0 0.44
      set "radius" to 0
    use "Rounded Rectangle" id "hem-stitch"
      combine union
      set "halfSize" to 0.5 0.009
      set "center" to 0 0.36
      set "radius" to 0
  row "hem" called "Gold hem and stitching"
    use "Mix" id "hem-mix"
      input from row "hem-mask" www
      set "color1" from row "bound" xyzw
      set "color2" from row "gold" xyzw
      set "factor" to 1 1 1
  output base color from row "hem" xyz
