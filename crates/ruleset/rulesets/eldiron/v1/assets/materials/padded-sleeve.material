# Authored clothing construction. All colors use the companion project palette indices.
project 1
result from material "surface"
material "surface" called "Padded Sleeve"
  mode pbr
  tiling raw
  default roughness to 0.95
  default metallic to 0
  default opacity to 1
  default emission strength to 0
  row "base" called "Dyed quilted cloth"
    use "Color" id "base"
  row "shade" called "Recessed quilt stitching"
    use "Color" id "shade"
  row "trim" called "Leather binding"
    use "Color" id "trim"
  row "button" called "Brass fastenings"
    use "Color" id "button"
  row "diagonal-a" called "Diagonal stitched channels"
    use "Directional Gradient" id "diagonal-a-direction"
      input from row "base" xyz
      set "angle" to 45
      set "scale" to 1.41421356
      set "offset" to 0
    use "Periodic Profile" id "diagonal-a-stitch"
      set "profile" to 3
      set "frequency" to 6
      set "width" to 0.1
      set "antialias" to 1
  row "diagonal-b" called "Diagonal stitched channels"
    use "Directional Gradient" id "diagonal-b-direction"
      input from row "base" xyz
      set "angle" to 135
      set "scale" to 1.41421356
      set "offset" to 0
    use "Periodic Profile" id "diagonal-b-stitch"
      set "profile" to 3
      set "frequency" to 6
      set "width" to 0.1
      set "antialias" to 1
  row "quilt-mask" called "Crossed diamond stitching"
    use "Max" id "quilt-max"
      input from row "diagonal-a" xxx
      set "globalValue" to 1
      set "localValue" from row "diagonal-b" xxx
  row "quilt" called "Quilted diamond panels"
    use "Mix" id "quilt-mix"
      input from row "quilt-mask" xxx
      set "color1" from row "base" xyzw
      set "color2" from row "shade" xyzw
      set "factor" to 1 1 1
  row "edging-mask" called "Bound neckline and hems"
    use "Rounded Rectangle" id "edging-mask-0"
      set "center" to 0 0.42
      set "halfSize" to 0.5 0.04
      set "radius" to 0
    use "Rounded Rectangle" id "edging-mask-1"
      combine union
      set "center" to 0 0.33
      set "halfSize" to 0.5 0.008
      set "radius" to 0
  row "edging" called "Bound neckline and hems"
    use "Mix" id "edging-mix"
      input from row "edging-mask" www
      set "color1" from row "quilt" xyzw
      set "color2" from row "trim" xyzw
      set "factor" to 1 1 1
  output base color from row "edging" xyz
